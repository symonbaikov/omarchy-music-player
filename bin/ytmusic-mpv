#!/usr/bin/env python3
"""Backend for the io.github.symonbaikov.ytmusic-mpv Omarchy shell plugin.

Lists YouTube Music playlists and their tracks with yt-dlp, and plays them
through a headless mpv that the shell drives over mpv's JSON IPC socket.
No browser has to be running: yt-dlp only reads the browser's saved login
cookies from disk to see the private library.

Commands (every result is one JSON object per line on stdout):
  playlists [--browser B] [--max-age S]
  tracks <playlist-id> [--browser B] [--max-age S]
  play <playlist-id> [--index N] [--video-id ID] [--shuffle 0|1] [PLAYER]
  radio <video-id> [--mode replace|keep|append] [--title T] [PLAYER]
    PLAYER: [--browser B] [--playback-cookies 0|1] [--volume V]
            [--repeat off|all|one] [--fade-in S] [--fade-out S] [--pause-fade S]
            [--transition off|peak] [--xfade S]
  like <video-id> [--remove 1] [--browser B] [--title T] [--artist A] [--duration S]
  add <playlist-id> <video-id> [--browser B]
  liked
  targets <video-id> [--browser B]
  signin [--browser B]
  cookies [--browser B] [--playback-cookies 0|1]
  mixprep <current-entry> <next-entry> [--xfade S] [--min-exit S] [--cookies-spec SPEC]
  fallback <video-id> [--cookies-spec SPEC]
  mirrors [--check] [--refresh]
  update-check [--max-age S]
  explore [--max-age S] | mood <id> | search <query>
  download <video-id> [--dir D] [--format mp3|m4a|opus|flac|wav] [--cover 0|1] [--title T] [--artist A] [PLAYER]
  tracks DOWNLOADS   the downloaded songs (they play from their files)
  cloud | cloud-add (form as JSON on stdin) | cloud-remove <source> | cloud-stop
  lyrics <track> [--title T] [--artist A] [--duration S]
  chords <track> [PLAYER] | scores <track> [--title T] [--artist A] | open-score <url>
  playlists --service cl   your cloud storage's folders (rclone)
  stop
  paths

`playlists` and `tracks` first print the cached copy (marked "stale" when
it is older than --max-age) and then, if it was stale or missing, fetch a
fresh copy and print that too.

`radio` uses YouTube Music's own recommendations: the endless "radio" mix
(RDAMVM<video-id>) that YouTube Music builds for a song, personalized when
cookies are used. replace starts it as a new queue; keep lets the playing
song continue and replaces what comes after it; append (autoplay) adds
tracks not yet in the queue to its end.

`cookies` makes a running player follow the current cookie settings: mpv
reads its yt-dlp options again for every track it opens, so turning
playback cookies off (or choosing browser none) takes effect from the next
track on. If the change can't be confirmed, the player is stopped.

`mixprep` is called by mpv itself (mpv/ytmusic.lua) in "Peak mix" mode. It
downloads the audio of the playing and the next song, finds each one's
climax (YouTube's "most replayed" heatmap where there is one, and the
audio's loudness), and renders the next song as one local file that starts
with the end of the playing song's climax crossfading into the build-up of
the next one, so its climax lands as the crossfade ends. It prints where
the playing song has to stop for that file to take over seamlessly.

`fallback` is also called by mpv: when a song's usual stream can't be
opened, it plays the cached audio if there is one, or downloads the song
through YouTube's other clients (mobile web, TV, Safari, iOS), since a
change on YouTube's side usually breaks only some of them. With the
backupMirrors setting on, it then tries independent mirrors (Invidious,
Piped); `mirrors --check` shows which of them answer.

`like` and `add` write to the account (like a song, add it to one of your
playlists) through YouTube Music's own web API, signed with the browser's
cookies exactly as music.youtube.com does. yt-dlp is read-only, so these
two are the only requests the helper makes itself.
"""

import array
import base64
import fcntl
import hashlib
import json
import math
import operator
import os
import random
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

PLUGIN_ID = "io.github.symonbaikov.ytmusic-mpv"

HOME = os.path.expanduser("~")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), PLUGIN_ID)
# Things to keep (your mixes, the Spotify login): not a cache.
DATA_DIR = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local", "share"), PLUGIN_ID)
RUNTIME_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or os.path.join("/tmp", f"{PLUGIN_ID}-{os.getuid()}"), PLUGIN_ID)
SOCKET_PATH = os.path.join(RUNTIME_DIR, "mpv.sock")
SESSION_PATH = os.path.join(RUNTIME_DIR, "session.json")
QUEUE_PATH = os.path.join(RUNTIME_DIR, "queue.m3u")
PID_PATH = os.path.join(RUNTIME_DIR, "mpv.pid")
LOCK_PATH = os.path.join(RUNTIME_DIR, "session.lock")
MPV_LOG = os.path.join(CACHE_DIR, "mpv.log")
MPV_SCRIPT = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "mpv", "ytmusic.lua")
# YouTube Music API errors (endpoint, HTTP code, YouTube's own status and
# message). Never headers or cookies.
API_LOG = os.path.join(CACHE_DIR, "api.log")

# Bounds on everything that comes back from the network.
MAX_PLAYLISTS = 500
MAX_TRACKS = 5000
MAX_TEXT = 300
MAX_JSON_BYTES = 64 * 1024 * 1024
FETCH_TIMEOUT = 180

PLAYLIST_ID_RE = re.compile(r"^[A-Za-z0-9_-]{2,80}$")
VIDEO_ID_RE = re.compile(r"^[A-Za-z0-9_-]{11}$")
# A track from any service: a YouTube video id (as before, so old caches,
# likes and sessions keep working), "sc:<user>/<slug>" or "sc:<number>" for
# SoundCloud, "sp:<id>" for Spotify (played from its YouTube Music match),
# "cl:<source>/<hash>" for a file in your own cloud storage (see "cloud").
TRACK_KEY_RE = re.compile(r"^(?:[A-Za-z0-9_-]{11}|sc:(?:[0-9]{1,20}|[A-Za-z0-9_-]{1,100}/[A-Za-z0-9_-]{1,200})|sp:[A-Za-z0-9]{22}"
                          r"|cl:[a-f0-9]{8}/[a-f0-9]{16}|ms:[a-f0-9]{8}/[A-Za-z0-9_-]{1,64}|rd:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$")
SERVICE_LIST_RE = re.compile(
    r"^(?:sc:(?:likes|sets):[A-Za-z0-9_-]{1,100}|sc:set:[A-Za-z0-9_-]{1,100}/[A-Za-z0-9_-]{1,200}|sc:search"
    r"|sp:liked|sp:pl:[A-Za-z0-9]{22}|mix:all|mix:[a-f0-9]{8}|cl:[a-f0-9]{8}(?::[a-f0-9]{16})?"
    r"|rd:(?:fav|top|vote|search|country:[A-Z]{2}|tag:[a-z0-9-]{1,40})"
    r"|ms:[a-f0-9]{8}:(?:fav|rnd|al:[A-Za-z0-9_-]{1,64}|pl:[A-Za-z0-9_-]{1,64})|ai:mix|hist:recent)$")
SC_USER_RE = re.compile(r"^[A-Za-z0-9_-]{1,100}$")
SPOTIFY_SCHEME = "ytmusic-spotify://"
# browser[+keyring][:profile]; the profile may be a path (Zen, LibreWolf and
# other Firefox forks are read as firefox:<profile dir>).
BROWSER_RE = re.compile(r"^(none|brave|chrome|chromium|edge|firefox|opera|vivaldi|whale)(\+[A-Za-z0-9_-]{1,32})?(:[A-Za-z0-9 _.()/~+-]{1,200})?$")

LIKED_MUSIC = {"id": "LM", "title": "Liked Music", "count": None}
# YouTube Music's "My Supermix": one fixed list id that YouTube fills from
# the signed-in account's listening (a regional mix without cookies).
SUPERMIX = {"id": "RDTMAK5uy_kset8DisdE7LSD4TNjEVvrKRTmG7a56sY", "title": "My Supermix", "count": None}
PINNED = [LIKED_MUSIC, SUPERMIX]

# Mixes ("RD..." lists) are effectively endless: read only their head.
RADIO_LIMIT = 50
MIX_LIMIT = 100
AUTOPLAY_ADD = 25

# Library listings yt-dlp understands, tried in order. YouTube Music
# playlists are ordinary YouTube playlists, so the YouTube feed lists them.
LIBRARY_URLS = [
    "https://www.youtube.com/feed/playlists",
]


def emit(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def fail(message, kind="error", **extra):
    emit({"type": kind, "message": clean_text(message), **extra})
    sys.exit(1)


def clean_text(value, limit=MAX_TEXT):
    if value is None:
        return ""
    text = str(value)
    text = re.sub(r"[\x00-\x1f\x7f]+", " ", text).strip()
    return text[:limit]


def is_list_id(value):
    return bool(PLAYLIST_ID_RE.match(value or "") or SERVICE_LIST_RE.match(value or ""))


def source_of(key):
    return key[:2] if key[:3] in ("sc:", "sp:", "cl:", "rd:", "ms:") else "yt"


def check_playlist_id(value):
    if not is_list_id(value):
        fail("Invalid playlist id")
    return value


def check_browser(value):
    value = (value or "none").strip()
    if not BROWSER_RE.match(value):
        fail(f"Unsupported browser setting: {value}")
    return value


def ensure_dirs():
    os.makedirs(CACHE_DIR, exist_ok=True)
    os.makedirs(os.path.join(CACHE_DIR, "tracks"), exist_ok=True)
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)


def write_json_atomic(path, data):
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False)
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


# Chromium-family browsers encrypt cookies with a key kept wherever
# --password-store points (Omarchy launches Chromium and Brave with
# gnome-libsecret). yt-dlp guesses the store from the desktop environment,
# and under Hyprland it guesses "basictext", so the cookies wouldn't decrypt.
# Read the browser's own flags file instead, as the browser itself does.
CHROMIUM_FLAGS_FILES = {
    "chromium": ["chromium-flags.conf"],
    "brave": ["brave-flags.conf"],
    "chrome": ["chrome-flags.conf", "chrome-stable-flags.conf"],
    "vivaldi": ["vivaldi-stable.conf", "vivaldi-flags.conf"],
    "edge": ["microsoft-edge-stable-flags.conf"],
    "opera": ["opera-flags.conf"],
}
PASSWORD_STORE_KEYRINGS = {
    "gnome-libsecret": "gnomekeyring",
    "gnome-keyring": "gnomekeyring",
    "gnome": "gnomekeyring",
    "kwallet": "kwallet",
    "kwallet5": "kwallet5",
    "kwallet6": "kwallet6",
    "basic": "basictext",
}


def browser_keyring(name, config_dir=None):
    """The yt-dlp keyring matching the browser's --password-store flag, or
    None to let yt-dlp choose."""
    config_dir = config_dir or os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    for filename in CHROMIUM_FLAGS_FILES.get(name, []):
        try:
            with open(os.path.join(config_dir, filename), encoding="utf-8") as fh:
                text = fh.read(65536)
        except OSError:
            continue
        found = None
        for match in re.finditer(r"--password-store[= ]([A-Za-z0-9_-]+)", text):
            found = match.group(1)
        if found:
            return PASSWORD_STORE_KEYRINGS.get(found)
    return None


def browser_parts(browser, config_dir=None):
    """'chromium[+keyring][:profile]' -> (name, keyring or None, profile or None),
    filling in the keyring from the browser's flags when it isn't given."""
    head, sep, profile = browser.partition(":")
    name, _, keyring = head.partition("+")
    keyring = keyring.lower() or browser_keyring(name, config_dir)
    return name, keyring, (os.path.expanduser(profile) if sep else None)


def cookie_spec(browser):
    name, keyring, profile = browser_parts(browser)
    spec = f"{name}+{keyring}" if keyring else name
    return f"{spec}:{profile}" if profile else spec


def cookie_args(browser):
    return [] if browser == "none" else ["--cookies-from-browser", cookie_spec(browser)]


def run_ytdlp(url, browser, limit=None):
    cmd = [
        "yt-dlp", "--ignore-config", "--flat-playlist", "--dump-single-json",
        "--no-warnings", "--no-progress", "--socket-timeout", "20",
        *cookie_args(browser),
    ]
    if limit:
        cmd += ["--playlist-items", f":{int(limit)}"]
    cmd += ["--", url]
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=FETCH_TIMEOUT, stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        raise RuntimeError("yt-dlp is not installed")
    except subprocess.TimeoutExpired:
        raise RuntimeError("yt-dlp timed out")
    if proc.returncode != 0:
        errors = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.startswith("ERROR")]
        raise RuntimeError(errors[-1] if errors else f"yt-dlp exited with {proc.returncode}")
    if len(proc.stdout) > MAX_JSON_BYTES:
        raise RuntimeError("yt-dlp response too large")
    try:
        return json.loads(proc.stdout)
    except ValueError:
        raise RuntimeError("yt-dlp returned invalid JSON")


def playlist_id_from_entry(entry):
    pid = entry.get("id") or ""
    url = entry.get("url") or ""
    m = re.search(r"[?&]list=([A-Za-z0-9_-]+)", url)
    if m:
        pid = m.group(1)
    if pid.startswith("VL") and len(pid) > 4:
        pid = pid[2:]
    return pid if PLAYLIST_ID_RE.match(pid) else None


def fetch_playlists(browser):
    if browser == "none":
        raise RuntimeError("Set a browser in the widget settings to read your library")
    last_error = None
    for url in LIBRARY_URLS:
        try:
            data = run_ytdlp(url, browser)
        except RuntimeError as exc:
            last_error = exc
            continue
        items, seen = [], {p["id"] for p in PINNED}
        for entry in data.get("entries") or []:
            if not isinstance(entry, dict):
                continue
            pid = playlist_id_from_entry(entry)
            if not pid or pid in seen:
                continue
            seen.add(pid)
            count = entry.get("playlist_count")
            items.append({
                "id": pid,
                "title": clean_text(entry.get("title")) or pid,
                "count": count if isinstance(count, int) and 0 <= count < 1_000_000 else None,
            })
            if len(items) >= MAX_PLAYLISTS:
                break
        return with_pinned(items)
    raise last_error or RuntimeError("Could not read the library")


def with_pinned(items):
    """Liked Music and My Supermix first, also for caches written before
    Supermix was pinned."""
    pinned_ids = {p["id"] for p in PINNED}
    return [dict(p) for p in PINNED] + [p for p in items if isinstance(p, dict) and p.get("id") not in pinned_ids]


def artist_of(entry):
    for key in ("artist", "channel", "uploader", "creator"):
        value = entry.get(key)
        if isinstance(value, list):
            value = ", ".join(str(v) for v in value[:4])
        if value:
            return clean_text(re.sub(r"\s+-\s+Topic$", "", str(value)))
    return ""


def radio_id(video_id):
    return f"RDAMVM{video_id}"


def list_source(playlist_id):
    """URL and item limit for a list id. A song radio is read through a watch
    URL seeded with the song: yt-dlp can't open RDAMVM ids as playlists."""
    if playlist_id.startswith("RDAMVM") and VIDEO_ID_RE.match(playlist_id[6:]):
        seed = playlist_id[6:]
        return f"https://music.youtube.com/watch?v={seed}&list={playlist_id}", RADIO_LIMIT
    if playlist_id.startswith("RD"):
        return f"https://music.youtube.com/playlist?list={playlist_id}", MIX_LIMIT
    return f"https://music.youtube.com/playlist?list={playlist_id}", None


def fetch_tracks(playlist_id, browser):
    if playlist_id.startswith("rd:"):
        return fetch_radio(playlist_id)
    if playlist_id.startswith("ms:"):
        return fetch_server_tracks(playlist_id)
    if playlist_id.startswith("sc:"):
        return fetch_sc_tracks(playlist_id, browser)
    if playlist_id.startswith("sp:"):
        return fetch_sp_tracks(playlist_id)
    url, limit = list_source(playlist_id)
    data = run_ytdlp(url, browser, limit)
    items = []
    for entry in data.get("entries") or []:
        if not isinstance(entry, dict):
            continue
        vid = entry.get("id") or ""
        if not VIDEO_ID_RE.match(vid):
            continue
        title = clean_text(entry.get("title"))
        if title in ("[Deleted video]", "[Private video]"):
            continue
        duration = entry.get("duration")
        items.append({
            "id": vid,
            "title": title or vid,
            "artist": artist_of(entry),
            "duration": int(duration) if isinstance(duration, (int, float)) and 0 < duration < 86400 else None,
        })
        if len(items) >= MAX_TRACKS:
            break
    return {"title": clean_text(data.get("title")), "items": items}


# ---- SoundCloud ---------------------------------------------------------------
# Read with yt-dlp like YouTube, with the same browser's cookies (yt-dlp uses
# SoundCloud's login cookie for private likes). Played by mpv through yt-dlp.

SC_LIMIT = 500


def sc_user(value):
    """A SoundCloud user name from a name or a profile URL, or ""."""
    value = str(value or "").strip()
    m = re.match(r"^(?:https?://(?:www\.|m\.)?soundcloud\.com/)?([A-Za-z0-9_-]{1,100})/?(?:[?#].*)?$", value)
    return m.group(1) if m else ""


def sc_url(key):
    rest = key[3:]
    if rest.isdigit():
        return f"https://api.soundcloud.com/tracks/{rest}"
    return f"https://soundcloud.com/{rest}"


def sc_track_key(url):
    """The key for a SoundCloud track URL; "" for sets and anything else."""
    url = str(url or "")
    m = re.match(r"^https://api(?:-v2)?\.soundcloud\.com/tracks/(?:soundcloud(?:%3A|:)tracks(?:%3A|:))?([0-9]{1,20})", url)
    if m:
        return "sc:" + m.group(1)
    m = re.match(r"^https://(?:www\.|m\.)?soundcloud\.com/([A-Za-z0-9_-]{1,100})/([A-Za-z0-9_-]{1,200})/?(?:[?#].*)?$", url)
    if m and m.group(2) not in ("sets", "likes", "tracks", "albums", "reposts", "followers", "following"):
        return f"sc:{m.group(1)}/{m.group(2)}"
    return ""


def sc_items(data):
    items = []
    for entry in data.get("entries") or []:
        if not isinstance(entry, dict):
            continue
        key = sc_track_key(entry.get("url") or entry.get("webpage_url"))
        if not key:
            continue
        duration = entry.get("duration")
        artist = entry.get("uploader") or (key[3:].split("/")[0] if "/" in key else "")
        items.append({"id": key, "title": clean_text(entry.get("title")) or key, "artist": clean_text(artist),
                      "duration": int(duration) if isinstance(duration, (int, float)) and 0 < duration < 86400 else None})
        if len(items) >= MAX_TRACKS:
            break
    return items


def fetch_sc_tracks(list_id, browser):
    kind, _, rest = list_id[3:].partition(":")
    if kind == "likes":
        url, title = f"https://soundcloud.com/{rest}/likes", "Likes"
    elif kind == "set":
        user, _, slug = rest.partition("/")
        url, title = f"https://soundcloud.com/{user}/sets/{slug}", ""
    else:
        raise RuntimeError("search results are only kept, not fetched again")
    data = run_ytdlp(url, browser, SC_LIMIT)
    return {"title": clean_text(data.get("title")) or title, "items": sc_items(data)}


def fetch_sc_playlists(user, browser):
    data = run_ytdlp(f"https://soundcloud.com/{user}/sets", browser, 200)
    items = [{"id": f"sc:likes:{user}", "title": "Likes", "count": None}]
    for entry in data.get("entries") or []:
        m = re.match(r"^https://(?:www\.)?soundcloud\.com/([A-Za-z0-9_-]{1,100})/sets/([A-Za-z0-9_-]{1,200})/?$",
                     str((entry or {}).get("url") or ""))
        if m:
            items.append({"id": f"sc:set:{m.group(1)}/{m.group(2)}", "title": clean_text(entry.get("title")) or m.group(2),
                          "count": None})
    return {"items": items[:MAX_PLAYLISTS]}


# ---- Spotify ------------------------------------------------------------------
# Spotify's audio is DRM-protected, so this reads the user's library through
# the Web API and plays each song from its YouTube Music match. The Web API
# needs the user's own app (developer.spotify.com, Premium, Spotify's 2026
# rules): its Client ID is the setting spotifyClientId. Login is the
# Authorization Code flow with PKCE on a loopback redirect; tokens are kept
# owner-only in the data directory and sent only to Spotify.

SP_API = "https://api.spotify.com/v1"
SP_AUTH = "https://accounts.spotify.com/authorize"
SP_TOKEN = "https://accounts.spotify.com/api/token"
SP_SCOPES = "playlist-read-private playlist-read-collaborative user-library-read"
SP_ID_RE = re.compile(r"^[A-Za-z0-9]{22}$")
SP_CLIENT_RE = re.compile(r"^[A-Za-z0-9]{16,64}$")
SP_TOKEN_PATH = os.path.join(DATA_DIR, "spotify.json")
SP_TRACKS_PATH = os.path.join(CACHE_DIR, "spotify-tracks.json")
SP_MATCH_PATH = os.path.join(CACHE_DIR, "spotify-matches.json")
SP_LIMIT = 2000


def sp_client_id():
    value = str(widget_settings().get("spotifyClientId") or "").strip()
    return value if SP_CLIENT_RE.match(value) else ""


def sp_tokens():
    data = read_json(SP_TOKEN_PATH)
    return data if isinstance(data, dict) and data.get("refresh_token") else None


def spotify_connected():
    return sp_tokens() is not None and sp_client_id() != ""


def sp_save_tokens(data):
    os.makedirs(os.path.dirname(SP_TOKEN_PATH), mode=0o700, exist_ok=True)
    tmp = SP_TOKEN_PATH + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh)
    os.replace(tmp, SP_TOKEN_PATH)


def sp_post_token(form):
    request = urllib.request.Request(SP_TOKEN, data=urllib.parse.urlencode(form).encode(),
                                     headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            return json.loads(response.read(1024 * 1024))
    except urllib.error.HTTPError as exc:
        try:
            err = json.loads(exc.read(65536))
        except ValueError:
            err = {}
        if err.get("error") == "invalid_grant":
            try:
                os.unlink(SP_TOKEN_PATH)          # expired or revoked: connect again
            except OSError:
                pass
            raise RuntimeError("Spotify needs you to connect again")
        raise RuntimeError(f"Spotify refused the login ({exc.code})")
    except (OSError, ValueError) as exc:
        raise RuntimeError(f"Spotify didn't answer: {exc}")


def sp_access_token():
    tokens = sp_tokens()
    client = sp_client_id()
    if not tokens or not client:
        raise RuntimeError("Connect Spotify")
    if time.time() < float(tokens.get("expires_at") or 0) - 60:
        return tokens["access_token"]
    fresh = sp_post_token({"grant_type": "refresh_token", "refresh_token": tokens["refresh_token"], "client_id": client})
    tokens["access_token"] = fresh["access_token"]
    tokens["expires_at"] = time.time() + int(fresh.get("expires_in") or 3600)
    if fresh.get("refresh_token"):                # it rotates only sometimes
        tokens["refresh_token"] = fresh["refresh_token"]
    sp_save_tokens(tokens)
    return tokens["access_token"]


def sp_get(path):
    url = path if path.startswith(SP_API + "/") else SP_API + path
    if not url.startswith(SP_API + "/"):
        raise RuntimeError("bad Spotify URL")
    for attempt in range(2):
        request = urllib.request.Request(url, headers={"Authorization": f"Bearer {sp_access_token()}"})
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                return json.loads(response.read(MAX_API_RESPONSE))
        except urllib.error.HTTPError as exc:
            if exc.code == 401 and attempt == 0:
                tokens = sp_tokens() or {}
                tokens["expires_at"] = 0
                sp_save_tokens(tokens)
                continue
            if exc.code == 403:
                raise RuntimeError("Spotify refused: the app's owner needs Premium, and you must be on the app's user list")
            if exc.code == 429:
                raise RuntimeError("Spotify's limit for this app is used up for now; try again later")
            raise RuntimeError(f"Spotify error {exc.code}")
        except (OSError, ValueError) as exc:
            raise RuntimeError(f"Spotify didn't answer: {exc}")
    raise RuntimeError("Spotify needs you to connect again")


def sp_track(obj):
    """A Spotify track object as a playlist item, remembered for matching."""
    if not isinstance(obj, dict) or obj.get("type", "track") != "track" or not SP_ID_RE.match(str(obj.get("id") or "")):
        return None
    artists = ", ".join(clean_text(a.get("name"), 80) for a in obj.get("artists") or [] if isinstance(a, dict))
    images = (obj.get("album") or {}).get("images") or []
    cover = next((i.get("url") for i in sorted(images, key=lambda i: i.get("width") or 0)
                  if isinstance(i, dict) and (i.get("width") or 0) >= 200), None) or (images[0].get("url") if images else None)
    duration = obj.get("duration_ms")
    t = {"id": "sp:" + obj["id"], "title": clean_text(obj.get("name")) or obj["id"], "artist": artists,
         "duration": int(duration / 1000) if isinstance(duration, (int, float)) and duration > 0 else None}
    if isinstance(cover, str) and re.match(r"^https://i\.scdn\.co/image/[A-Za-z0-9]{1,100}$", cover):
        t["cover"] = cover
    isrc = ((obj.get("external_ids") or {}).get("isrc") or "")
    if re.match(r"^[A-Z0-9]{12}$", isrc):
        t["isrc"] = isrc
    return t


def sp_pages(path, key_of_track):
    items, url = [], path
    while url and len(items) < SP_LIMIT:
        page = sp_get(url)
        for it in page.get("items") or []:
            t = sp_track((it or {}).get(key_of_track) or (it or {}).get("track") or (it or {}).get("item"))
            if t:
                items.append(t)
        url = page.get("next")
    remember_sp_tracks(items)
    return items


def remember_sp_tracks(items):
    data = read_json(SP_TRACKS_PATH)
    known = data if isinstance(data, dict) else {}
    for t in items:
        known[t["id"]] = {k: t.get(k) for k in ("title", "artist", "duration", "isrc", "cover")}
    write_json_atomic(SP_TRACKS_PATH, known)


def fetch_sp_playlists():
    me = sp_get("/me")
    items = [{"id": "sp:liked", "title": "Liked Songs", "count": None}]
    url = "/me/playlists?limit=50"
    while url and len(items) < MAX_PLAYLISTS:
        page = sp_get(url)
        for pl in page.get("items") or []:
            if not isinstance(pl, dict) or not SP_ID_RE.match(str(pl.get("id") or "")):
                continue
            # Spotify only gives an app the songs of playlists you own or
            # collaborate on; the others would open empty.
            if (pl.get("owner") or {}).get("id") != me.get("id") and not pl.get("collaborative"):
                continue
            total = ((pl.get("items") or pl.get("tracks") or {}).get("total"))
            items.append({"id": "sp:pl:" + pl["id"], "title": clean_text(pl.get("name")) or pl["id"],
                          "count": total if isinstance(total, int) else None})
        url = page.get("next")
    return {"items": items, "user": clean_text(me.get("display_name") or me.get("id"), 80)}


def fetch_sp_tracks(list_id):
    if list_id == "sp:liked":
        return {"title": "Liked Songs", "items": sp_pages("/me/tracks?limit=50", "track")}
    pl = list_id[6:]
    return {"title": "", "items": sp_pages(f"/playlists/{pl}/items?limit=50", "item")}


def normalize(text):
    text = re.sub(r"\(.*?\)|\[.*?\]|feat\..*$|ft\..*$", " ", str(text or "").lower())
    return set(re.findall(r"[\w']+", text))


def match_score(want, cand):
    """How well a YouTube Music song matches a Spotify one (higher is better)."""
    score = 0.0
    wt, ct = normalize(want.get("title")), normalize(cand.get("title"))
    if wt and ct:
        score += 3 * len(wt & ct) / len(wt | ct)
    wa, ca = normalize(want.get("artist")), normalize(cand.get("artist"))
    if wa and ca:
        score += 2 * len(wa & ca) / len(wa | ca)
    if want.get("duration") and cand.get("duration"):
        diff = abs(want["duration"] - cand["duration"])
        score += 2 if diff <= 3 else 1 if diff <= 10 else -2 if diff > 30 else 0
    return score


def resolve_spotify(key):
    """The YouTube Music video id for a Spotify song, cached."""
    sp_id = key[3:]
    matches = read_json(SP_MATCH_PATH)
    matches = matches if isinstance(matches, dict) else {}
    if VIDEO_ID_RE.match(str(matches.get(sp_id) or "")):
        return matches[sp_id]
    known = (read_json(SP_TRACKS_PATH) or {}).get(key)
    if not known:
        raise RuntimeError("unknown Spotify song; open its playlist again")
    best, best_score = None, 1.5
    queries = ([known["isrc"]] if known.get("isrc") else []) + [f"{known.get('artist', '')} {known.get('title', '')}".strip()]
    for q in queries:
        data = music_public("search", {"query": q, "params": SONGS_FILTER})
        for r in find_renderers(data, "musicResponsiveListItemRenderer", [])[:10]:
            cand = explore_item({"musicResponsiveListItemRenderer": r})
            if not cand:
                continue
            score = match_score(known, cand) + (1.0 if q == known.get("isrc") else 0)
            if score > best_score:
                best, best_score = cand["id"], score
        if best and best_score >= 5:
            break
    if not best:
        raise RuntimeError(f"no YouTube Music match for {known.get('title')}")
    matches[sp_id] = best
    write_json_atomic(SP_MATCH_PATH, matches)
    return best


def cmd_resolve(args):
    """resolve <key>: what mpv should open for a song. Spotify songs become
    their YouTube Music match, cloud songs a URL on the local rclone server
    (called by mpv/ytmusic.lua)."""
    key = args[0] if args else ""
    if not TRACK_KEY_RE.match(key):
        fail("resolve needs a track")
    try:
        if key.startswith("cl:"):
            emit({"type": "resolved", "key": key, "url": cloud_stream_url(key)})
            return
        if key.startswith("rd:"):
            emit({"type": "resolved", "key": key, "url": radio_stream_url(key)})
            return
        if key.startswith("ms:"):
            emit({"type": "resolved", "key": key, "url": server_stream_url(key)})
            return
        vid = resolve_spotify(key) if key.startswith("sp:") else None
    except RuntimeError as exc:
        fail(str(exc))
    emit({"type": "resolved", "key": key, "url": f"https://music.youtube.com/watch?v={vid}" if vid else track_url({"id": key})})


def cmd_spotify_login(_args):
    """Connect Spotify: the PKCE flow in the browser, answered on a
    one-shot loopback server. Register http://127.0.0.1/callback as the
    app's redirect URI (Spotify allows any port on a loopback address)."""
    import base64, hashlib, http.server, secrets, threading
    client = sp_client_id()
    if not client:
        fail("Set your Spotify app's Client ID first", setup="sp")
    verifier = secrets.token_urlsafe(64)[:96]
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip("=")
    state = secrets.token_urlsafe(16)
    result = {}

    class Callback(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            if urllib.parse.urlsplit(self.path).path != "/callback":
                self.send_error(404)
                return
            if q.get("state", [""])[0] == state:
                result["code"] = q.get("code", [""])[0]
                result["error"] = q.get("error", [""])[0]
            ok = bool(result.get("code"))
            body = ("<h2>Spotify is connected.</h2><p>You can close this tab.</p>" if ok
                    else "<h2>Spotify wasn't connected.</h2><p>You can close this tab and try again.</p>").encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    server = http.server.HTTPServer(("127.0.0.1", 0), Callback)
    server.timeout = 1
    redirect = f"http://127.0.0.1:{server.server_address[1]}/callback"
    url = SP_AUTH + "?" + urllib.parse.urlencode({
        "client_id": client, "response_type": "code", "redirect_uri": redirect, "scope": SP_SCOPES,
        "state": state, "code_challenge_method": "S256", "code_challenge": challenge})
    command = browser_command(check_browser(opt(_args, "--browser", "none")))
    subprocess.Popen(command + [url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    emit({"type": "spotify", "state": "waiting"})
    deadline = time.time() + 300
    while time.time() < deadline and "code" not in result:
        server.handle_request()
    server.server_close()
    if not result.get("code"):
        fail("Spotify login didn't finish" + (f": {result['error']}" if result.get("error") else ""))
    try:
        tokens = sp_post_token({"grant_type": "authorization_code", "code": result["code"], "redirect_uri": redirect,
                                "client_id": client, "code_verifier": verifier})
    except RuntimeError as exc:
        fail(str(exc))
    sp_save_tokens({"access_token": tokens["access_token"], "refresh_token": tokens.get("refresh_token"),
                    "expires_at": time.time() + int(tokens.get("expires_in") or 3600)})
    try:
        me = sp_get("/me")
    except RuntimeError as exc:
        fail(str(exc))
    emit({"type": "spotify", "state": "connected", "user": clean_text(me.get("display_name") or me.get("id"), 80)})


def cmd_spotify_logout(_args):
    try:
        os.unlink(SP_TOKEN_PATH)
    except OSError:
        pass
    emit({"type": "spotify", "state": "disconnected"})


# ---- mixes: My Mix (likes from every service) and your own mixed playlists ----

MIXES_PATH = os.path.join(DATA_DIR, "mixes.json")
MIX_ID_RE = re.compile(r"^mix:[a-f0-9]{8}$")


def read_mixes():
    data = read_json(MIXES_PATH)
    mixes = data.get("mixes") if isinstance(data, dict) and isinstance(data.get("mixes"), list) else []
    return [m for m in mixes if isinstance(m, dict) and MIX_ID_RE.match(str(m.get("id", "")))]


def write_mixes(mixes):
    os.makedirs(DATA_DIR, mode=0o700, exist_ok=True)
    write_json_atomic(MIXES_PATH, {"mixes": mixes})


def clean_track(t):
    """A track as the panel sent it, reduced to what a mix keeps."""
    if not isinstance(t, dict) or not TRACK_KEY_RE.match(str(t.get("id", ""))):
        return None
    d = t.get("duration")
    out = {"id": t["id"], "title": clean_text(t.get("title"), 200) or t["id"], "artist": clean_text(t.get("artist"), 200),
           "duration": int(d) if isinstance(d, (int, float)) and 0 < d < 86400 else None}
    cover = t.get("cover")
    if isinstance(cover, str) and re.match(r"^https://(?:i\.scdn\.co|i[0-9]?\.sndcdn\.com)/[A-Za-z0-9_./-]{1,300}$", cover):
        out["cover"] = cover
    return out


def liked_everywhere(browser):
    """My Mix: the liked songs from every connected service, each list
    shuffled and then taken in turn, so the services alternate. The order is
    the same all day (seeded by the date), so the list and the queue agree."""
    lists = []
    for list_id in ["LM", "sp:liked"] + ([f"sc:likes:{u}"] if (u := sc_user(widget_settings().get("soundcloudUser"))) else []):
        cached = read_json(tracks_cache_path(list_id, browser))
        items = playable(cached.get("items")) if isinstance(cached, dict) else []
        if items:
            lists.append(items)
    rng = random.Random(time.strftime("%Y-%m-%d"))
    for items in lists:
        rng.shuffle(items)
    out, seen = [], set()
    for i in range(max((len(l) for l in lists), default=0)):
        for items in lists:
            if i < len(items) and items[i]["id"] not in seen:
                seen.add(items[i]["id"])
                out.append(items[i])
    return out[:MAX_TRACKS]


def mix_tracks(list_id, browser):
    if list_id == "mix:all":
        return {"title": "My Mix", "items": liked_everywhere(browser)}
    for m in read_mixes():
        if m["id"] == list_id:
            return {"title": clean_text(m.get("title")) or "Mix", "items": playable(m.get("items"))}
    return {"title": "Mix", "items": []}


def cmd_mixes(_args):
    emit({"type": "mixes", "items": [{"id": m["id"], "title": clean_text(m.get("title")) or "Mix",
                                       "count": len(playable(m.get("items")))} for m in read_mixes()]})


def cmd_mix_add(args):
    """mix-add <mix-id|new> --track JSON [--title T]: add a song (any
    service) to one of your mixes, or start a new mix with it."""
    target = args[0] if args else ""
    try:
        track = clean_track(json.loads(opt(args, "--track", "")))
    except ValueError:
        track = None
    if not track:
        fail("mix-add needs a track")
    mixes = read_mixes()
    if target == "new":
        target = "mix:" + os.urandom(4).hex()
        title = clean_text(opt(args, "--title", ""), 80) or f"Mix {len(mixes) + 1}"
        mixes.append({"id": target, "title": title, "items": []})
    mix = next((m for m in mixes if m["id"] == target), None)
    if not mix:
        fail("No such mix")
    items = playable(mix.get("items"))
    already = any(t["id"] == track["id"] for t in items)
    if not already:
        items.append(track)
    mix["items"] = items[:MAX_TRACKS]
    write_mixes(mixes)
    emit({"type": "mixAdded", "id": target, "title": clean_text(mix.get("title")), "already": already})


def cmd_mix_remove(args):
    if len(args) < 2 or not MIX_ID_RE.match(args[0]) or not TRACK_KEY_RE.match(args[1]):
        fail("mix-remove needs a mix id and a track")
    mixes = read_mixes()
    for m in mixes:
        if m["id"] == args[0]:
            m["items"] = [t for t in playable(m.get("items")) if t["id"] != args[1]]
    write_mixes(mixes)
    emit({"type": "mixRemoved", "id": args[0], "track": args[1]})


def cmd_mix_delete(args):
    if not args or not MIX_ID_RE.match(args[0]):
        fail("mix-delete needs a mix id")
    write_mixes([m for m in read_mixes() if m["id"] != args[0]])
    emit({"type": "mixDeleted", "id": args[0]})


def tracks_cache_path(playlist_id, browser):
    """Mixes ("RD..." lists: song radios, My Supermix) are personalized by
    the cookies they were read with, so each browser setting gets its own
    copy; a guest Supermix must never stand in for the account's."""
    name = re.sub(r"[^A-Za-z0-9_.-]", "_", playlist_id)
    if playlist_id.startswith("RD"):
        name += "." + re.sub(r"[^A-Za-z0-9_.+-]", "_", browser)
    return os.path.join(CACHE_DIR, "tracks", f"{name}.json")


def cached_then_fresh(kind, cache_path, max_age, fetch, extra=None, items_filter=None):
    extra = extra or {}
    cached = read_json(cache_path)
    fresh_enough = False
    if isinstance(cached, dict) and isinstance(cached.get("items"), list):
        age = time.time() - float(cached.get("fetchedAt") or 0)
        fresh_enough = max_age < 0 or age <= max_age
        if items_filter:
            cached["items"] = items_filter(cached["items"])
        emit({"type": kind, "stale": not fresh_enough, **extra, **cached})
    elif max_age < 0:
        emit({"type": kind, "stale": True, "items": [], **extra})
        return
    if fresh_enough:
        return
    try:
        result = fetch()
    except RuntimeError as exc:
        fail(str(exc))
    result["fetchedAt"] = int(time.time())
    write_json_atomic(cache_path, result)
    emit({"type": kind, "stale": False, **extra, **result})


def cmd_playlists(args):
    browser = check_browser(opt(args, "--browser", "none"))
    max_age = int(opt(args, "--max-age", "3600"))
    service = opt(args, "--service", "yt")
    extra = {"service": service}
    if service == "sc":
        user = sc_user(widget_settings().get("soundcloudUser"))
        if not user:
            fail("Add your SoundCloud profile", kind="error", setup="sc", service="sc")
        cache = os.path.join(CACHE_DIR, f"playlists-sc-{user}.json")
        cached_then_fresh("playlists", cache, max_age, lambda: fetch_sc_playlists(user, browser), extra)
        return
    if service == "sp":
        if not spotify_connected():
            fail("Connect Spotify", kind="error", setup="sp", service="sp")
        cache = os.path.join(CACHE_DIR, "playlists-sp.json")
        cached_then_fresh("playlists", cache, max_age, fetch_sp_playlists, extra)
        return
    if service == "rd":
        emit({"type": "playlists", "stale": False, "items": radio_lists(), **extra})
        return
    if service == "cl":
        sources = read_cloud()
        if not sources:
            fail("Connect your storage", kind="error", setup="cl", service="cl")
        # Listing a big bucket takes a while: reuse it for hours unless asked.
        limit = 0 if max_age == 0 else max(max_age, CLOUD_MIN_AGE)
        cached, stale = [], False
        for src in sources:
            index = read_json(os.path.join(CLOUD_DIR, f"{src['id']}.json"))
            if isinstance(index, dict) and (isinstance(index.get("tracks"), list) or isinstance(index.get("lists"), list)):
                cached += source_lists(src, index)
                stale = stale or time.time() - float(index.get("fetchedAt") or 0) > limit
            else:
                stale = True
        if cached or not stale:
            emit({"type": "playlists", "stale": stale, "items": cached[:MAX_PLAYLISTS], **extra})
        if not stale:
            return
        result = fetch_cloud_playlists(sources, limit)
        if max_age == 0 and not player_running():
            stop_cloud_server()       # so it sees the new files at once
        emit({"type": "playlists", "stale": False, "items": result["items"], **extra})
        if result["errors"] and len(result["errors"]) == len(sources):
            fail(result["errors"][0], service="cl")
        return
    if service == "my":
        items = [{"id": "mix:all", "title": "My Mix", "count": None}]
        ai = read_json(AI_MIX_PATH)
        if isinstance(ai, dict) and ai.get("items"):
            items.insert(0, {"id": "ai:mix", "title": clean_text(ai.get("title"), 60) or "AI Mix",
                             "count": len(playable(ai.get("items"))), "subtitle": clean_text(ai.get("about"), 120)})
        recent = recent_tracks(100)
        if recent:
            items.append({"id": "hist:recent", "title": "Recently played", "count": len(recent)})
        items += [{"id": m["id"], "title": clean_text(m.get("title")) or "Mix", "count": len(playable(m.get("items")))}
                  for m in read_mixes()]
        items.append({"id": DOWNLOADS_ID, "title": "Downloads", "count": len(downloaded_tracks())})
        emit({"type": "playlists", "stale": False, "items": items, **extra})
        return
    cache = os.path.join(CACHE_DIR, f"playlists-{re.sub(r'[^A-Za-z0-9_.+-]', '_', browser)}.json")
    cached_then_fresh("playlists", cache, max_age, lambda: {"items": fetch_playlists(browser)}, extra, items_filter=with_pinned)


def cmd_tracks(args):
    if not args:
        fail("tracks needs a playlist id")
    playlist_id = check_playlist_id(args[0])
    if playlist_id == DOWNLOADS_ID:
        emit({"type": "tracks", "stale": False, "playlistId": DOWNLOADS_ID, "title": "Downloads", "items": downloaded_tracks()})
        return
    if playlist_id.startswith("mix:"):
        emit({"type": "tracks", "stale": False, "playlistId": playlist_id, **mix_tracks(playlist_id, opt(args, "--browser", "none"))})
        return
    if playlist_id == "ai:mix":
        emit({"type": "tracks", "stale": False, "playlistId": playlist_id, **ai_mix_tracks()})
        return
    if playlist_id == "hist:recent":
        emit({"type": "tracks", "stale": False, "playlistId": playlist_id, "title": "Recently played", "items": recent_tracks(100)})
        return
    if playlist_id == "rd:fav":
        emit({"type": "tracks", "stale": False, "playlistId": playlist_id, "title": "Favorite stations",
              "items": with_radio_covers(radio_favorites())})
        return
    if playlist_id.startswith("cl:"):
        try:
            emit({"type": "tracks", "stale": False, "playlistId": playlist_id, **cloud_tracks(playlist_id)})
        except RuntimeError as exc:
            fail(str(exc))
        return
    browser = check_browser(opt(args, "--browser", "none"))
    max_age = int(opt(args, "--max-age", "3600"))
    cache = tracks_cache_path(playlist_id, browser)
    cached_then_fresh("tracks", cache, max_age, lambda: fetch_tracks(playlist_id, browser), {"playlistId": playlist_id})


def mpv_request(command, timeout=1.0):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(timeout)
            sock.connect(SOCKET_PATH)
            sock.sendall((json.dumps({"command": command}) + "\n").encode())
            return True
    except OSError:
        return False


def mpv_batch(commands, timeout=3.0):
    """Send several commands on one connection and wait for every reply, so
    mpv has applied them all before we return. Returns the replies."""
    replies = {}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(timeout)
            sock.connect(SOCKET_PATH)
            payload = "".join(json.dumps({"command": c, "request_id": i + 1}) + "\n" for i, c in enumerate(commands))
            sock.sendall(payload.encode())
            buf = b""
            deadline = time.time() + timeout
            while len(replies) < len(commands) and time.time() < deadline:
                chunk = sock.recv(65536)
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(msg, dict) and "request_id" in msg and "event" not in msg:
                        replies[msg["request_id"]] = msg
    except OSError:
        return None
    return [replies.get(i + 1) for i in range(len(commands))]


class SessionLock:
    """Serializes queue changes: every monitor's bar runs its own widget, and
    two of them could otherwise extend the same queue at once."""

    def __enter__(self):
        self.fh = open(LOCK_PATH, "w")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def our_mpv_pid():
    try:
        with open(PID_PATH) as fh:
            pid = int(fh.read().strip())
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            if SOCKET_PATH.encode() in fh.read():
                return pid
    except (OSError, ValueError):
        pass
    return None


def stop_player():
    pid = our_mpv_pid()
    mpv_request(["quit"])
    if pid:
        for _ in range(20):
            if not os.path.exists(f"/proc/{pid}"):
                break
            time.sleep(0.05)
        else:
            try:
                os.kill(pid, 15)
            except OSError:
                pass
    for path in (SOCKET_PATH, PID_PATH):
        try:
            os.unlink(path)
        except OSError:
            pass


def cmd_stop(_args):
    end_session()
    stop_cloud_server()
    emit({"type": "stopped"})


def player_options(args):
    browser = check_browser(opt(args, "--browser", "none"))
    repeat = opt(args, "--repeat", "off")
    if repeat not in ("off", "all", "one"):
        fail("--repeat must be off, all or one")
    transition = opt(args, "--transition", "off")
    if transition not in ("off", "peak"):
        fail("--transition must be off or peak")
    return {
        "browser": browser,
        "playback_cookies": opt(args, "--playback-cookies", "0") == "1",
        "volume": min(100, max(0, int(opt(args, "--volume", "60")))),
        "repeat": repeat,
        "fade_in": min(30.0, max(0.0, float(opt(args, "--fade-in", "0")))),
        "pause_fade": min(3.0, max(0.0, float(opt(args, "--pause-fade", "0.6")))),
        "fade_out": min(30.0, max(0.0, float(opt(args, "--fade-out", "0")))),
        "transition": transition,
        "xfade": min(16.0, max(2.0, float(opt(args, "--xfade", "6")))),
    }


def load_tracks(playlist_id, browser, max_age=None, raise_errors=False):
    """Tracks for a list from the cache (any age when max_age is None),
    fetching and caching them when missing or too old. If the fetch fails,
    an old cached copy is better than nothing."""
    if playlist_id == DOWNLOADS_ID:
        return {"title": "Downloads", "items": downloaded_tracks()}
    if playlist_id.startswith("mix:"):
        return mix_tracks(playlist_id, browser)
    if playlist_id == "ai:mix":
        return ai_mix_tracks()
    if playlist_id == "hist:recent":
        return {"title": "Recently played", "items": recent_tracks(100)}
    if playlist_id == "rd:fav":
        return {"title": "Favorite stations", "items": with_radio_covers(radio_favorites())}
    if playlist_id.startswith("cl:"):
        try:
            return cloud_tracks(playlist_id)
        except RuntimeError as exc:
            if raise_errors:
                raise
            fail(str(exc))
    path = tracks_cache_path(playlist_id, browser)
    old = read_json(path)
    has_old = isinstance(old, dict) and bool(old.get("items"))
    if has_old:
        age = time.time() - float(old.get("fetchedAt") or 0)
        if max_age is None or age <= max_age:
            return old
    try:
        cached = fetch_tracks(playlist_id, browser)
    except RuntimeError as exc:
        if has_old:
            return old
        if raise_errors:
            raise
        fail(str(exc))
    cached["fetchedAt"] = int(time.time())
    write_json_atomic(path, cached)
    return cached


def playable(items):
    return [t for t in items or [] if isinstance(t, dict) and TRACK_KEY_RE.match(str(t.get("id", "")))]


def track_url(track):
    """What mpv opens: a downloaded song's own file, else its YouTube page."""
    path = track.get("path")
    if isinstance(path, str) and os.path.isabs(path) and os.path.isfile(path):
        return path
    key = track["id"]
    if key.startswith("sc:"):
        return sc_url(key)
    if key.startswith("sp:"):
        # mpv/ytmusic.lua resolves it to the song's YouTube Music match.
        return SPOTIFY_SCHEME + key[3:]
    if key.startswith("cl:"):
        # mpv/ytmusic.lua resolves it to the file on the local rclone server.
        return CLOUD_SCHEME + key[3:]
    if key.startswith("rd:"):
        # mpv/ytmusic.lua resolves it to the station's stream.
        return RADIO_SCHEME + key[3:]
    if key.startswith("ms:"):
        # mpv/ytmusic.lua resolves it to the media server's stream.
        return SERVER_SCHEME + key[3:]
    return f"https://music.youtube.com/watch?v={key}"


def playback_cookie_spec(options):
    """The --cookies-from-browser value the player should pass to yt-dlp, or
    None when playback must not use cookies."""
    if options["playback_cookies"] and options["browser"] != "none":
        return cookie_spec(options["browser"])
    return None


def end_session():
    stop_player()
    try:
        os.unlink(SESSION_PATH)
    except OSError:
        pass


def apply_player_cookies(options):
    """Bring a running player's cookie use in line with `options`. mpv's
    ytdl hook reads ytdl-raw-options on every track it opens, so changing the
    option in place covers every later track. If the change can't be read
    back, stop the player rather than let it keep the old access.
    Returns "idle", "applied" or "stopped"."""
    if not player_running():
        return "idle"
    want = playback_cookie_spec(options)
    replies = mpv_batch([["get_property", "ytdl-raw-options"]]) or [None]
    current = replies[0].get("data") if isinstance(replies[0], dict) else None
    if isinstance(current, dict):
        updated = {k: v for k, v in current.items() if k != "cookies-from-browser"}
        if want:
            updated["cookies-from-browser"] = want
        replies = mpv_batch([["set_property", "ytdl-raw-options", updated],
                             ["get_property", "ytdl-raw-options"]]) or [None, None]
        check = replies[1].get("data") if isinstance(replies[1], dict) else None
        if isinstance(check, dict) and check.get("cookies-from-browser") == want:
            return "applied"
    end_session()
    return "stopped"


def cmd_cookies(args):
    options = player_options(args)
    with SessionLock():
        state = apply_player_cookies(options)
    emit({"type": "stopped"} if state == "stopped" else {"type": "cookies", "state": state})


def start_player(playlist_id, title, order, start, options, autoplay=False):
    """Replace any running player with a new one playing `order`."""
    stop_player()

    with open(QUEUE_PATH, "w", encoding="utf-8") as fh:
        fh.write("#EXTM3U\n")
        for t in order:
            label = clean_text(f"{t.get('artist')} - {t.get('title')}"
                               if t.get("artist") and not str(t.get("id", "")).startswith("rd:") else t.get("title"))
            fh.write(f"#EXTINF:{t.get('duration') or -1},{label}\n")
            fh.write(track_url(t) + "\n")

    write_json_atomic(SESSION_PATH, {
        "playlistId": playlist_id,
        "playlistTitle": title,
        "shuffle": options.get("shuffle", False),
        "autoplay": autoplay,
        "tracks": order,
        "startedAt": int(time.time()),
    })

    repeat = options["repeat"]
    cmd = [
        "mpv", "--no-video", "--force-window=no", "--no-terminal", "--idle=no",
        "--audio-display=no", "--audio-client-name=YouTube Music",
        f"--input-ipc-server={SOCKET_PATH}",
        "--ytdl-format=bestaudio/best", "--prefetch-playlist=yes",
        f"--volume={options['volume']}", f"--playlist-start={start}",
        # Repeat one loops the current track; repeat all wraps the queue.
        f"--loop-file={'inf' if repeat == 'one' else 'no'}",
        f"--loop-playlist={'inf' if repeat == 'all' else 'no'}",
        "--msg-level=all=warn,ytmusic=info", f"--log-file={MPV_LOG}",
        # Songs join without a gap: the peak mix relies on it.
        "--gapless-audio=yes",
        # A deeper PipeWire buffer (the default is one 21 ms quantum): a
        # moment of system load (switching the keyboard layout through an
        # input method, an app starting) no longer makes the sound drop out.
        "--pipewire-buffer=100",
        # Fades and the peak mix (see mpv/ytmusic.lua).
        f"--script={MPV_SCRIPT}",
        f"--script-opts-append=ytmusic-helper={os.path.realpath(__file__)}",
        f"--script-opts-append=ytmusic-python={sys.executable or 'python3'}",
        f"--script-opts-append=ytmusic-fade_in={options['fade_in']:g}",
        f"--script-opts-append=ytmusic-pause_fade={options['pause_fade']:g}",
        f"--script-opts-append=ytmusic-fade_out={options['fade_out']:g}",
        f"--script-opts-append=ytmusic-transition={options['transition']}",
        f"--script-opts-append=ytmusic-xfade={options['xfade']:g}",
    ]
    spec = playback_cookie_spec(options)
    if spec:
        cmd.append(f"--ytdl-raw-options-append=cookies-from-browser={spec}")
    cmd.append(f"--playlist={QUEUE_PATH}")

    with open(os.devnull, "rb") as devnull_in, open(os.devnull, "wb") as devnull_out:
        proc = subprocess.Popen(cmd, stdin=devnull_in, stdout=devnull_out, stderr=devnull_out,
                                start_new_session=True, close_fds=True)
    with open(PID_PATH, "w") as fh:
        fh.write(str(proc.pid))

    for _ in range(100):
        if proc.poll() is not None:
            fail(f"mpv exited early (see {MPV_LOG})")
        if os.path.exists(SOCKET_PATH) and mpv_request(["get_property", "pid"]):
            emit({"type": "playing", "socket": SOCKET_PATH, "index": start, "count": len(order)})
            return
        time.sleep(0.05)
    fail("mpv did not open its control socket")


def cmd_play(args):
    if not args:
        fail("play needs a playlist id")
    playlist_id = check_playlist_id(args[0])
    options = player_options(args)
    index = max(0, int(opt(args, "--index", "0")))
    shuffle = opt(args, "--shuffle", "0") == "1"

    cached = load_tracks(playlist_id, options["browser"])
    tracks = playable(cached.get("items"))
    if not tracks:
        fail("This playlist has no playable tracks")
    index = min(index, len(tracks) - 1)
    # The panel also names the song: start on it even if the cached list
    # changed since the panel showed it.
    video_id = opt(args, "--video-id", "")
    if TRACK_KEY_RE.match(video_id) and tracks[index]["id"] != video_id:
        index = next((i for i, t in enumerate(tracks) if t["id"] == video_id), index)

    if shuffle:
        first = tracks[index]
        rest = tracks[:index] + tracks[index + 1:]
        random.shuffle(rest)
        order, start = [first] + rest, 0
    else:
        order, start = tracks, index

    options["shuffle"] = shuffle
    title = clean_text(opt(args, "--title", "")) or cached.get("title") or ""
    with SessionLock():
        start_player(playlist_id, title, order, start, options)


def player_running():
    return our_mpv_pid() is not None and os.path.exists(SOCKET_PATH)


def backup_tracks(browser, exclude):
    """Songs to keep autoplay going without YouTube's recommendations: the
    saved Liked Music and My Supermix lists, minus what's queued, shuffled."""
    seen, out = set(exclude), []
    for list_id in (LIKED_MUSIC["id"], SUPERMIX["id"]):
        cached = read_json(tracks_cache_path(list_id, browser))
        for t in playable(cached.get("items") if isinstance(cached, dict) else []):
            if t["id"] not in seen:
                seen.add(t["id"])
                out.append(t)
    random.shuffle(out)
    return out


def cmd_radio(args):
    if not args or not VIDEO_ID_RE.match(args[0]):
        fail("radio needs a video id")
    seed = args[0]
    mode = opt(args, "--mode", "replace")
    if mode not in ("replace", "keep", "append"):
        fail("--mode must be replace, keep or append")
    options = player_options(args)
    list_id = radio_id(seed)

    with SessionLock():
        session = read_json(SESSION_PATH)
        queue = playable(session.get("tracks")) if isinstance(session, dict) else []

        # Autoplay: extend only while the seed is still the last queued song.
        # This keeps it idempotent when several bars ask at once.
        if mode == "append":
            if not player_running() or not queue or queue[-1]["id"] != seed:
                emit({"type": "radio", "mode": mode, "added": 0})
                return
            if len(queue) >= MAX_TRACKS:
                emit({"type": "radio", "mode": mode, "added": 0})
                return

        try:
            mix = playable(load_tracks(list_id, options["browser"], max_age=3600, raise_errors=True).get("items"))
        except RuntimeError as exc:
            # Autoplay keeps the music going even when YouTube's
            # recommendations can't be read: songs from the saved lists.
            if mode != "append":
                fail(str(exc))
            mix = backup_tracks(options["browser"], {t["id"] for t in queue})
        if not mix:
            fail("YouTube Music has no radio for this song")
        title = clean_text(opt(args, "--title", "")) or "Radio"

        # A player that is kept follows the current cookie settings too.
        if mode in ("keep", "append") and player_running() and apply_player_cookies(options) == "stopped":
            if mode == "append":
                emit({"type": "stopped"})
                return
        if mode == "keep" and not player_running():
            mode = "replace"
        if mode == "replace":
            start_player(list_id, title, mix, 0, options)
            return

        if mode == "keep":
            # The playing song continues; everything after it becomes the radio.
            replies = mpv_batch([["get_property", "playlist-pos"]]) or [None]
            pos = replies[0].get("data") if isinstance(replies[0], dict) else None
            current = queue[pos] if isinstance(pos, int) and 0 <= pos < len(queue) else mix[0]
            upcoming = [t for t in mix if t["id"] != current["id"]]
            write_json_atomic(SESSION_PATH, {
                "playlistId": list_id,
                "playlistTitle": title,
                "shuffle": False,
                "autoplay": False,
                "tracks": [current] + upcoming,
                "startedAt": int(time.time()),
            })
            mpv_batch([["playlist-clear"]] + [["loadfile", track_url(t), "append"] for t in upcoming])
            emit({"type": "radio", "mode": mode, "added": len(upcoming)})
            return

        # append
        seen = {t["id"] for t in queue}
        new = [t for t in mix if t["id"] not in seen][:AUTOPLAY_ADD]
        if new:
            session["tracks"] = queue + new
            session["autoplay"] = True
            write_json_atomic(SESSION_PATH, session)
            mpv_batch([["loadfile", track_url(t), "append"] for t in new])
        emit({"type": "radio", "mode": mode, "added": len(new)})


# ---- peak mix: climax-to-climax transitions -----------------------------------

MIX_DIR = os.path.join(CACHE_DIR, "mix")
MIX_FPS = 10              # loudness frames per second
MIX_WINDOW = 20.0         # seconds a climax is scored over
MIX_MAX_GAIN = 8.0        # dB a song's level may be changed to match the last
MIX_KEEP_SEGMENTS = 4     # rendered songs kept (each is the rest of a song)
MIX_KEEP_AUDIO = 12       # downloaded songs kept
MIX_MAX_DURATION = 15 * 60
SEGMENT_RE = re.compile(r"^seg-([A-Za-z0-9_-]{11,24})-([A-Za-z0-9_-]{11,24})\.flac$")
AUDIO_NAME_RE = re.compile(r"^audio-[A-Za-z0-9_-]{11,24}\.[a-z0-9]{2,5}$")


def cache_name(key):
    """A track's name in the audio cache. A Spotify song is cached as its
    YouTube Music match, so both share one download."""
    # No dash in these: a rendered segment is named seg-<a>-<b>, and a dash
    # inside <a> or <b> would make that name ambiguous.
    if key.startswith("sc:"):
        return "sc" + hashlib.sha1(key.encode()).hexdigest()[:16]
    if key.startswith("sp:"):
        return resolve_spotify(key)
    if key.startswith("cl:"):
        return "cl" + key.rsplit("/", 1)[-1]
    if key.startswith("ms:"):
        return "ms" + hashlib.sha1(key.encode()).hexdigest()[:16]
    return key


def download_url(key):
    if key.startswith("sp:"):
        return f"https://music.youtube.com/watch?v={resolve_spotify(key)}"
    return track_url({"id": key})
WATCH_RE = re.compile(r"^https://music\.youtube\.com/watch\?v=([A-Za-z0-9_-]{11})$")


def loudness_envelope(path):
    """Loudness in dB per 1/MIX_FPS s, from the song decoded to 8 kHz mono."""
    try:
        proc = subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-i", path, "-ac", "1", "-ar", "8000",
                               "-f", "s16le", "-"], capture_output=True, timeout=180, stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        raise RuntimeError("ffmpeg is not installed")
    except subprocess.TimeoutExpired:
        raise RuntimeError("ffmpeg timed out")
    if proc.returncode != 0:
        raise RuntimeError("ffmpeg couldn't decode the song")
    samples = array.array("h")
    samples.frombytes(proc.stdout[: len(proc.stdout) // 2 * 2])
    if sys.byteorder != "little":
        samples.byteswap()
    n = 8000 // MIX_FPS
    env = []
    for i in range(0, len(samples) - n + 1, n):
        chunk = samples[i:i + n]
        env.append(10 * math.log10(sum(map(operator.mul, chunk, chunk)) / n + 1.0) - 90.3)
    return env


def moving_average(values, width):
    prefix = [0.0]
    for v in values:
        prefix.append(prefix[-1] + v)
    half = width // 2
    out = []
    for i in range(len(values)):
        a, b = max(0, i - half), min(len(values), i + half + 1)
        out.append((prefix[b] - prefix[a]) / (b - a))
    return out


def find_climax(env, heatmap, xfade):
    """The song's climax from its loudness envelope and, when YouTube has
    one, its "most replayed" heatmap. Returns {entry, exit, level} in
    seconds and dB, or None for a song too short to mix:
      entry: where the climax hits (the sharpest rise in loudness near the
             best-scoring window), so the next song can land on it;
      exit:  where to start leaving: shortly before the energy falls away
             after the climax, 30-70 s after the entry;
      level: the climax's mean loudness, to match songs' levels."""
    fps, n = MIX_FPS, len(env)
    duration = n / fps
    w = int(MIX_WINDOW * fps)
    lo = int(max(15.0, 0.12 * duration, xfade + 2) * fps)
    hi = n - int((MIX_WINDOW + xfade + 2) * fps)
    if hi <= lo:
        return None
    prefix = [0.0]
    for v in env:
        prefix.append(prefix[-1] + v)
    starts = list(range(lo, hi, max(1, fps // 2)))
    loud = [(prefix[s + w] - prefix[s]) / w for s in starts]

    def zscore(xs):
        mean = sum(xs) / len(xs)
        sd = math.sqrt(sum((x - mean) ** 2 for x in xs) / len(xs)) or 1.0
        return [(x - mean) / sd for x in xs]

    score = zscore(loud)
    bins = heatmap_bins(heatmap, duration)
    if bins:
        heat = []
        for s in starts:
            t0, t1 = s / fps, (s + w) / fps
            heat.append(sum(v for a, b, v in bins if a < t1 and b > t0))
        if max(heat) > min(heat):
            score = [a + b for a, b in zip(score, zscore(heat))]
    best = starts[max(range(len(starts)), key=lambda i: score[i])]

    short = moving_average(env, fps)
    rise_lo, rise_hi = max(lo, best - 6 * fps), min(hi, best + 4 * fps)
    entry = max(range(rise_lo, rise_hi + 1), key=lambda x: short[x] - short[max(0, x - 2 * fps)])
    level = (prefix[entry + w] - prefix[entry]) / w

    long = moving_average(env, 8 * fps)
    cap = n - int((xfade + 1) * fps)
    exit_ = min(entry + 60 * fps, cap)
    for x in range(entry + 32 * fps, min(entry + 72 * fps, cap)):
        if long[x] < level - 3.0:
            exit_ = x - 2 * fps
            break
    if exit_ <= entry + 10 * fps:
        return None
    return {"entry": round(entry / fps, 2), "exit": round(exit_ / fps, 2), "level": round(level, 2)}


def heatmap_bins(heatmap, duration):
    """YouTube's "most replayed" bins as (start, end, value), without the
    start of the song (everyone starts at 0:00) and its very end."""
    bins = []
    for b in heatmap if isinstance(heatmap, list) else []:
        try:
            a, z, v = float(b["start_time"]), float(b["end_time"]), float(b["value"])
        except (KeyError, TypeError, ValueError):
            continue
        if 0.1 * duration <= a and z <= 0.97 * duration and z > a and 0 <= v <= 1:
            bins.append((a, z, v))
    return bins[:1000]


def mix_entry(name):
    """(video id, segment sidecar or None) for an mpv playlist entry: a
    music.youtube.com watch URL, or a segment this helper rendered."""
    m = WATCH_RE.match(name or "")
    if m:
        return m.group(1), None
    if (name or "").startswith(SPOTIFY_SCHEME) and SP_ID_RE.match(name[len(SPOTIFY_SCHEME):]):
        return "sp:" + name[len(SPOTIFY_SCHEME):], None
    if sc_track_key(name):
        return sc_track_key(name), None
    if (name or "").startswith(CLOUD_SCHEME) and CLOUD_KEY_RE.match("cl:" + name[len(CLOUD_SCHEME):]):
        return "cl:" + name[len(CLOUD_SCHEME):], None
    if (name or "").startswith(SERVER_SCHEME) and SERVER_KEY_RE.match("ms:" + name[len(SERVER_SCHEME):]):
        return "ms:" + name[len(SERVER_SCHEME):], None
    path = os.path.realpath(name or "")
    if os.path.dirname(path) != os.path.realpath(MIX_DIR):
        return None, None
    m = SEGMENT_RE.match(os.path.basename(path))
    if not m:
        return None, None
    side = read_json(path[:-5] + ".json")
    key = side.get("id") if isinstance(side, dict) else ""
    if not TRACK_KEY_RE.match(str(key or "")) or (not key.startswith("sp:") and cache_name(key) != m.group(2)):
        return None, None
    return key, side


def mix_cookie_opts(spec):
    """yt-dlp options for the cookies the player itself uses: mpv's
    ytdl-raw-options, which follow the playback-cookies setting."""
    if not spec:
        return {}
    from yt_dlp import parse_options
    try:
        parsed = parse_options(["--cookies-from-browser", spec])
    except SystemExit:
        fail("Bad cookie setting")
    return {"cookiesfrombrowser": parsed.ydl_opts.get("cookiesfrombrowser")}


# YouTube serves streams to several "clients" (the web site, TV apps,
# phones). When it changes something, usually only some of them break, so
# a song that won't come through one is tried through the others. None means
# yt-dlp's own default choice.
AUDIO_CLIENTS = [None, "mweb", "tv", "web_safari", "ios"]
AUDIO_DEADLINE = 60
# Reasons no other client gets past: about the song itself, not the stream.
CONTENT_ERROR_RE = re.compile(
    r"members|private video|removed|copyright|not available in your country|confirm your age|"
    r"age[- ]restricted|terminated|account associated", re.I)


def audio_meta(key):
    """The cached download's metadata, or None when it isn't cached."""
    try:
        name = cache_name(key)
    except RuntimeError:
        return None
    meta = read_json(os.path.join(MIX_DIR, f"{name}.json"))
    audio = meta.get("audio") if isinstance(meta, dict) else None
    if audio and AUDIO_NAME_RE.match(audio) and os.path.exists(os.path.join(MIX_DIR, audio)):
        return meta
    return None


def download_audio(video_id, cookie_opts, clients=None, deadline=AUDIO_DEADLINE):
    # `video_id` is any track key; YouTube's other clients only apply to
    # YouTube (a Spotify song is its YouTube Music match).
    name = cache_name(video_id)
    if video_id.startswith("cl:"):
        return copy_cloud_audio(video_id, name), "cloud"
    if video_id.startswith("ms:"):
        return download_server_audio(video_id, name), "server"
    url = download_url(video_id)
    if video_id.startswith("sc:"):
        clients = [None]
    """Download a song's audio into the cache, trying YouTube's clients in
    turn. Returns (metadata, the client that worked); raises RuntimeError
    with YouTube's last reason when none did."""
    from yt_dlp import YoutubeDL
    os.makedirs(MIX_DIR, mode=0o700, exist_ok=True)
    started = time.time()
    last = "no client worked"
    for client in clients or AUDIO_CLIENTS:
        opts = {"format": "bestaudio/best", "outtmpl": os.path.join(MIX_DIR, f"audio-{name}.%(ext)s"),
                "quiet": True, "no_warnings": True, "noprogress": True, "logger": QuietLogger(),
                "noplaylist": True, "socket_timeout": 20, "max_filesize": 200 * 1024 * 1024,
                "match_filter": lambda info, *_, **__: None if (info.get("duration") or 0) <= MIX_MAX_DURATION else "too long",
                **cookie_opts}
        if client:
            opts["extractor_args"] = {"youtube": {"player_client": [client]}}
        try:
            with YoutubeDL(opts) as ydl:
                info = ydl.extract_info(url, download=True)
        except Exception as exc:
            last = str(exc).replace("ERROR: ", "", 1)[:300]
            if CONTENT_ERROR_RE.search(last) or time.time() - started > deadline:
                break
            continue
        path = None
        for d in (info or {}).get("requested_downloads") or []:
            path = d.get("filepath")
        if path and os.path.dirname(os.path.realpath(path)) == os.path.realpath(MIX_DIR) and os.path.exists(path):
            meta = {"audio": os.path.basename(path), "heatmap": (info.get("heatmap") or [])[:1000],
                    "usedAt": int(time.time())}
            thumb = info.get("thumbnail")
            if isinstance(thumb, str) and re.match(r"^https://i[0-9]?\.sndcdn\.com/[A-Za-z0-9_./-]{1,300}$", thumb):
                meta["thumbnail"] = thumb
            write_json_atomic(os.path.join(MIX_DIR, f"{name}.json"), meta)
            return meta, client or "default"
        last = "the download didn't arrive"
    raise RuntimeError(last)


def mix_track(video_id, xfade, cookie_opts):
    """Download a song's audio (cached) and analyze it (cached)."""
    meta_path = os.path.join(MIX_DIR, f"{cache_name(video_id)}.json")
    meta = audio_meta(video_id)
    if meta is None:
        meta, _ = download_audio(video_id, cookie_opts)
    if not isinstance(meta.get("climax"), dict) or meta.get("xfade") != xfade:
        env = loudness_envelope(os.path.join(MIX_DIR, meta["audio"]))
        meta["climax"] = find_climax(env, meta.get("heatmap"), xfade)
        meta["duration"] = round(len(env) / MIX_FPS, 2)
        meta["xfade"] = xfade
    meta["usedAt"] = int(time.time())
    write_json_atomic(meta_path, meta)
    return meta


def render_segment(a_meta, a_gain, b_id, b_meta, b_gain, xfade, out_path):
    """The next song from its build-up to its end, opening with the playing
    song's climax exit crossfading into it (equal power), each at its gain.
    48 kHz stereo FLAC, so mpv joins it to the playing song without a gap."""
    a_exit, b_start = a_meta["climax"]["exit"], b_meta["climax"]["entry"] - xfade
    fmt = "aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo"
    graph = (f"[0:a]{fmt},atrim=start={a_exit:.3f}:end={a_exit + xfade:.3f},asetpts=PTS-STARTPTS,"
             f"volume={a_gain:.2f}dB[a];"
             f"[1:a]{fmt},atrim=start={b_start:.3f},asetpts=PTS-STARTPTS,volume={b_gain:.2f}dB[b];"
             # acrossfade emits the whole overlap as one frame; FLAC wants small ones.
             f"[a][b]acrossfade=d={xfade:.3f}:c1=qsin:c2=qsin,asetnsamples=n=4096:p=0,aformat=sample_fmts=s16[out]")
    tmp = out_path + ".part"
    cmd = ["ffmpeg", "-nostdin", "-v", "error", "-y",
           "-i", os.path.join(MIX_DIR, a_meta["audio"]), "-i", os.path.join(MIX_DIR, b_meta["audio"]),
           "-filter_complex", graph, "-map", "[out]", "-c:a", "flac", "-f", "flac", tmp]
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=180, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise RuntimeError("ffmpeg timed out")
    if proc.returncode != 0:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise RuntimeError("ffmpeg couldn't render the transition")
    os.replace(tmp, out_path)
    write_json_atomic(out_path[:-5] + ".json", {"id": b_id, "offset": round(b_start, 3), "gain": round(b_gain, 2)})


def prune_mix():
    """Keep the cache small: the newest few rendered songs and downloads."""
    try:
        names = os.listdir(MIX_DIR)
    except OSError:
        return
    def newest_first(paths):
        return sorted(paths, key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0, reverse=True)
    segs = newest_first([os.path.join(MIX_DIR, n) for n in names if SEGMENT_RE.match(n)])
    for path in segs[MIX_KEEP_SEGMENTS:]:
        for victim in (path, path[:-5] + ".json"):
            try:
                os.unlink(victim)
            except OSError:
                pass
    audio = newest_first([os.path.join(MIX_DIR, n) for n in names if n.startswith("audio-")])
    for path in audio[MIX_KEEP_AUDIO:]:
        try:
            os.unlink(path)
        except OSError:
            pass


def cmd_mixprep(args):
    if len(args) < 2:
        fail("mixprep needs the current and the next playlist entry")
    xfade = float(opt(args, "--xfade", "6"))
    if not 2 <= xfade <= 16:
        fail("--xfade must be 2-16 seconds")
    min_exit = float(opt(args, "--min-exit", "0"))
    a_id, a_side = mix_entry(args[0])
    b_id, b_side = mix_entry(args[1])
    if not a_id or not b_id or b_side is not None:
        fail("Not a song this player can mix")
    if a_id == b_id:
        emit({"type": "mix", "ok": False, "reason": "same song"})
        return
    cookie_opts = mix_cookie_opts(opt(args, "--cookies-spec", ""))
    try:
        a_meta = mix_track(a_id, xfade, cookie_opts)
        b_meta = mix_track(b_id, xfade, cookie_opts)
    except RuntimeError as exc:
        fail(str(exc))
    if not a_meta.get("climax") or not b_meta.get("climax"):
        emit({"type": "mix", "ok": False, "reason": "no climax found"})
        return
    a_offset = float(a_side["offset"]) if a_side else 0.0
    a_gain = float(a_side["gain"]) if a_side else 0.0
    # Where the playing entry stops, in its own time (a segment starts at
    # its song's build-up).
    local_exit = a_meta["climax"]["exit"] - a_offset
    if local_exit < min_exit:
        emit({"type": "mix", "ok": False, "reason": "past the climax"})
        return
    b_gain = max(-MIX_MAX_GAIN, min(MIX_MAX_GAIN, a_meta["climax"]["level"] + a_gain - b_meta["climax"]["level"]))
    try:
        out = os.path.join(MIX_DIR, f"seg-{cache_name(a_id)}-{cache_name(b_id)}.flac")
    except RuntimeError as exc:
        fail(str(exc))
    try:
        render_segment(a_meta, a_gain, b_id, b_meta, b_gain, xfade, out)
    except RuntimeError as exc:
        fail(str(exc))
    prune_mix()
    emit({"type": "mix", "ok": True, "path": out, "exit": round(local_exit, 3)})


# ---- backup sources ------------------------------------------------------------

# Independent YouTube front ends (opt-in: setting backupMirrors). They are
# the last resort, after the cache and every YouTube client. A mirror sees
# which song is asked for, and nothing else: never cookies or the login.
MIRROR_DIRECTORIES = {
    "invidious": "https://api.invidious.io/instances.json?sort_by=health",
    "piped": "https://piped-instances.kavin.rocks/",
}
MIRRORS_PATH = os.path.join(CACHE_DIR, "mirrors.json")
MIRRORS_MAX_AGE = 24 * 3600
MIRRORS_PER_KIND = 6
MIRRORS_TRIED = 5
MIRROR_DEADLINE = 60
MIRROR_MAX_BYTES = 200 * 1024 * 1024
MIRROR_UA = "Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0"
MIRROR_URL_RE = re.compile(r"^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$")
# Nothing gets past these, mirrors included. (A region block or an age
# check can: a mirror elsewhere may serve the song.)
HOPELESS_RE = re.compile(r"members|private video|removed|terminated|account associated|copyright", re.I)
AUDIO_TYPES = {"audio/webm": "webm", "audio/mp4": "m4a", "audio/ogg": "ogg", "audio/mpeg": "mp3"}


def widget_settings():
    """This widget's entry in shell.json, read when needed so that turning a
    setting off applies at once, also to a player that is already running."""
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    data = read_json(os.path.join(config, "omarchy", "shell.json"))
    layout = ((data or {}).get("bar") or {}).get("layout") if isinstance(data, dict) else None
    for entries in (layout or {}).values() if isinstance(layout, dict) else []:
        for entry in entries if isinstance(entries, list) else []:
            if isinstance(entry, dict) and entry.get("id") == PLUGIN_ID:
                return entry
    return {}


def mirrors_enabled():
    return widget_settings().get("backupMirrors") == "On"


def parse_mirrors(text):
    """'invidious:https://a piped:https://b' (spaces, commas or semicolons
    between them) -> [{kind, url}], keeping only well-formed https URLs."""
    out = []
    for item in re.split(r"[\s,;]+", str(text or "")):
        kind, _, url = item.partition(":")
        url = url.rstrip("/")
        if kind in MIRROR_DIRECTORIES and MIRROR_URL_RE.match(url):
            out.append({"kind": kind, "url": url})
    return out[:20]


def http_get(url, max_bytes, timeout=15, accept="application/json"):
    request = urllib.request.Request(url, headers={"User-Agent": MIRROR_UA, "Accept": accept})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        body = response.read(max_bytes + 1)
        if len(body) > max_bytes:
            raise RuntimeError("response too large")
        return body, response


def http_json(url, max_bytes=4 * 1024 * 1024, timeout=15):
    body, _ = http_get(url, max_bytes, timeout)
    return json.loads(body)


def parse_invidious_directory(data):
    out = []
    for item in data if isinstance(data, list) else []:
        if not (isinstance(item, list) and len(item) == 2 and isinstance(item[1], dict)):
            continue
        info = item[1]
        url = str(info.get("uri") or "").rstrip("/")
        if info.get("type") == "https" and info.get("api") is True and MIRROR_URL_RE.match(url):
            out.append({"kind": "invidious", "url": url})
    return out[:MIRRORS_PER_KIND]


def parse_piped_directory(data):
    out = []
    for item in data if isinstance(data, list) else []:
        if not isinstance(item, dict):
            continue
        url = str(item.get("api_url") or "").rstrip("/")
        if item.get("up_to_date") is not False and MIRROR_URL_RE.match(url):
            out.append((float(item.get("uptime_24h") or 0), {"kind": "piped", "url": url}))
    out.sort(key=lambda x: -x[0])
    return [m for _, m in out][:MIRRORS_PER_KIND]


def mirror_list(refresh=False):
    """The user's own mirrors (setting `mirrors`), or else the healthiest
    ones from the projects' public directories, cached for a day."""
    custom = parse_mirrors(widget_settings().get("mirrors"))
    if custom:
        return custom
    cached = read_json(MIRRORS_PATH)
    if not refresh and isinstance(cached, dict) and time.time() - float(cached.get("fetchedAt") or 0) < MIRRORS_MAX_AGE:
        return [m for m in cached.get("items") or [] if isinstance(m, dict) and MIRROR_URL_RE.match(str(m.get("url")))]
    found = []
    for kind, url in MIRROR_DIRECTORIES.items():
        try:
            data = http_json(url)
        except Exception:
            continue
        found += parse_invidious_directory(data) if kind == "invidious" else parse_piped_directory(data)
    # Alternate the two kinds: if one project is down, the next try is the other.
    inv = [m for m in found if m["kind"] == "invidious"]
    pip = [m for m in found if m["kind"] == "piped"]
    items = [m for pair in zip(inv, pip) for m in pair] + inv[len(pip):] + pip[len(inv):]
    if items:
        write_json_atomic(MIRRORS_PATH, {"fetchedAt": int(time.time()), "items": items})
    elif isinstance(cached, dict):
        items = cached.get("items") or []      # an old list beats none
    return items


def best_audio(formats, url_key, type_key, bitrate_key):
    """The highest-bitrate audio-only stream: (url, extension) or None."""
    best = None
    for f in formats if isinstance(formats, list) else []:
        if not isinstance(f, dict):
            continue
        mime = str(f.get(type_key) or "").split(";")[0].strip().lower()
        ext = AUDIO_TYPES.get(mime)
        url = f.get(url_key)
        if not ext or not isinstance(url, str):
            continue
        try:
            rate = float(f.get(bitrate_key) or 0)
        except (TypeError, ValueError):
            rate = 0
        if best is None or rate > best[0]:
            best = (rate, url, ext)
    return (best[1], best[2]) if best else None


def mirror_stream(mirror, video_id):
    """(stream URL, extension) for a song from one mirror. Invidious is
    asked to proxy the audio itself (local=true), so it comes from the
    mirror's own host; Piped serves it from its proxy hosts."""
    base = mirror["url"]
    if mirror["kind"] == "invidious":
        data = http_json(f"{base}/api/v1/videos/{video_id}?local=true&fields=adaptiveFormats")
        found = best_audio(data.get("adaptiveFormats") if isinstance(data, dict) else None, "url", "type", "bitrate")
        if not found:
            raise RuntimeError("no audio stream")
        url = urllib.parse.urljoin(base + "/", found[0])
        if urllib.parse.urlsplit(url).netloc != urllib.parse.urlsplit(base).netloc:
            raise RuntimeError("stream not proxied by the mirror")
    else:
        data = http_json(f"{base}/streams/{video_id}")
        found = best_audio(data.get("audioStreams") if isinstance(data, dict) else None, "url", "mimeType", "bitrate")
        if not found:
            raise RuntimeError("no audio stream")
        url = found[0]
    if urllib.parse.urlsplit(url).scheme != "https":
        raise RuntimeError("not https")
    return url, found[1]


def decodes(path):
    """True when ffmpeg can decode the start of a downloaded file: a mirror
    could send anything."""
    try:
        proc = subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-t", "3", "-i", path, "-f", "null", "-"],
                              capture_output=True, timeout=30, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return proc.returncode == 0


def download_from_mirrors(video_id, mirrors=None, deadline=MIRROR_DEADLINE):
    """Download a song through the mirrors in turn. Returns (metadata,
    "mirror:<host>"); raises RuntimeError when none served it."""
    os.makedirs(MIX_DIR, mode=0o700, exist_ok=True)
    started = time.time()
    last = "no mirror available"
    for mirror in (mirrors if mirrors is not None else mirror_list())[:MIRRORS_TRIED]:
        if time.time() - started > deadline:
            break
        host = urllib.parse.urlsplit(mirror["url"]).netloc
        try:
            url, ext = mirror_stream(mirror, video_id)
            path = os.path.join(MIX_DIR, f"audio-{video_id}.{ext}")
            body, _ = http_get(url, MIRROR_MAX_BYTES, timeout=30, accept="*/*")
            tmp = path + ".part"
            with open(tmp, "wb") as fh:
                fh.write(body)
            if not decodes(tmp):
                os.unlink(tmp)
                raise RuntimeError("not playable audio")
            os.replace(tmp, path)
        except Exception as exc:
            last = f"{host}: {str(exc)[:120]}"
            continue
        meta = {"audio": os.path.basename(path), "heatmap": [], "usedAt": int(time.time()), "via": f"mirror:{host}"}
        write_json_atomic(os.path.join(MIX_DIR, f"{video_id}.json"), meta)
        return meta, f"mirror:{host}"
    raise RuntimeError(last)


def cmd_mirrors(args):
    """List the mirrors backup sources would use; with --check, ask each one
    for a public test video (no download) and say which answer."""
    mirrors = mirror_list(refresh="--refresh" in args)
    test_id = "dQw4w9WgXcQ"
    for m in mirrors:
        line = {"type": "mirror", "kind": m["kind"], "url": m["url"]}
        if "--check" in args:
            started = time.time()
            try:
                mirror_stream(m, test_id)
                line.update(ok=True, ms=int((time.time() - started) * 1000))
            except Exception as exc:
                line.update(ok=False, reason=clean_text(str(exc), 120))
        emit(line)
    emit({"type": "mirrors", "count": len(mirrors), "enabled": mirrors_enabled()})


def cmd_fallback(args):
    """A song mpv couldn't open through its usual stream: play the cached
    audio if there is one, otherwise download it through YouTube's other
    clients. Called by mpv itself (mpv/ytmusic.lua), never for a reason
    that no source can get past."""
    if not args or not VIDEO_ID_RE.match(args[0]):
        fail("fallback needs a video id")
    video_id = args[0]
    meta = audio_meta(video_id)
    via = "cache"
    if meta is None:
        cookie_opts = mix_cookie_opts(opt(args, "--cookies-spec", ""))
        try:
            meta, via = download_audio(video_id, cookie_opts)
        except RuntimeError as exc:
            reason = str(exc)
            meta = None
            hopeless = bool(HOPELESS_RE.search(reason))
            # Last resort, only when the user turned it on: the mirrors.
            # "off" tells the panel to offer them.
            mirrors = "skipped" if hopeless else ("tried" if mirrors_enabled() else "off")
            if mirrors == "tried":
                try:
                    meta, via = download_from_mirrors(video_id)
                except RuntimeError as mirror_exc:
                    reason = f"{reason}; mirrors: {mirror_exc}"
            if meta is None:
                emit({"type": "fallback", "ok": False, "reason": clean_text(reason),
                      "mirrors": mirrors, "hopeless": hopeless})
                return
    else:
        meta["usedAt"] = int(time.time())
        write_json_atomic(os.path.join(MIX_DIR, f"{video_id}.json"), meta)
    prune_mix()
    emit({"type": "fallback", "ok": True, "path": os.path.join(MIX_DIR, meta["audio"]), "via": via})


# ---- writing to the account (like, add to playlist) --------------------------

MUSIC_ORIGIN = "https://music.youtube.com"
# Fallback only: the current version is taken from yt-dlp, which keeps it up
# to date with YouTube Music.
WEB_REMIX_VERSION = "1.20260707.12.00"
MAX_API_RESPONSE = 4 * 1024 * 1024


class QuietLogger:
    def debug(self, msg): pass
    def info(self, msg): pass
    def warning(self, msg, only_once=False): pass
    def error(self, msg): pass


def browser_spec_tuple(browser):
    """yt-dlp's cookiesfrombrowser tuple: (name, profile, KEYRING, container).
    yt-dlp wants the keyring upper-cased here (its CLI does that itself)."""
    name, keyring, profile = browser_parts(browser)
    return (name, profile, keyring.upper() if keyring else None, None)


def music_client_version():
    try:
        from yt_dlp.extractor.youtube._base import INNERTUBE_CLIENTS
        version = INNERTUBE_CLIENTS["web_music"]["INNERTUBE_CONTEXT"]["client"]["clientVersion"]
        if isinstance(version, str) and re.match(r"^1\.\d{8}\.\d{2}\.\d{2}$", version):
            return version
    except Exception:
        pass
    return WEB_REMIX_VERSION


def sid_authorization(cookies):
    """The SAPISIDHASH family of headers music.youtube.com signs its API
    calls with (the same scheme yt-dlp uses)."""
    sapisid = cookies.get("SAPISID") or cookies.get("__Secure-3PAPISID")
    parts = []
    for scheme, sid in (("SAPISIDHASH", sapisid),
                        ("SAPISID1PHASH", cookies.get("__Secure-1PAPISID")),
                        ("SAPISID3PHASH", cookies.get("__Secure-3PAPISID"))):
        if sid:
            ts = str(round(time.time()))
            digest = hashlib.sha1(f"{ts} {sid} {MUSIC_ORIGIN}".encode()).hexdigest()
            parts.append(f"{scheme} {ts}_{digest}")
    return " ".join(parts)


def music_session(browser):
    """Cookie and Authorization headers for the signed-in account. The
    cookies are read the same way --cookies-from-browser reads them and are
    only ever sent to music.youtube.com."""
    if browser == "none":
        fail("Set a browser in the widget settings to change your library", auth=True)
    try:
        from yt_dlp import YoutubeDL
    except ImportError:
        fail("yt-dlp is not installed")
    try:
        with YoutubeDL({"cookiesfrombrowser": browser_spec_tuple(browser), "quiet": True,
                        "no_warnings": True, "logger": QuietLogger()}) as ydl:
            jar = ydl.cookiejar
            cookie_header = jar.get_cookie_header(MUSIC_ORIGIN + "/")
            cookies = {c.name: c.value for c in jar.get_cookies_for_url(MUSIC_ORIGIN + "/")}
    except Exception as exc:
        fail(f"Couldn't read {browser.partition(':')[0]} cookies: {exc}", auth=True)
    authorization = sid_authorization(cookies)
    if not authorization or "LOGIN_INFO" not in cookies:
        fail(f"Not signed in to YouTube Music in {browser.partition(':')[0]}", auth=True)
    return {"Cookie": cookie_header, "Authorization": authorization}


def log_api_error(endpoint, code, status, message):
    try:
        with open(API_LOG, "a", encoding="utf-8") as fh:
            fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {endpoint} HTTP {code} {status} {clean_text(message)}\n")
    except OSError:
        pass


def api_failure(endpoint, code, status, message, action):
    """Turn a YouTube Music API error into an honest message. Only a real
    sign-in problem (401 / UNAUTHENTICATED) asks the user to sign in."""
    log_api_error(endpoint, code, status, message)
    if code == 401 or status == "UNAUTHENTICATED":
        fail("YouTube Music says you're signed out: sign in again in your browser", auth=True)
    if code == 403 or status == "PERMISSION_DENIED":
        if action == "add":
            fail("YouTube only lets you add songs to playlists you created", status=status or "")
        fail(f"YouTube Music doesn't allow this: {message or status or code}", status=status or "")
    fail(f"YouTube Music: {message or status or f'HTTP {code}'}", status=status or "")


def music_api(endpoint, body, session, action=""):
    """POST to YouTube Music's web API as the signed-in user."""
    version = music_client_version()
    payload = {"context": {"client": {"clientName": "WEB_REMIX", "clientVersion": version, "hl": "en"}}}
    payload.update(body)
    request = urllib.request.Request(
        f"{MUSIC_ORIGIN}/youtubei/v1/{endpoint}?prettyPrint=false",
        data=json.dumps(payload).encode(),
        method="POST",
        headers={
            **session,
            "Content-Type": "application/json",
            "Origin": MUSIC_ORIGIN,
            "X-Origin": MUSIC_ORIGIN,
            "X-Goog-AuthUser": "0",
            "X-Youtube-Client-Name": "67",
            "X-Youtube-Client-Version": version,
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            raw = response.read(MAX_API_RESPONSE + 1)
    except urllib.error.HTTPError as exc:
        status = message = ""
        try:
            err = json.loads(exc.read(65536)).get("error") or {}
            status = clean_text(err.get("status"), 64)
            message = clean_text(err.get("message"), 200)
        except Exception:
            pass
        api_failure(endpoint, exc.code, status, message, action)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        fail(f"Couldn't reach YouTube Music: {getattr(exc, 'reason', exc)}")
    if len(raw) > MAX_API_RESPONSE:
        fail("YouTube Music response too large")
    try:
        return json.loads(raw)
    except ValueError:
        fail("YouTube Music returned invalid JSON")


def update_liked_cache(track, liked):
    """Keep the local Liked Music list in step, so the heart is right without
    re-reading the whole library."""
    path = tracks_cache_path("LM", "none")
    cached = read_json(path)
    if not isinstance(cached, dict) or not isinstance(cached.get("items"), list):
        return
    items = [t for t in cached["items"] if isinstance(t, dict) and t.get("id") != track["id"]]
    if liked:
        items.insert(0, track)
    cached["items"] = items[:MAX_TRACKS]
    write_json_atomic(path, cached)


def cmd_like(args):
    if not args or not VIDEO_ID_RE.match(args[0]):
        fail("like needs a video id")
    video_id = args[0]
    remove = opt(args, "--remove", "0") == "1"
    browser = check_browser(opt(args, "--browser", "none"))
    session = music_session(browser)
    music_api("like/removelike" if remove else "like/like", {"target": {"videoId": video_id}}, session, "like")
    try:
        duration = int(opt(args, "--duration", "0"))
    except ValueError:
        duration = 0
    update_liked_cache({
        "id": video_id,
        "title": clean_text(opt(args, "--title", "")) or video_id,
        "artist": clean_text(opt(args, "--artist", "")),
        "duration": duration if 0 < duration < 86400 else None,
    }, not remove)
    emit({"type": "liked", "id": video_id, "liked": not remove})


def cmd_add(args):
    if len(args) < 2:
        fail("add needs a playlist id and a video id")
    playlist_id = check_playlist_id(args[0])
    video_id = args[1]
    if not VIDEO_ID_RE.match(video_id):
        fail("Invalid video id")
    if playlist_id == "LM" or playlist_id.startswith("RD"):
        fail("Songs can't be added to this list")
    browser = check_browser(opt(args, "--browser", "none"))
    session = music_session(browser)
    result = music_api("browse/edit_playlist", {
        "playlistId": playlist_id,
        "actions": [{"action": "ACTION_ADD_VIDEO", "addedVideoId": video_id,
                     "dedupeOption": "DEDUPE_OPTION_SKIP"}],
    }, session, "add")
    status = result.get("status") if isinstance(result, dict) else None
    if status != "STATUS_SUCCEEDED":
        log_api_error("browse/edit_playlist", 200, status, "")
        fail("YouTube Music didn't add it")
    # The cached copy is out of date now: show it, then refresh on next open.
    path = tracks_cache_path(playlist_id, browser)
    cached = read_json(path)
    if isinstance(cached, dict):
        cached["fetchedAt"] = 0
        write_json_atomic(path, cached)
    emit({"type": "added", "playlistId": playlist_id, "id": video_id})


def find_renderers(node, key, out, depth=0):
    """Every `key` object anywhere in a YouTube response, so the parser
    doesn't depend on how deeply YouTube nests it."""
    if depth > 40 or len(out) >= MAX_PLAYLISTS:
        return out
    if isinstance(node, dict):
        for k, v in node.items():
            if k == key and isinstance(v, dict):
                out.append(v)
            else:
                find_renderers(v, key, out, depth + 1)
    elif isinstance(node, list):
        for v in node:
            find_renderers(v, key, out, depth + 1)
    return out


def text_of(node):
    if isinstance(node, dict):
        if isinstance(node.get("simpleText"), str):
            return node["simpleText"]
        runs = node.get("runs")
        if isinstance(runs, list):
            return "".join(r.get("text", "") for r in runs if isinstance(r, dict))
    return ""


def cmd_targets(args):
    """The playlists this song can be added to, straight from YouTube Music's
    own "Add to playlist" dialog: only playlists you can edit, each marked
    when the song is already in it."""
    if not args or not VIDEO_ID_RE.match(args[0]):
        fail("targets needs a video id")
    video_id = args[0]
    browser = check_browser(opt(args, "--browser", "none"))
    session = music_session(browser)
    result = music_api("playlist/get_add_to_playlist",
                       {"videoIds": [video_id], "excludeWatchLater": True}, session, "targets")
    items = parse_add_targets(result)
    if items is None:
        log_api_error("playlist/get_add_to_playlist", 200, "UNEXPECTED_SHAPE", "")
        fail("Couldn't read your playlists from YouTube Music")
    emit({"type": "targets", "videoId": video_id, "items": items})


def parse_add_targets(result):
    """[{id, title, contains}] from a get_add_to_playlist response, or None
    when it doesn't look like YouTube's add-to-playlist dialog at all."""
    items, seen = [], set()
    for option in find_renderers(result, "playlistAddToOptionRenderer", []):
        pid = option.get("playlistId") or ""
        if pid.startswith("VL"):
            pid = pid[2:]
        if not PLAYLIST_ID_RE.match(pid) or pid in seen or pid == "LM" or pid.startswith("RD"):
            continue
        seen.add(pid)
        items.append({
            "id": pid,
            "title": clean_text(text_of(option.get("title"))) or pid,
            "contains": option.get("containsSelectedVideos") == "ALL",
        })
    if not items and not find_renderers(result, "addToPlaylistRenderer", []):
        return None
    return items


SIGNIN_URL = "https://accounts.google.com/ServiceLogin?service=youtube&continue=https%3A%2F%2Fmusic.youtube.com%2F"
BROWSER_COMMANDS = {
    "chromium": ["chromium"],
    "brave": ["brave", "brave-browser"],
    "chrome": ["google-chrome-stable", "google-chrome"],
    "vivaldi": ["vivaldi-stable", "vivaldi"],
    "edge": ["microsoft-edge-stable", "microsoft-edge"],
    "opera": ["opera"],
    "whale": ["naver-whale-stable", "whale"],
}
FIREFOX_FORKS = [("zen", ["zen-browser", "zen"]), ("librewolf", ["librewolf"]),
                 ("floorp", ["floorp"]), ("waterfox", ["waterfox"])]


def browser_command(browser):
    """The program for the browser the cookies come from: the user has to
    sign in *there*. A Firefox fork is told apart by its profile folder."""
    import shutil
    name, _keyring, profile = browser_parts(browser)
    candidates = list(BROWSER_COMMANDS.get(name, []))
    if name == "firefox":
        lowered = (profile or "").lower()
        for marker, commands in FIREFOX_FORKS:
            if marker in lowered:
                candidates += commands
        candidates.append("firefox")
    for candidate in candidates:
        path = shutil.which(candidate)
        if path:
            return [path]
    return [shutil.which("xdg-open") or "xdg-open"]


def cmd_signin(args):
    """Open YouTube's sign-in page (fixed URL) in the cookies' browser."""
    browser = check_browser(opt(args, "--browser", "none"))
    command = browser_command(browser) if browser != "none" else [shutil_which("xdg-open")]
    try:
        with open(os.devnull, "rb") as devnull_in, open(os.devnull, "wb") as devnull_out:
            subprocess.Popen(command + [SIGNIN_URL], stdin=devnull_in, stdout=devnull_out,
                             stderr=devnull_out, start_new_session=True, close_fds=True)
    except OSError as exc:
        fail(f"Couldn't open the browser: {exc}")
    emit({"type": "signin", "browser": os.path.basename(command[0])})


def shutil_which(name):
    import shutil
    return shutil.which(name) or name


def cmd_liked(_args):
    cached = read_json(tracks_cache_path("LM", "none"))
    items = cached.get("items") if isinstance(cached, dict) else None
    ids = [t["id"] for t in playable(items)]
    emit({"type": "likedIds", "known": isinstance(items, list), "ids": ids[:MAX_TRACKS]})


# ---- explore: new releases, trending, charts, moods, search ---------------------

EXPLORE_PATH = os.path.join(CACHE_DIR, "explore.json")
EXPLORE_MAX_AGE = 6 * 3600
EXPLORE_ITEMS = 30
PARAMS_RE = re.compile(r"^[A-Za-z0-9_%=-]{1,400}$")
# YouTube Music's "Songs" filter for search.
SONGS_FILTER = "EgWKAQIIAWoKEAkQBRAKEAMQBA%3D%3D"
DURATION_RE = re.compile(r"^(?:(\d+):)?(\d{1,2}):(\d{2})$")


def music_public(endpoint, body):
    """YouTube Music's web API without an account: Explore is the same for
    everyone (in the user's region), so no cookies are read or sent."""
    payload = {"context": {"client": {"clientName": "WEB_REMIX", "clientVersion": music_client_version(), "hl": "en"}}, **body}
    request = urllib.request.Request(f"{MUSIC_ORIGIN}/youtubei/v1/{endpoint}?prettyPrint=false",
                                     data=json.dumps(payload).encode(),
                                     headers={"Content-Type": "application/json", "Origin": MUSIC_ORIGIN,
                                              "User-Agent": MIRROR_UA})
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            raw = response.read(MAX_API_RESPONSE + 1)
    except (OSError, ValueError) as exc:
        raise RuntimeError(f"YouTube Music didn't answer: {exc}")
    if len(raw) > MAX_API_RESPONSE:
        raise RuntimeError("YouTube Music's answer was too large")
    try:
        return json.loads(raw)
    except ValueError:
        raise RuntimeError("YouTube Music sent something unexpected")


def first_value(node, key, test=None, depth=0):
    """The first `key` value anywhere under `node` that passes `test`."""
    if depth > 30:
        return None
    if isinstance(node, dict):
        for k, v in node.items():
            if k == key and (test is None or test(v)):
                return v
            found = first_value(v, key, test, depth + 1)
            if found is not None:
                return found
    elif isinstance(node, list):
        for v in node:
            found = first_value(v, key, test, depth + 1)
            if found is not None:
                return found
    return None


def parse_duration(text):
    m = DURATION_RE.match((text or "").strip())
    if not m:
        return None
    return int(m.group(1) or 0) * 3600 + int(m.group(2)) * 60 + int(m.group(3))


EXPLORE_THUMB_RE = re.compile(r"^https://(?:(?:lh3|yt3)\.googleusercontent\.com|yt3\.ggpht\.com|i[0-9]?\.ytimg\.com)/[A-Za-z0-9_./=%~&?-]{1,500}$")


def explore_thumb(renderer):
    """The biggest thumbnail of an Explore entry, at about 400 px."""
    thumbs = first_value(renderer, "thumbnails", lambda v: isinstance(v, list) and v)
    for t in reversed(thumbs or []):
        url = t.get("url") if isinstance(t, dict) else None
        if isinstance(url, str) and EXPLORE_THUMB_RE.match(url):
            return re.sub(r"=w\d+-h\d+", "=w400-h400", url)
    return None


def explore_item(node):
    """One Explore entry, normalized: a song (plays), a list (opens as a
    playlist: an album, a chart, a mood's playlist) or a mood (opens its
    playlists). None for anything else."""
    if "musicNavigationButtonRenderer" in node:
        r = node["musicNavigationButtonRenderer"]
        ep = (r.get("clickCommand") or {}).get("browseEndpoint") or {}
        params = ep.get("params") or ""
        if ep.get("browseId") == "FEmusic_moods_and_genres_category" and PARAMS_RE.match(params):
            return {"kind": "mood", "id": params, "title": clean_text(text_of(r.get("buttonText")), 80), "subtitle": ""}
        return None
    if "musicResponsiveListItemRenderer" in node:
        r = node["musicResponsiveListItemRenderer"]
        cols = [text_of((c.get("musicResponsiveListItemFlexColumnRenderer") or {}).get("text"))
                for c in r.get("flexColumns") or [] if isinstance(c, dict)]
        vid = (r.get("playlistItemData") or {}).get("videoId") or first_value(r, "videoId", lambda v: isinstance(v, str))
        if not vid or not VIDEO_ID_RE.match(vid) or not cols:
            return None
        meta = [p.strip() for p in (cols[1] if len(cols) > 1 else "").split("•")]
        duration = next((parse_duration(p) for p in reversed(meta) if parse_duration(p)), None)
        artist = meta[0] if meta and meta[0].lower() not in ("song", "video") else (meta[1] if len(meta) > 1 else "")
        return {"kind": "song", "id": vid, "title": clean_text(cols[0]), "artist": clean_text(artist, 120),
                "duration": duration}
    if "musicTwoRowItemRenderer" in node:
        r = node["musicTwoRowItemRenderer"]
        title = clean_text(text_of(r.get("title")))
        subtitle = clean_text(text_of(r.get("subtitle")), 120)
        nav = r.get("navigationEndpoint") or {}
        vid = (nav.get("watchEndpoint") or {}).get("videoId")
        if vid and VIDEO_ID_RE.match(vid):
            return {"kind": "song", "id": vid, "title": title, "artist": subtitle.split("•")[0].strip(), "duration": None}
        browse = (nav.get("browseEndpoint") or {}).get("browseId") or ""
        # An album opens through its playlist (OLAK5uy_…), which yt-dlp reads.
        list_id = first_value(r, "playlistId", lambda v: isinstance(v, str) and PLAYLIST_ID_RE.match(v) is not None)
        if not list_id and browse.startswith("VL") and PLAYLIST_ID_RE.match(browse[2:]):
            list_id = browse[2:]
        if list_id:
            item = {"kind": "list", "id": list_id, "title": title, "subtitle": subtitle}
            if explore_thumb(r):
                item["cover"] = explore_thumb(r)
            return item
    return None


def explore_shelves(data):
    """(title, items) for each carousel and grid in a browse response."""
    out = []
    for shelf in find_renderers(data, "musicCarouselShelfRenderer", []):
        header = ((shelf.get("header") or {}).get("musicCarouselShelfBasicHeaderRenderer") or {})
        items = [i for i in (explore_item(n) for n in shelf.get("contents") or [] if isinstance(n, dict)) if i]
        if items:
            out.append((clean_text(text_of(header.get("title")), 80), items[:EXPLORE_ITEMS]))
    for grid in find_renderers(data, "gridRenderer", []):
        header = ((grid.get("header") or {}).get("gridHeaderRenderer") or {})
        items = [i for i in (explore_item(n) for n in grid.get("items") or [] if isinstance(n, dict)) if i]
        if items:
            out.append((clean_text(text_of(header.get("title")), 80), items[:EXPLORE_ITEMS]))
    return out


def fetch_explore():
    sections = []
    for title, items in explore_shelves(music_public("browse", {"browseId": "FEmusic_explore"})):
        sections.append({"title": title, "items": items})
    try:
        charts = explore_shelves(music_public("browse", {"browseId": "FEmusic_charts"}))
    except RuntimeError:
        charts = []
    for title, items in charts:
        lists = [i for i in items if i["kind"] == "list"]
        if lists:
            sections.append({"title": title or "Charts", "items": lists})
    if not sections:
        raise RuntimeError("Explore is empty")
    return {"sections": sections[:10]}


def cmd_explore(args):
    max_age = int(opt(args, "--max-age", str(EXPLORE_MAX_AGE)))
    cached = read_json(EXPLORE_PATH)
    if isinstance(cached, dict) and cached.get("sections"):
        stale = time.time() - float(cached.get("fetchedAt") or 0) > max_age
        emit({"type": "explore", "stale": stale, "sections": cached["sections"]})
        if not stale:
            return
    try:
        result = fetch_explore()
    except RuntimeError as exc:
        if isinstance(cached, dict) and cached.get("sections"):
            return                    # the saved copy is already shown
        fail(str(exc))
    result["fetchedAt"] = int(time.time())
    write_json_atomic(EXPLORE_PATH, result)
    emit({"type": "explore", "stale": False, "sections": result["sections"]})


def cmd_mood(args):
    """A mood or genre's playlists."""
    if not args or not PARAMS_RE.match(args[0]):
        fail("mood needs its id")
    try:
        shelves = explore_shelves(music_public("browse", {"browseId": "FEmusic_moods_and_genres_category", "params": args[0]}))
    except RuntimeError as exc:
        fail(str(exc))
    sections = [{"title": t, "items": [i for i in items if i["kind"] == "list"]} for t, items in shelves]
    emit({"type": "explore", "stale": False, "mood": args[0], "sections": [s for s in sections if s["items"]][:10]})


def cmd_search(args):
    """Songs matching a query: on YouTube Music, or with --service sc on
    SoundCloud (kept as the list "sc:search", so a result plays with the
    others after it)."""
    query = clean_text(" ".join(args[:1]), 150).strip()
    if not query:
        fail("search needs a query")
    if opt(args, "--service", "yt") == "rd":
        try:
            stations = radio_search(query)
        except RuntimeError as exc:
            fail(str(exc))
        emit({"type": "search", "query": query, "service": "rd", "items": [dict(t, kind="song") for t in stations[:60]]})
        return
    if opt(args, "--service", "yt") == "sc":
        try:
            data = run_ytdlp(f"scsearch30:{query}", check_browser(opt(args, "--browser", "none")))
        except RuntimeError as exc:
            fail(str(exc))
        songs = [dict(t, kind="song") for t in sc_items(data)]
        write_json_atomic(tracks_cache_path("sc:search", "none"),
                          {"title": f"SoundCloud: {query}", "items": songs, "fetchedAt": int(time.time())})
        emit({"type": "search", "query": query, "service": "sc", "items": songs[:50]})
        return
    try:
        data = music_public("search", {"query": query, "params": SONGS_FILTER})
    except RuntimeError as exc:
        fail(str(exc))
    songs = [i for i in (explore_item({"musicResponsiveListItemRenderer": r})
                         for r in find_renderers(data, "musicResponsiveListItemRenderer", [])) if i]
    emit({"type": "search", "query": query, "items": songs[:50]})


# ---- download a song --------------------------------------------------------------

# Songs saved with `download`: a list of {id, title, artist, duration,
# path, format, cover, at}. "Downloads" in the panel plays them from disk.
DOWNLOADS_ID = "DOWNLOADS"
DOWNLOADS_PATH = os.path.join(CACHE_DIR, "downloads.json")
COVERS_DIR = os.path.join(CACHE_DIR, "covers")


def downloaded_tracks():
    """Downloaded songs whose files are still there, newest first."""
    data = read_json(DOWNLOADS_PATH)
    out = []
    for t in data.get("items") if isinstance(data, dict) and isinstance(data.get("items"), list) else []:
        if not isinstance(t, dict) or not TRACK_KEY_RE.match(str(t.get("id", ""))):
            continue
        path = t.get("path")
        if not (isinstance(path, str) and os.path.isabs(path) and os.path.isfile(path)):
            continue
        cover = t.get("cover")
        if not (isinstance(cover, str) and os.path.dirname(cover) == COVERS_DIR and os.path.isfile(cover)):
            cover = None
        out.append({"id": t["id"], "title": clean_text(t.get("title")) or t["id"], "artist": clean_text(t.get("artist")),
                    "duration": t.get("duration") if isinstance(t.get("duration"), int) else None,
                    "path": path, "cover": cover})
    return out


def record_download(entry):
    data = read_json(DOWNLOADS_PATH)
    items = data.get("items") if isinstance(data, dict) and isinstance(data.get("items"), list) else []
    items = [t for t in items if isinstance(t, dict) and t.get("path") != entry["path"]]
    write_json_atomic(DOWNLOADS_PATH, {"items": [entry] + items[:4999]})


def file_duration(path):
    try:
        proc = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", path],
                              capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
        seconds = float(proc.stdout.strip())
        return int(seconds) if 0 < seconds < 86400 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


DOWNLOAD_FORMATS = {
    # extension, ffmpeg audio options, can carry a cover picture
    "mp3": ("mp3", ["-c:a", "libmp3lame", "-q:a", "0", "-id3v2_version", "3"], True),
    "m4a": ("m4a", ["-c:a", "aac", "-b:a", "256k"], True),
    "opus": ("opus", ["-c:a", "libopus", "-b:a", "160k"], False),
    "flac": ("flac", ["-c:a", "flac"], True),
    "wav": ("wav", ["-c:a", "pcm_s16le"], False),
}


def safe_filename(text):
    name = re.sub(r"[\x00-\x1f/\\]+", " ", text or "").strip().lstrip(".")
    name = re.sub(r"\s+", " ", name)
    while len(name.encode()) > 180:
        name = name[:-1]
    return name or "song"


def cover_urls(key):
    """Where a song's cover comes from (never with cookies): YouTube's
    thumbnail, Spotify's album image, SoundCloud's artwork."""
    if key.startswith("sp:"):
        known = (read_json(SP_TRACKS_PATH) or {}).get(key) or {}
        urls = [known["cover"]] if isinstance(known.get("cover"), str) else []
        try:
            vid = resolve_spotify(key)
            urls += [f"https://i.ytimg.com/vi/{vid}/{s}.jpg" for s in ("maxresdefault", "hqdefault")]
        except RuntimeError:
            pass
        return urls
    if key.startswith("sc:"):
        meta = audio_meta(key) or {}
        thumb = meta.get("thumbnail")
        return [thumb.replace("-large.", "-t500x500.")] if isinstance(thumb, str) else []
    return [f"https://i.ytimg.com/vi/{key}/{s}.jpg" for s in ("maxresdefault", "hqdefault")]


def fetch_cover(video_id, path):
    """The song's cover, as a JPEG file for embedding and for Downloads."""
    if video_id.startswith("cl:"):
        # The folder's own cover image, made a JPEG if it isn't one.
        src = cloud_cover_of(video_id)
        if not src:
            return False
        if src.endswith(".jpg"):
            shutil.copyfile(src, path)
            return True
        try:
            proc = subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", src, "-frames:v", "1", path],
                                  capture_output=True, timeout=60, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            return False
        return proc.returncode == 0 and os.path.isfile(path)
    for url in cover_urls(video_id):
        try:
            body, response = http_get(url, 5 * 1024 * 1024, timeout=15, accept="image/jpeg")
        except Exception:
            continue
        if response.headers.get_content_type() == "image/jpeg" and body[:3] == b"\xff\xd8\xff":
            with open(path, "wb") as fh:
                fh.write(body)
            return True
    return False


def cmd_download(args):
    """Save a song as an audio file in a folder the user picked: the same
    download path as playback's backup sources (cache, YouTube's clients,
    mirrors if on), then converted by ffmpeg with its title, artist and
    cover embedded."""
    if not args or not TRACK_KEY_RE.match(args[0]):
        fail("download needs a track")
    video_id = args[0]
    if video_id.startswith("rd:"):
        fail("A radio station is live: there is no song to download")
    fmt = opt(args, "--format", "mp3")
    if fmt not in DOWNLOAD_FORMATS:
        fail("--format must be one of " + ", ".join(DOWNLOAD_FORMATS))
    folder = os.path.realpath(os.path.expanduser(opt(args, "--dir", "~/Music")))
    if not os.path.isdir(folder) or not os.access(folder, os.W_OK):
        fail(f"Can't save to {folder}")
    want_cover = opt(args, "--cover", "1") == "1"
    title = clean_text(opt(args, "--title", ""), 200) or video_id
    artist = clean_text(opt(args, "--artist", ""), 200)
    options = player_options(args)
    cookie_opts = {}
    if options["playback_cookies"] and options["browser"] != "none":
        cookie_opts = {"cookiesfrombrowser": browser_spec_tuple(options["browser"])}

    emit({"type": "downloading", "id": video_id, "stage": "fetch"})
    meta = audio_meta(video_id)
    if meta is None:
        try:
            meta, _ = download_audio(video_id, cookie_opts)
        except RuntimeError as exc:
            reason = str(exc)
            if not (mirrors_enabled() and not HOPELESS_RE.search(reason)):
                fail(reason)
            try:
                meta, _ = download_from_mirrors(video_id)
            except RuntimeError as mirror_exc:
                fail(f"{reason}; mirrors: {mirror_exc}")
    source = os.path.join(MIX_DIR, meta["audio"])

    emit({"type": "downloading", "id": video_id, "stage": "convert"})
    ext, codec, takes_cover = DOWNLOAD_FORMATS[fmt]
    base = safe_filename(f"{artist} - {title}" if artist else title)
    target = os.path.join(folder, f"{base}.{ext}")
    n = 2
    while os.path.exists(target):
        target = os.path.join(folder, f"{base} ({n}).{ext}")
        n += 1
    # With a cover: embedded where the format can carry one, and kept for
    # the Downloads list either way.
    os.makedirs(COVERS_DIR, mode=0o700, exist_ok=True)
    cover = os.path.join(COVERS_DIR, f"{re.sub(r'[^A-Za-z0-9_-]', '_', video_id)[:60]}.jpg")
    got_cover = want_cover and (os.path.isfile(cover) or fetch_cover(video_id, cover))
    has_cover = takes_cover and got_cover
    cmd = ["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", source]
    if has_cover:
        cmd += ["-i", cover, "-map", "0:a", "-map", "1:v", "-c:v", "copy", "-disposition:v:0", "attached_pic",
                "-metadata:s:v", "title=Album cover", "-metadata:s:v", "comment=Cover (front)"]
    else:
        cmd += ["-map", "0:a"]
    cmd += codec + ["-metadata", f"title={title}"]
    if artist:
        cmd += ["-metadata", f"artist={artist}"]
    if not video_id.startswith("cl:"):
        cmd += ["-metadata", f"comment={track_url({'id': video_id}) if not video_id.startswith('sp:') else 'https://open.spotify.com/track/' + video_id[3:]}"]
    tmp = os.path.join(folder, f".{base}.{ext}.part")
    cmd += ["-f", {"m4a": "mp4", "opus": "ogg"}.get(fmt, fmt), tmp]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=600, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        proc = None
    if proc is None or proc.returncode != 0:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        fail("ffmpeg couldn't convert the song" + (f": {proc.stderr.strip()[-160:]}" if proc else ""))
    os.replace(tmp, target)
    record_download({"id": video_id, "title": title, "artist": artist, "duration": file_duration(target),
                     "path": target, "format": fmt, "cover": cover if got_cover else None, "at": int(time.time())})
    emit({"type": "downloaded", "id": video_id, "path": target, "folder": folder})


# ---- cloud storage (rclone) -------------------------------------------------------
# Music folders in your own storage: S3 (and anything S3-compatible: R2, B2,
# MinIO, Wasabi …), Google Drive, Dropbox, OneDrive, SFTP, SMB, WebDAV, FTP,
# or any remote already set up in rclone. rclone does the talking; this
# helper keeps a list of "sources" (a remote and a folder in it), indexes
# their audio files, and serves them to mpv through one read-only
# `rclone serve http` on 127.0.0.1 that only this user can open (random
# credentials, passed in the environment, never on a command line).
#
# A source's songs are "cl:<source>/<hash of the file's path>"; its lists
# are "cl:<source>" (every song) and "cl:<source>:<hash of a folder>" (one
# folder, usually an album). mpv gets ytmusic-cloud://<source>/<hash>, which
# mpv/ytmusic.lua resolves here to the server's URL for the file.

CLOUD_PATH = os.path.join(DATA_DIR, "cloud.json")
CLOUD_DIR = os.path.join(CACHE_DIR, "cloud")
CLOUD_SERVER_PATH = os.path.join(RUNTIME_DIR, "cloud-server.json")
CLOUD_LOG = os.path.join(CACHE_DIR, "rclone.log")
CLOUD_SCHEME = "ytmusic-cloud://"
CLOUD_SRC_RE = re.compile(r"^[a-f0-9]{8}$")
CLOUD_KEY_RE = re.compile(r"^cl:([a-f0-9]{8})/([a-f0-9]{16})$")
CLOUD_LIST_RE = re.compile(r"^cl:([a-f0-9]{8})(?::([a-f0-9]{16}))?$")
REMOTE_NAME_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$")
CLOUD_MAX_FILES = 20000
CLOUD_MAX_COVERS = 400
CLOUD_LIST_TIMEOUT = 600
CLOUD_MIN_AGE = 6 * 3600          # a listing is reused this long unless refreshed
CLOUD_AUDIO = ("mp3", "flac", "m4a", "aac", "ogg", "oga", "opus", "wav", "aiff", "aif", "wma", "ape", "wv", "mka", "alac", "webm")
CLOUD_COVER_NAMES = ("cover", "folder", "front", "album", "albumart", "artwork")
CLOUD_COVER_EXT = ("jpg", "jpeg", "png")

# What the panel's "Connect storage" form asks for, per kind, and how it
# becomes an rclone remote. "obscure": stored the way rclone stores passwords.
CLOUD_KINDS = {
    "s3": {"type": "s3", "fields": ("endpoint", "region", "access_key_id", "secret_access_key"),
           "required": ("access_key_id", "secret_access_key")},
    "sftp": {"type": "sftp", "fields": ("host", "port", "user", "pass"), "obscure": ("pass",), "required": ("host",)},
    "smb": {"type": "smb", "fields": ("host", "user", "pass", "domain"), "obscure": ("pass",), "required": ("host",)},
    "webdav": {"type": "webdav", "fields": ("url", "user", "pass"), "obscure": ("pass",), "required": ("url",),
               "fixed": {"vendor": "other"}},
    "ftp": {"type": "ftp", "fields": ("host", "port", "user", "pass"), "obscure": ("pass",), "required": ("host",)},
    "drive": {"type": "drive", "oauth": True, "fixed": {"scope": "drive.readonly"}},
    "dropbox": {"type": "dropbox", "oauth": True},
    "onedrive": {"type": "onedrive", "oauth": True},
}
CLOUD_KIND_NAMES = {"local": "This computer", "subsonic": "Subsonic", "jellyfin": "Jellyfin", "plex": "Plex", "s3": "S3", "sftp": "SFTP", "smb": "SMB", "webdav": "WebDAV", "ftp": "FTP",
                    "drive": "Google Drive", "dropbox": "Dropbox", "onedrive": "OneDrive", "remote": "rclone"}
FIELD_RE = {
    "host": re.compile(r"^[A-Za-z0-9.:\[\]_-]{1,253}$"),
    "port": re.compile(r"^[0-9]{1,5}$"),
    "url": re.compile(r"^https?://[^\s\"']{1,500}$"),
    "endpoint": re.compile(r"^(?:https?://)?[A-Za-z0-9.:\[\]_/-]{1,300}$"),
    "region": re.compile(r"^[A-Za-z0-9_-]{1,64}$"),
}


def rclone_available():
    return shutil_which("rclone") is not None


def rclone(*args, timeout=60, env=None, stdin_text=None):
    try:
        return subprocess.run(["rclone", *args], capture_output=True, text=True, timeout=timeout,
                              env=env, input=stdin_text, stdin=None if stdin_text is not None else subprocess.DEVNULL)
    except FileNotFoundError:
        raise RuntimeError("rclone isn't installed (omarchy pkg add rclone)")
    except subprocess.TimeoutExpired:
        raise RuntimeError("rclone took too long")


def rclone_error(proc):
    """rclone's last error, without its log prefix and wrapping."""
    lines = [l for l in (proc.stderr or "").splitlines() if l.strip()]
    text = next((l for l in reversed(lines) if "ERROR" in l or "CRITICAL" in l or "Failed" in l),
                lines[-1] if lines else f"rclone exited with {proc.returncode}")
    text = re.sub(r"^\S+ \S+ (?:ERROR|CRITICAL|NOTICE)\s*:\s*(?:[^:]*: )??", "", text)
    text = re.sub(r"^.*?last error was:\s*", "", text)
    text = re.sub(r"^Failed to \w+:\s*", "", text)
    text = re.sub(r"^(?:error in \w+: )?(?:couldn't list files: )?", "", text)
    text = re.sub(r"^.*\bapi error \w+:\s*", "", text)          # S3's wrapping
    # "401 Unauthorized: 401 Unauthorized" -> once.
    half = text.split(": ")
    if len(half) == 2 and half[0] == half[1]:
        text = half[0]
    return text.strip()[:300]


def read_cloud():
    data = read_json(CLOUD_PATH)
    items = data.get("sources") if isinstance(data, dict) and isinstance(data.get("sources"), list) else []
    out = []
    for s in items:
        local = isinstance(s, dict) and s.get("remote") == "" and isinstance(s.get("path"), str) and (
            (s.get("kind") == "local" and os.path.isabs(s["path"]))
            or (s.get("kind") in SERVER_KINDS and SERVER_URL_RE.match(s["path"]) is not None))
        if (isinstance(s, dict) and CLOUD_SRC_RE.match(str(s.get("id", "")))
                and (local or REMOTE_NAME_RE.match(str(s.get("remote", "")))) and isinstance(s.get("path", ""), str)):
            out.append({"id": s["id"], "remote": s["remote"], "path": s.get("path", ""), "kind": str(s.get("kind", "remote")),
                        "title": clean_text(s.get("title"), 80) or s["remote"], "created": s.get("created") is True})
    return out


def write_cloud(sources):
    os.makedirs(DATA_DIR, mode=0o700, exist_ok=True)
    write_json_atomic(CLOUD_PATH, {"sources": sources})
    os.chmod(CLOUD_PATH, 0o600)


def cloud_source(src_id):
    return next((s for s in read_cloud() if s["id"] == src_id), None)


def clean_cloud_path(value):
    # A leading slash stays: on SFTP or a local remote it means "from the root".
    path = str(value or "").strip()
    path = path.rstrip("/") if path != "/" else path
    if len(path) > 300 or re.search(r"[\x00-\x1f\x7f\"]", path) or ".." in path.split("/"):
        raise RuntimeError("That folder path isn't usable")
    return path


def rclone_config_file():
    proc = rclone("config", "file", timeout=20)
    lines = [l.strip() for l in proc.stdout.splitlines() if l.strip()]
    if proc.returncode != 0 or not lines or not os.path.isabs(lines[-1]):
        raise RuntimeError("couldn't find rclone's config file")
    return lines[-1]


def rclone_remotes():
    """[{name, type}] for each remote in rclone's config."""
    proc = rclone("listremotes", "--long", "--json", timeout=20)
    data = None
    if proc.returncode == 0:
        try:
            data = json.loads(proc.stdout or "[]")
        except ValueError:
            data = None
    if not isinstance(data, list):
        # rclone before 1.66 has no --json: "name:   type" per line.
        proc = rclone("listremotes", "--long", timeout=20)
        if proc.returncode != 0:
            raise RuntimeError(rclone_error(proc))
        data = []
        for line in proc.stdout.splitlines():
            m = re.match(r"^([^:\s][^:]*):\s+(\S+)", line)
            if m:
                data.append({"name": m.group(1), "type": m.group(2)})
    return [{"name": r["name"], "type": clean_text(r.get("type"), 40)} for r in data
            if isinstance(r, dict) and REMOTE_NAME_RE.match(str(r.get("name", "")))]


def new_remote_name(kind, existing):
    base = "omarchy-music-" + kind
    name, n = base, 2
    while name in existing:
        name, n = f"{base}-{n}", n + 1
    return name


def write_remote(name, kind, fields):
    """Add a remote for a password or key kind to rclone's config: appended
    as text (never through a command line, where other users could read the
    secrets), with passwords obscured the way rclone stores them."""
    spec = CLOUD_KINDS[kind]
    values = dict(spec.get("fixed", {}))
    for key in spec["fields"]:
        value = str(fields.get(key) or "").strip()
        if not value:
            continue
        if re.search(r"[\x00-\x1f\x7f]", value) or len(value) > 500:
            raise RuntimeError(f"{key} isn't usable")
        if key in FIELD_RE and not FIELD_RE[key].match(value):
            raise RuntimeError(f"{key} doesn't look right")
        if key in spec.get("obscure", ()):
            proc = rclone("obscure", "-", stdin_text=value + "\n", timeout=20)
            if proc.returncode != 0 or not proc.stdout.strip():
                raise RuntimeError("rclone couldn't store the password")
            value = proc.stdout.strip()
        values[key] = value
    for key in spec.get("required", ()):
        if key not in values:
            raise RuntimeError(f"{key.replace('_', ' ')} is needed")
    if kind == "s3":
        values["provider"] = "Other" if values.get("endpoint") else "AWS"
        values["env_auth"] = "false"
    if kind == "sftp" and "pass" not in values:
        # No password: the usual SSH key (rclone also asks ssh-agent).
        for key_name in ("id_ed25519", "id_ecdsa", "id_rsa"):
            key_file = os.path.join(HOME, ".ssh", key_name)
            if os.path.isfile(key_file):
                values["key_file"] = key_file
                break
    path = rclone_config_file()
    try:
        with open(path, encoding="utf-8") as fh:
            current = fh.read()
    except FileNotFoundError:
        current = ""
    if current.lstrip().startswith("# Encrypted rclone configuration"):
        raise RuntimeError("rclone's config is encrypted: add the remote with `rclone config` and pick it here")
    section = f"\n[{name}]\ntype = {spec['type']}\n" + "".join(f"{k} = {v}\n" for k, v in values.items())
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as fh:
        if current and not current.endswith("\n"):
            fh.write("\n")
        fh.write(section)


def delete_remote(name):
    try:
        rclone("config", "delete", name, timeout=20)
    except RuntimeError:
        pass


def cmd_cloud(args):
    """cloud: the sources and the remotes rclone already knows."""
    sources = [{"id": s["id"], "title": s["title"], "kind": s["kind"], "remote": s["remote"], "path": s["path"]}
               for s in read_cloud()]
    # The Music folder, offered when it's there and not added yet.
    music = os.path.join(HOME, "Music")
    extra = {"musicDir": music} if os.path.isdir(music) and not any(
        s["kind"] == "local" and os.path.realpath(s["path"]) == os.path.realpath(music) for s in sources) else {}
    if not rclone_available():
        emit({"type": "cloud", "state": "list", "rclone": False, "sources": sources, "remotes": [], **extra})
        return
    try:
        remotes = rclone_remotes()
    except RuntimeError:
        remotes = []
    emit({"type": "cloud", "state": "list", "rclone": True, "sources": sources, "remotes": remotes, **extra})


def cmd_cloud_add(args):
    """cloud-add: connect a storage. The form arrives as JSON on stdin:
    {kind, title, path, fields, remote}. kind "remote" uses a remote rclone
    already has; the others create one (in the browser for Google Drive,
    Dropbox and OneDrive). kind "local" is a folder on this computer (no
    rclone needed). The folder is listed once to check it works."""
    try:
        form = json.loads(sys.stdin.readline(64 * 1024) or "{}")
    except ValueError:
        form = None
    if not isinstance(form, dict):
        fail("cloud-add needs the form as JSON on stdin")
    kind = str(form.get("kind") or "")
    if kind == "local":
        add_local_folder(form)
        return
    if kind in SERVER_KINDS:
        add_media_server(kind, form)
        return
    if not rclone_available():
        fail("rclone isn't installed (omarchy pkg add rclone)", setup="rclone")
    fields = form.get("fields") if isinstance(form.get("fields"), dict) else {}
    try:
        path = clean_cloud_path(form.get("path"))
        existing = {r["name"] for r in rclone_remotes()}
    except RuntimeError as exc:
        fail(str(exc))
    created = False
    if kind == "remote":
        name = str(form.get("remote") or "").rstrip(":")
        if name not in existing:
            fail("rclone has no remote by that name")
    elif kind in CLOUD_KINDS:
        name = new_remote_name(kind, existing)
        spec = CLOUD_KINDS[kind]
        if spec.get("oauth"):
            # rclone opens the provider's sign-in page in the browser and
            # waits for the answer on 127.0.0.1.
            emit({"type": "cloud", "state": "waiting", "kind": kind})
            fixed = [f"{k}={v}" for k, v in spec.get("fixed", {}).items()]
            try:
                proc = rclone("config", "create", name, spec["type"], *fixed, timeout=300)
            except RuntimeError as exc:
                delete_remote(name)
                fail("sign-in didn't finish: " + str(exc))
            if proc.returncode != 0:
                delete_remote(name)
                fail("sign-in didn't finish: " + rclone_error(proc))
        else:
            try:
                write_remote(name, kind, fields)
            except RuntimeError as exc:
                fail(str(exc))
        created = True
    else:
        fail("Pick a kind of storage")
    emit({"type": "cloud", "state": "checking"})
    try:
        proc = rclone("lsf", "--max-depth", "1", "--low-level-retries", "2", "--retries", "1",
                      f"{name}:{path}", timeout=90)
        ok, reason = proc.returncode == 0, "" if proc.returncode == 0 else rclone_error(proc)
    except RuntimeError as exc:
        ok, reason = False, str(exc)
    if not ok:
        if created:
            delete_remote(name)
        hint = " (check the user name and password)" if re.search(r"401|403|auth|denied|password|credential|signature", reason, re.I) else ""
        fail(f"Couldn't open the storage: {reason[:200]}{hint}")
    sources = read_cloud()
    src_id = os.urandom(4).hex()
    title = clean_text(form.get("title"), 80) or (path.split("/")[-1] if path else CLOUD_KIND_NAMES.get(kind, name))
    sources.append({"id": src_id, "remote": name, "path": path, "kind": kind, "title": title, "created": created})
    write_cloud(sources)
    stop_cloud_server()           # it serves the old set of sources
    emit({"type": "cloud", "state": "added", "id": src_id, "title": title})


def add_local_folder(form):
    raw = str(form.get("path") or "~/Music").strip() or "~/Music"
    if re.search(r"[\x00-\x1f\x7f]", raw) or len(raw) > 500:
        fail("That folder path isn't usable")
    path = os.path.realpath(os.path.expanduser(raw))
    if not os.path.isdir(path) or not os.access(path, os.R_OK):
        fail(f"There is no folder {raw}")
    sources = read_cloud()
    if any(s["kind"] == "local" and os.path.realpath(s["path"]) == path for s in sources):
        fail("That folder is already in your files")
    src_id = os.urandom(4).hex()
    title = clean_text(form.get("title"), 80) or os.path.basename(path) or path
    sources.append({"id": src_id, "remote": "", "path": path, "kind": "local", "title": title, "created": False})
    write_cloud(sources)
    emit({"type": "cloud", "state": "added", "id": src_id, "title": title})


def cmd_cloud_remove(args):
    """cloud-remove <source>: forget a source (and the remote, if this
    plugin made it). Files in the storage are never touched."""
    src = cloud_source(args[0] if args else "")
    if not src:
        fail("No such storage")
    write_cloud([s for s in read_cloud() if s["id"] != src["id"]])
    if src["kind"] in SERVER_KINDS:
        save_server_secret(src["id"], None)
    if src["created"] and src["remote"] and not any(s["remote"] == src["remote"] for s in read_cloud()):
        delete_remote(src["remote"])
    for path in (os.path.join(CLOUD_DIR, f"{src['id']}.json"),):
        try:
            os.unlink(path)
        except OSError:
            pass
    stop_cloud_server()
    emit({"type": "cloud", "state": "removed", "id": src["id"]})


def path_hash(text):
    return hashlib.sha1(text.encode("utf-8", "surrogateescape")).hexdigest()[:16]


def natural_key(text):
    return [int(p) if p.isdigit() else p.lower() for p in re.split(r"(\d+)", text)]


def cloud_names(relpath):
    """(title, artist, album) guessed from where a file is and what it's
    called: "Artist/Album/01 - Title.mp3", "Artist - Title.flac" …"""
    parts = relpath.split("/")
    stem = re.sub(r"[_]+", " ", os.path.splitext(parts[-1])[0]).strip()
    album = parts[-2] if len(parts) >= 2 else ""
    artist = parts[-3] if len(parts) >= 3 else ""
    if " - " in album and not artist:
        artist = album.split(" - ", 1)[0].strip()
    stem = re.sub(r"^\s*(?:\d{1,2}[-.]?)?\d{1,3}(?:\s*[-.)_]\s*|\s+)(?=\S)", "", stem)
    m = re.match(r"^(.+?)\s+[-–]\s+(.+)$", stem)
    title = stem
    if m and not m.group(1).isdigit():
        artist, title = m.group(1).strip(), m.group(2).strip()
    return clean_text(title, 200) or parts[-1], clean_text(artist, 200), clean_text(album, 200)


def local_entries(root_dir):
    """lsjson-like entries for the audio and cover files under a folder."""
    out = []
    for dirpath, dirnames, filenames in os.walk(root_dir, followlinks=False):
        dirnames[:] = sorted(d for d in dirnames if not d.startswith("."))
        for name in filenames:
            ext = os.path.splitext(name)[1][1:].lower()
            if ext not in CLOUD_AUDIO and ext not in CLOUD_COVER_EXT:
                continue
            full = os.path.join(dirpath, name)
            try:
                st = os.stat(full)
            except OSError:
                continue
            out.append({"Path": os.path.relpath(full, root_dir), "Size": st.st_size,
                        "ModTime": time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(st.st_mtime))})
            if len(out) > CLOUD_MAX_FILES * 2:
                return out
    return out


def fetch_cloud_index(src):
    """Every audio file under a source, and a cover image per folder."""
    if src["kind"] == "local":
        return index_entries(src, local_entries(src["path"]))
    patterns = ["*.{" + ",".join(CLOUD_AUDIO) + "}",
                "{" + ",".join(CLOUD_COVER_NAMES) + "}.{" + ",".join(CLOUD_COVER_EXT) + "}"]
    args = ["lsjson", "-R", "--files-only", "--no-mimetype", "--fast-list", "--ignore-case",
            "--low-level-retries", "3"]
    for p in patterns:
        args += ["--include", p]
    proc = rclone(*args, f"{src['remote']}:{src['path']}", timeout=CLOUD_LIST_TIMEOUT)
    if proc.returncode != 0:
        raise RuntimeError(rclone_error(proc))
    try:
        entries = json.loads(proc.stdout or "[]")
    except ValueError:
        raise RuntimeError("rclone's listing didn't parse")
    return index_entries(src, entries)


def index_entries(src, entries):
    tracks, covers = [], {}
    for e in entries:
        rel = e.get("Path") if isinstance(e, dict) else None
        if not isinstance(rel, str) or not rel or re.search(r"[\x00-\x1f\x7f]", rel):
            continue
        name = rel.rsplit("/", 1)[-1]
        stem, ext = os.path.splitext(name.lower())
        folder = rel.rsplit("/", 1)[0] if "/" in rel else ""
        if ext[1:] in CLOUD_COVER_EXT and stem in CLOUD_COVER_NAMES:
            if not isinstance(e.get("Size"), int) or not 0 < e["Size"] <= 10 * 1024 * 1024:
                continue
            rank = CLOUD_COVER_NAMES.index(stem)
            if folder not in covers or rank < covers[folder][0]:
                covers[folder] = (rank, rel)
            continue
        if ext[1:] not in CLOUD_AUDIO or len(tracks) >= CLOUD_MAX_FILES:
            continue
        title, artist, album = cloud_names(rel)
        mtime = e.get("ModTime") if isinstance(e.get("ModTime"), str) else ""
        size = e.get("Size") if isinstance(e.get("Size"), int) else 0
        tracks.append({"id": f"cl:{src['id']}/{path_hash(rel)}", "rel": rel, "folder": folder, "size": size,
                       "title": title, "artist": artist, "album": album, "mtime": mtime[:19], "duration": None})
    tracks.sort(key=lambda t: natural_key(t["rel"]))
    return {"tracks": tracks, "covers": fetch_cloud_covers(src, {f: c[1] for f, c in covers.items()})}


def cloud_cover_path(src_id, folder, ext):
    return os.path.join(COVERS_DIR, f"cl-{src_id}-{path_hash(folder)}.{ext}")


def fetch_cloud_covers(src, covers):
    """Copy each folder's cover image next to the other covers (one rclone
    run for all of them). Returns {folder: local file}."""
    wanted = {}
    for folder, rel in list(covers.items())[:CLOUD_MAX_COVERS]:
        ext = "png" if rel.lower().endswith(".png") else "jpg"
        local = cloud_cover_path(src["id"], folder, ext)
        wanted[folder] = (rel, local)
    missing = [(f, rel, local) for f, (rel, local) in wanted.items() if not os.path.isfile(local)]
    if missing and src["kind"] == "local":
        os.makedirs(COVERS_DIR, mode=0o700, exist_ok=True)
        for _, rel, local in missing:
            try:
                shutil.copyfile(os.path.join(src["path"], rel), local)
            except OSError:
                pass
        missing = []
    if missing:
        os.makedirs(COVERS_DIR, mode=0o700, exist_ok=True)
        tmp = tempfile.mkdtemp(prefix=".fetch-", dir=COVERS_DIR)
        try:
            list_path = os.path.join(tmp, "files.txt")
            with open(list_path, "w", encoding="utf-8") as fh:
                fh.write("".join(rel + "\n" for _, rel, _ in missing))
            rclone("copy", "--files-from-raw", list_path, "--transfers", "8",
                   "--low-level-retries", "2", f"{src['remote']}:{src['path']}", os.path.join(tmp, "out"),
                   timeout=300)
            for _, rel, local in missing:
                got = os.path.join(tmp, "out", rel)
                if os.path.isfile(got):
                    os.replace(got, local)
        except RuntimeError:
            pass
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    return {f: local for f, (rel, local) in wanted.items() if os.path.isfile(local)}


def cloud_index(src, max_age=None):
    """A source's index from the cache, listing it again when missing (or
    older than max_age seconds)."""
    path = os.path.join(CLOUD_DIR, f"{src['id']}.json")
    cached = read_json(path)
    if isinstance(cached, dict) and (isinstance(cached.get("tracks"), list) or isinstance(cached.get("lists"), list)):
        if max_age is None or time.time() - float(cached.get("fetchedAt") or 0) <= max_age:
            return cached
    index = fetch_server_index(src) if src["kind"] in SERVER_KINDS else fetch_cloud_index(src)
    index["fetchedAt"] = int(time.time())
    os.makedirs(CLOUD_DIR, mode=0o700, exist_ok=True)
    write_json_atomic(path, index)
    return index


def cloud_track(t, covers):
    out = {"id": t["id"], "title": t["title"], "artist": t["artist"], "duration": None, "album": t.get("album", "")}
    cover = covers.get(t.get("folder", ""))
    if cover:
        out["cover"] = cover
    return out


def cloud_lists(src, index):
    """A source's lists: all its songs, then each folder that has songs."""
    covers = index.get("covers") or {}
    folders = {}
    for t in index["tracks"]:
        folders.setdefault(t["folder"], []).append(t)
    first_cover = next(iter(covers.values()), None)
    items = [{"id": f"cl:{src['id']}", "title": src["title"], "count": len(index["tracks"]),
              "subtitle": (f"{CLOUD_KIND_NAMES['local']} · {src['path'].replace(HOME, '~', 1)}" if src["kind"] == "local"
                           else f"{CLOUD_KIND_NAMES.get(src['kind'], 'rclone')} · {src['remote']}:{src['path']}".rstrip(":")),
              **({"cover": first_cover} if first_cover else {})}]
    for folder in sorted(folders, key=natural_key):
        if folder == "" and len(folders) == 1:
            continue
        songs = folders[folder]
        artists = {t["artist"] for t in songs if t["artist"]}
        item = {"id": f"cl:{src['id']}:{path_hash(folder)}", "count": len(songs),
                "title": clean_text(folder.rsplit("/", 1)[-1] if folder else src["title"], 120),
                "subtitle": next(iter(artists)) if len(artists) == 1 else ""}
        if covers.get(folder):
            item["cover"] = covers[folder]
        items.append(item)
    return items


def source_lists(src, index):
    return server_lists(src, index) if src["kind"] in SERVER_KINDS else cloud_lists(src, index)


def fetch_cloud_playlists(sources, max_age):
    items, errors = [], []
    for src in sources:
        try:
            items += source_lists(src, cloud_index(src, max_age))
        except RuntimeError as exc:
            errors.append(f"{src['title']}: {exc}")
            items.append({"id": f"cl:{src['id']}", "title": src["title"], "count": None, "subtitle": str(exc)[:120]})
    return {"items": items[:MAX_PLAYLISTS], "errors": errors}


def cloud_tracks(list_id):
    m = CLOUD_LIST_RE.match(list_id)
    src = cloud_source(m.group(1)) if m else None
    if not src:
        raise RuntimeError("That storage isn't connected any more")
    index = cloud_index(src)
    covers = index.get("covers") or {}
    songs = index["tracks"]
    title = src["title"]
    if m.group(2):
        songs = [t for t in songs if path_hash(t["folder"]) == m.group(2)]
        if songs:
            title = songs[0]["folder"].rsplit("/", 1)[-1] or src["title"]
    return {"title": title, "items": [cloud_track(t, covers) for t in songs][:MAX_TRACKS]}


def cloud_file(key):
    """(source, path inside it, size) for a cloud song."""
    m = CLOUD_KEY_RE.match(key or "")
    src = cloud_source(m.group(1)) if m else None
    if not src:
        raise RuntimeError("That storage isn't connected any more")
    index = read_json(os.path.join(CLOUD_DIR, f"{src['id']}.json"))
    for t in (index.get("tracks") if isinstance(index, dict) else None) or []:
        if isinstance(t, dict) and t.get("id") == key and isinstance(t.get("rel"), str):
            return src, t["rel"], t.get("size") if isinstance(t.get("size"), int) else 0
    raise RuntimeError("That song isn't in its folder any more; refresh the list")


def pid_is_rclone_server(pid):
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as fh:
            argv = fh.read().split(b"\0")
    except (OSError, ValueError):
        return False
    return len(argv) > 3 and os.path.basename(argv[0]) == b"rclone" and argv[1:3] == [b"serve", b"http"]


def stop_cloud_server():
    state = read_json(CLOUD_SERVER_PATH)
    pid = state.get("pid") if isinstance(state, dict) else None
    if pid and pid_is_rclone_server(pid):
        try:
            os.kill(int(pid), 15)
        except OSError:
            pass
    try:
        os.unlink(CLOUD_SERVER_PATH)
    except OSError:
        pass


def cloud_upstreams(sources):
    return " ".join(f'"{s["id"]}={s["remote"]}:{s["path"]}"' for s in sources if s["kind"] not in ("local",) + SERVER_KINDS)


def server_answers(state, timeout=2):
    req = urllib.request.Request(f"http://127.0.0.1:{state['port']}/")
    token = f"{state['user']}:{state['pass']}".encode()
    req.add_header("Authorization", "Basic " + base64.b64encode(token).decode())
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            return response.status == 200
    except (OSError, ValueError):
        return False


def cloud_server():
    """The running file server for every source, started if needed:
    {port, user, pass}."""
    sources = read_cloud()
    upstreams = cloud_upstreams(sources)
    state = read_json(CLOUD_SERVER_PATH)
    if (isinstance(state, dict) and state.get("upstreams") == upstreams and state.get("pid")
            and pid_is_rclone_server(state["pid"]) and server_answers(state)):
        return state
    stop_cloud_server()
    if not rclone_available():
        raise RuntimeError("rclone isn't installed (omarchy pkg add rclone)")
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
    state = {"port": port, "user": "u" + os.urandom(6).hex(), "pass": os.urandom(18).hex(), "upstreams": upstreams}
    env = dict(os.environ, RCLONE_CONFIG_OMPCLOUD_TYPE="combine", RCLONE_CONFIG_OMPCLOUD_UPSTREAMS=upstreams,
               RCLONE_USER=state["user"], RCLONE_PASS=state["pass"])
    cmd = ["rclone", "serve", "http", "ompcloud:", "--addr", f"127.0.0.1:{port}", "--read-only",
           "--dir-cache-time", "5m", "--log-file", CLOUD_LOG, "--log-level", "NOTICE"]
    with open(os.devnull, "rb") as devnull_in, open(os.devnull, "wb") as devnull_out:
        proc = subprocess.Popen(cmd, stdin=devnull_in, stdout=devnull_out, stderr=devnull_out, env=env,
                                start_new_session=True, close_fds=True)
    state["pid"] = proc.pid
    fd = os.open(CLOUD_SERVER_PATH + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(state, fh)
    os.replace(CLOUD_SERVER_PATH + ".tmp", CLOUD_SERVER_PATH)
    for _ in range(100):
        if proc.poll() is not None:
            raise RuntimeError(f"rclone's file server stopped (see {CLOUD_LOG})")
        if server_answers(state, timeout=1):
            return state
        time.sleep(0.15)
    raise RuntimeError("rclone's file server didn't start")


def local_file(src, rel):
    """The file on disk for a song in a local folder (never outside it)."""
    root_dir = os.path.realpath(src["path"])
    full = os.path.realpath(os.path.join(root_dir, rel))
    if not full.startswith(root_dir + os.sep) or not os.path.isfile(full):
        raise RuntimeError("That song isn't in its folder any more; refresh the list")
    return full


def cloud_stream_url(key):
    src, rel, _ = cloud_file(key)
    if src["kind"] == "local":
        return local_file(src, rel)
    state = cloud_server()
    return (f"http://{state['user']}:{state['pass']}@127.0.0.1:{state['port']}/"
            f"{src['id']}/{urllib.parse.quote(rel, safe='/')}")


def copy_cloud_audio(key, name):
    """A cloud song copied into the audio cache (for the peak mix and
    downloads): its metadata, like download_audio's."""
    src, rel, size = cloud_file(key)
    ext = os.path.splitext(rel)[1][1:].lower()
    if not re.match(r"^[a-z0-9]{2,5}$", ext):
        raise RuntimeError("unknown audio type")
    if size > 200 * 1024 * 1024:
        raise RuntimeError("the file is too big")
    os.makedirs(MIX_DIR, mode=0o700, exist_ok=True)
    target = os.path.join(MIX_DIR, f"audio-{name}.{ext}")
    if src["kind"] == "local":
        shutil.copyfile(local_file(src, rel), target)
        meta = {"audio": os.path.basename(target), "heatmap": [], "usedAt": int(time.time())}
        write_json_atomic(os.path.join(MIX_DIR, f"{name}.json"), meta)
        return meta
    proc = rclone("copyto", "--low-level-retries", "3",
                  f"{src['remote']}:{src['path'].rstrip('/')}/{rel}" if src["path"] else f"{src['remote']}:{rel}",
                  target, timeout=600)
    if proc.returncode != 0 or not os.path.isfile(target):
        raise RuntimeError(rclone_error(proc) if proc.returncode != 0 else "the file didn't arrive")
    meta = {"audio": os.path.basename(target), "heatmap": [], "usedAt": int(time.time())}
    write_json_atomic(os.path.join(MIX_DIR, f"{name}.json"), meta)
    return meta


def cloud_cover_of(key):
    """The local cover file of a cloud song's folder, if it has one."""
    try:
        src, rel, _ = cloud_file(key)
    except RuntimeError:
        return None
    index = read_json(os.path.join(CLOUD_DIR, f"{src['id']}.json")) or {}
    cover = (index.get("covers") or {}).get(rel.rsplit("/", 1)[0] if "/" in rel else "")
    return cover if isinstance(cover, str) and os.path.isfile(cover) else None


def cmd_cloud_stop(args):
    """cloud-stop [--player PID]: stop the file server; with --player (an
    mpv that is quitting), only if no other player has started since."""
    dying = opt(args, "--player", "")
    running = our_mpv_pid()
    if dying and running and str(running) != dying:
        emit({"type": "cloud", "state": "kept"})
        return
    stop_cloud_server()
    emit({"type": "cloud", "state": "stopped"})


# ---- lyrics --------------------------------------------------------------------
# The full-screen view's Lyrics, like Apple Music's: lines that light up in
# time with the song. They come from LRCLIB (lrclib.net, an open lyrics
# database: synced lines where it has them), asked with the song's title,
# artist and length only; else from YouTube Music's own lyrics (plain text,
# no account). Only fetched when the Lyrics view is open; cached.

LYRICS_DIR = os.path.join(CACHE_DIR, "lyrics")
LYRICS_MISS_AGE = 3 * 86400        # a song with no lyrics is asked again after this
LRCLIB_API = "https://lrclib.net/api"
LRCLIB_UA = "Omarchy Music Player (https://github.com/symonbaikov/omarchy-music-player)"
LRC_TIME_RE = re.compile(r"\[(\d{1,3}):(\d{1,2}(?:[.:]\d{1,3})?)\]")
MAX_LYRIC_LINES = 600
TITLE_NOISE_RE = re.compile(
    r"\s*[\(\[][^\)\]]*\b(official|video|lyrics?|audio|visuali[sz]er|remaster(ed)?|hd|4k|mv|m/v|clip|"
    r"music video|explicit|from|soundtrack|ost)\b[^\)\]]*[\)\]]", re.I)


def parse_lrc(text):
    """[[seconds, line], …] from LRC text, in time order."""
    out = []
    for raw in str(text or "").splitlines():
        stamps = LRC_TIME_RE.findall(raw)
        if not stamps:
            continue
        line = clean_text(LRC_TIME_RE.sub("", raw), 300)
        for m, s in stamps:
            out.append([round(int(m) * 60 + float(s.replace(":", ".")), 2), line])
    out.sort(key=lambda x: x[0])
    return out[:MAX_LYRIC_LINES]


def lyric_names(title, artist):
    """(artist, title) pairs to look a song up by: YouTube titles are often
    "Artist - Title (Official Video) | More", and the artist the channel."""
    title = clean_text(title, 200)
    artist = re.sub(r"\s*-\s*Topic$|VEVO$|\s*\(official\)$", "", clean_text(artist, 200), flags=re.I).strip()
    base = TITLE_NOISE_RE.sub("", title.split(" | ")[0]).strip(" -\"'“”")
    pairs = []
    if " - " in base:
        left, right = [x.strip(" \"'“”") for x in base.split(" - ", 1)]
        pairs.append((left, TITLE_NOISE_RE.sub("", right).strip()))
    pairs.append((artist, base))
    no_feat = re.sub(r"\s+(feat\.?|ft\.?)\s.*$", "", base, flags=re.I)
    if no_feat != base:
        pairs.append((artist, no_feat))
    seen, out = set(), []
    for a, t in pairs:
        if t and (a, t) not in seen:
            seen.add((a, t))
            out.append((a, t))
    return out


def lrclib(path, params):
    url = f"{LRCLIB_API}/{path}?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(url, headers={"User-Agent": LRCLIB_UA, "Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            body = response.read(4 * 1024 * 1024 + 1)
    except (OSError, ValueError):
        return []
    try:
        data = json.loads(body[:4 * 1024 * 1024])
    except ValueError:
        return []
    return data if isinstance(data, list) else []


def best_lyrics(results, artist, title, duration):
    """The LRCLIB entry that is this song: names alike, the same length
    (when known), synced lines preferred."""
    best, best_score = None, 1.5
    for r in results[:20]:
        if not isinstance(r, dict):
            continue
        cand = {"title": r.get("trackName"), "artist": r.get("artistName"),
                "duration": r.get("duration") if isinstance(r.get("duration"), (int, float)) else None}
        score = match_score({"title": title, "artist": artist, "duration": duration or None}, cand)
        if r.get("syncedLyrics"):
            score += 0.5
        if score > best_score:
            best, best_score = r, score
    return best


def lyrics_from_lrclib(title, artist, duration):
    for a, t in lyric_names(title, artist):
        params = {"track_name": t}
        if a:
            params["artist_name"] = a
        hit = best_lyrics(lrclib("search", params), a, t, duration)
        if not hit:
            hit = best_lyrics(lrclib("search", {"q": f"{a} {t}".strip()}), a, t, duration)
        if hit:
            if hit.get("instrumental"):
                return {"instrumental": True, "source": "LRCLIB"}
            synced = parse_lrc(hit.get("syncedLyrics"))
            if synced:
                return {"synced": synced, "source": "LRCLIB"}
            plain = str(hit.get("plainLyrics") or "").strip()
            if plain:
                return {"plain": plain[:20000], "source": "LRCLIB"}
    return None


def lyrics_from_youtube(key):
    """YouTube Music's own lyrics for a song (plain text), without an account."""
    try:
        vid = key if VIDEO_ID_RE.match(key) else (
            (read_json(SP_MATCH_PATH) or {}).get(key[3:]) if key.startswith("sp:") else None)
        if not vid or not VIDEO_ID_RE.match(str(vid)):
            return None
        nxt = music_public("next", {"videoId": vid})
        browse_id = first_value(nxt, "browseId", lambda v: isinstance(v, str) and v.startswith("MPLYt"))
        if not browse_id:
            return None
        shelf = find_renderers(music_public("browse", {"browseId": browse_id}), "musicDescriptionShelfRenderer", [])
    except RuntimeError:
        return None
    if not shelf:
        return None
    plain = text_of(shelf[0].get("description")).strip()
    footer = clean_text(text_of(shelf[0].get("footer")), 80)
    if not plain:
        return None
    return {"plain": plain[:20000], "source": "YouTube Music" + (f" ({footer.replace('Source: ', '')})" if footer else "")}


def cmd_lyrics(args):
    """lyrics <track> [--title T] [--artist A] [--duration S]: the song's
    lyrics, timed where possible."""
    key = args[0] if args else ""
    if not TRACK_KEY_RE.match(key):
        fail("lyrics needs a track")
    title = clean_text(opt(args, "--title", ""), 200)
    artist = clean_text(opt(args, "--artist", ""), 200)
    try:
        duration = max(0, min(86400, float(opt(args, "--duration", "0"))))
    except ValueError:
        duration = 0
    os.makedirs(LYRICS_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(LYRICS_DIR, hashlib.sha1(f"{key}\0{title}".encode()).hexdigest()[:20] + ".json")
    cached = read_json(path)
    if isinstance(cached, dict) and (not cached.get("none") or time.time() - float(cached.get("at") or 0) < LYRICS_MISS_AGE):
        emit({"type": "lyrics", "key": key, **{k: v for k, v in cached.items() if k != "at"}})
        return
    found = lyrics_from_lrclib(title, artist, duration) if title else None
    if not found or (not found.get("synced") and not found.get("instrumental")):
        found = lyrics_from_youtube(key) or found
    result = found or {"none": True}
    result["at"] = int(time.time())
    write_json_atomic(path, result)
    emit({"type": "lyrics", "key": key, **{k: v for k, v in result.items() if k != "at"}})


# ---- notes: chords and scores ---------------------------------------------------
# The player window's Notes, for learning a song: its chords in time with it,
# heard from the audio itself (so every song has them), and the sheet music
# and tabs the services have.
#
# Chords: the song's audio (the same cached download as peak mix, or the
# downloaded file) is turned into a chromagram (how much of each of the 12
# pitch classes sounds, ~11 times a second), each moment compared with the 24
# major and minor triads, and the best path through them found with a
# Viterbi pass that makes changing chord cost something, so the result
# doesn't flicker. Like any chord detection it is approximate; the key comes
# from the whole song's pitch profile (Krumhansl-Schmuckler). Needs numpy.
#
# Scores: Songsterr's public search (tabs and notation per instrument), with
# links to search MuseScore (sheet music) and Ultimate Guitar.

CHORDS_DIR = os.path.join(CACHE_DIR, "chords")
CHORDS_VERSION = 2
CHORD_SR = 11025
CHORD_FRAME = 4096
CHORD_HOP = 1024
NOTE_NAMES = ("C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B")
# Krumhansl-Kessler key profiles.
KEY_MAJOR = (6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88)
KEY_MINOR = (6.33, 2.68, 3.52, 5.38, 2.60, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17)
SONGSTERR_API = "https://www.songsterr.com/api/songs"


def chord_audio_path(key, cookie_opts):
    """A file with the song's audio: the downloaded one, or the cache's."""
    for t in downloaded_tracks():
        if t["id"] == key:
            return t["path"]
    meta = audio_meta(key)
    if meta is None:
        meta, _ = download_audio(key, cookie_opts)
    return os.path.join(MIX_DIR, meta["audio"])


def chroma_of(path):
    """(chroma frames × 12, seconds per frame) for an audio file."""
    import numpy as np
    proc = subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-i", path, "-t", str(MIX_MAX_DURATION),
                           "-ac", "1", "-ar", str(CHORD_SR), "-f", "f32le", "-"],
                          capture_output=True, timeout=300, stdin=subprocess.DEVNULL)
    if proc.returncode != 0 or not proc.stdout:
        raise RuntimeError("ffmpeg couldn't read the song")
    audio = np.frombuffer(proc.stdout, dtype=np.float32)
    if len(audio) < CHORD_FRAME * 4:
        raise RuntimeError("the song is too short")
    freqs = np.fft.rfftfreq(CHORD_FRAME, 1.0 / CHORD_SR)
    keep = (freqs >= 55) & (freqs <= 2000)
    pitch = np.round(12 * np.log2(freqs[keep] / 440.0)).astype(int) % 12   # 0 = A
    pitch = (pitch + 9) % 12                                                # 0 = C
    window = np.hanning(CHORD_FRAME).astype(np.float32)
    count = 1 + (len(audio) - CHORD_FRAME) // CHORD_HOP
    chroma = np.zeros((count, 12), dtype=np.float32)
    for start in range(0, count, 512):                   # in batches: bounded memory
        idx = np.arange(start, min(count, start + 512))
        frames = np.stack([audio[i * CHORD_HOP:i * CHORD_HOP + CHORD_FRAME] for i in idx]) * window
        mag = np.sqrt(np.abs(np.fft.rfft(frames, axis=1))[:, keep])
        for pc in range(12):
            chroma[idx, pc] = mag[:, pitch == pc].sum(axis=1)
    return chroma, CHORD_HOP / CHORD_SR


def detect_chords(chroma, step):
    """[[start, end, name], …] and the key, from a chromagram."""
    import numpy as np
    # Smooth over ~0.75 s, then normalize each moment.
    width = max(1, int(round(0.75 / step)))
    kernel = np.ones(width, dtype=np.float32) / width
    smooth = np.stack([np.convolve(chroma[:, i], kernel, mode="same") for i in range(12)], axis=1)
    energy = smooth.sum(axis=1)
    quiet = energy < 0.08 * np.percentile(energy, 90)
    norm = smooth / np.maximum(np.linalg.norm(smooth, axis=1, keepdims=True), 1e-9)
    names, templates = [], []
    for root in range(12):
        for kind, third in (("", 4), ("m", 3)):
            t = np.zeros(12, dtype=np.float32)
            t[root], t[(root + third) % 12], t[(root + 7) % 12] = 1.0, 0.8, 0.8
            templates.append(t / np.linalg.norm(t))
            names.append(NOTE_NAMES[root] + kind)
    names.append("N")
    score = norm @ np.stack(templates).T                              # frames × 24
    score = np.concatenate([score, np.full((len(score), 1), 0.55, dtype=np.float32)], axis=1)
    score[quiet, :24] = 0.0
    score[quiet, 24] = 1.0
    # Viterbi: staying costs nothing, changing costs `penalty`.
    penalty = 0.45
    states = score.shape[1]
    best = score[0].copy()
    back = np.zeros(score.shape, dtype=np.int16)
    for i in range(1, len(score)):
        stay = best
        switch = best.max() - penalty
        choose = stay >= switch
        back[i] = np.where(choose, np.arange(states), best.argmax())
        best = np.where(choose, stay, switch) + score[i]
    path = np.zeros(len(score), dtype=np.int16)
    path[-1] = best.argmax()
    for i in range(len(score) - 1, 0, -1):
        path[i - 1] = back[i][path[i]]
    segments = []
    for i, s in enumerate(path):
        t = round(i * step, 2)
        if segments and segments[-1][2] == names[s]:
            segments[-1][1] = round((i + 1) * step, 2)
        else:
            segments.append([t, round((i + 1) * step, 2), names[s]])
    # Fold slivers (< 0.6 s) into the chord before them.
    out = []
    for seg in segments:
        if out and (seg[1] - seg[0] < 0.6 or out[-1][2] == seg[2]):
            out[-1][1] = seg[1]
        else:
            out.append(seg)
    # The key: the whole song's pitch profile against each key's.
    profile = chroma.sum(axis=0)
    best_key, best_r = "", -2.0
    for root in range(12):
        for name, prof in (("major", KEY_MAJOR), ("minor", KEY_MINOR)):
            r = float(np.corrcoef(profile, np.roll(np.array(prof), root))[0, 1])
            if r > best_r:
                best_key, best_r = f"{NOTE_NAMES[root]} {name}", r
    # A major key and its relative minor share their notes: the chord the
    # song spends most time on (its home) tells them apart.
    held = {}
    for a, b, c in out:
        if c != "N":
            held[c] = held.get(c, 0) + b - a
    if held and best_key:
        home = max(held, key=held.get)
        root = NOTE_NAMES.index(best_key.split()[0])
        if best_key.endswith("major") and home == NOTE_NAMES[(root + 9) % 12] + "m":
            best_key = f"{NOTE_NAMES[(root + 9) % 12]} minor"
        elif best_key.endswith("minor") and home == NOTE_NAMES[(root + 3) % 12]:
            best_key = f"{NOTE_NAMES[(root + 3) % 12]} major"
    return out[:2000], best_key


def cmd_chords(args):
    """chords <track> [PLAYER]: the song's chords, in time, and its key."""
    key = args[0] if args else ""
    if not TRACK_KEY_RE.match(key):
        fail("chords needs a track")
    try:
        import numpy  # noqa: F401
    except ImportError:
        fail("Chords need python-numpy (omarchy pkg add python-numpy)", setup="numpy")
    try:
        name = cache_name(key)
    except RuntimeError as exc:
        fail(str(exc))
    os.makedirs(CHORDS_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(CHORDS_DIR, re.sub(r"[^A-Za-z0-9_-]", "_", name)[:60] + ".json")
    cached = read_json(path)
    if isinstance(cached, dict) and cached.get("version") == CHORDS_VERSION and isinstance(cached.get("segments"), list):
        emit({"type": "chords", "key": key, "segments": cached["segments"], "songKey": cached.get("songKey", "")})
        return
    options = player_options(args)
    cookie_opts = {}
    if options["playback_cookies"] and options["browser"] != "none":
        cookie_opts = {"cookiesfrombrowser": browser_spec_tuple(options["browser"])}
    emit({"type": "chordsProgress", "key": key, "stage": "audio"})
    try:
        audio = chord_audio_path(key, cookie_opts)
        emit({"type": "chordsProgress", "key": key, "stage": "listen"})
        segments, song_key = detect_chords(*chroma_of(audio))
    except RuntimeError as exc:
        fail(str(exc))
    except subprocess.TimeoutExpired:
        fail("the song took too long to read")
    write_json_atomic(path, {"version": CHORDS_VERSION, "segments": segments, "songKey": song_key})
    emit({"type": "chords", "key": key, "segments": segments, "songKey": song_key})


def songsterr_slug(text):
    return re.sub(r"[^a-z0-9]+", "-", str(text or "").lower()).strip("-")[:80] or "song"


def cmd_scores(args):
    """scores <track> [--title T] [--artist A]: sheet music and tabs."""
    key = args[0] if args else ""
    if not TRACK_KEY_RE.match(key):
        fail("scores needs a track")
    title = clean_text(opt(args, "--title", ""), 200)
    artist = clean_text(opt(args, "--artist", ""), 200)
    names = lyric_names(title, artist) or [(artist, title)]
    a, t = names[0]
    query = f"{a} {t}".strip()
    items, seen = [], set()
    for qa, qt in names[:2]:
        url = f"{SONGSTERR_API}?" + urllib.parse.urlencode({"size": 20, "pattern": f"{qa} {qt}".strip()})
        request = urllib.request.Request(url, headers={"User-Agent": LRCLIB_UA, "Accept": "application/json"})
        try:
            with urllib.request.urlopen(request, timeout=15) as response:
                found = json.loads(response.read(4 * 1024 * 1024))
        except (OSError, ValueError):
            found = []
        for s in found if isinstance(found, list) else []:
            if not isinstance(s, dict) or s.get("isJunk") or not isinstance(s.get("songId"), int) or s["songId"] in seen:
                continue
            score = match_score({"title": qt, "artist": qa}, {"title": s.get("title"), "artist": s.get("artist")})
            if score < 2.5:
                continue
            seen.add(s["songId"])
            instruments = []
            for tr in s.get("tracks") or []:
                ins = clean_text((tr or {}).get("instrument"), 40)
                if ins and ins not in instruments:
                    instruments.append(ins)
            items.append({"score": score, "title": clean_text(s.get("title"), 120), "artist": clean_text(s.get("artist"), 120),
                          "instruments": instruments[:8], "chords": s.get("hasChords") is True,
                          "url": f"https://www.songsterr.com/a/wsa/{songsterr_slug(s.get('artist'))}-{songsterr_slug(s.get('title'))}-tab-s{s['songId']}"})
        if items:
            break
    # This artist's first, then other artists' versions of the song.
    items = sorted(items, key=lambda i: -i.pop("score"))[:6]
    q = urllib.parse.quote(query)
    emit({"type": "scores", "key": key, "items": items, "query": clean_text(query, 200),
          "musescore": f"https://musescore.com/sheetmusic?text={q}",
          "ultimateGuitar": f"https://www.ultimate-guitar.com/search.php?search_type=title&value={q}"})


SCORE_URL_RE = re.compile(r"^https://(?:www\.songsterr\.com/a/wsa/[a-z0-9-]{1,200}-tab-s[0-9]{1,12}"
                          r"|musescore\.com/sheetmusic\?text=[A-Za-z0-9%._~-]{0,600}"
                          r"|www\.ultimate-guitar\.com/search\.php\?search_type=title&value=[A-Za-z0-9%._~-]{0,600})$")


def cmd_open_score(args):
    """open-score <url>: a score in its own browser window (a web app)."""
    url = args[0] if args else ""
    if not SCORE_URL_RE.match(url):
        fail("Not a score link")
    launcher = shutil_which("omarchy-launch-webapp") or shutil_which("xdg-open")
    if not launcher:
        fail("No way to open a browser")
    subprocess.Popen([launcher, url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True, close_fds=True)
    emit({"type": "scoreOpened"})


# ---- radio (Radio Browser) ------------------------------------------------------
# Internet radio from radio-browser.info, a free and open directory of about
# 50,000 stations: top stations, the most liked, your country's, genres,
# search, and your favorites (the heart). Stations play their own stream
# straight in mpv; the song on air shows as the stream announces it.
#
# A station is "rd:<uuid>"; lists are "rd:fav", "rd:top", "rd:vote",
# "rd:country:<CC>", "rd:tag:<genre>" and "rd:search". mpv gets
# ytmusic-radio://<uuid>, which mpv/ytmusic.lua resolves here to the stream.

RADIO_SERVERS = ("https://de1.api.radio-browser.info", "https://de2.api.radio-browser.info")
RADIO_SCHEME = "ytmusic-radio://"
RADIO_UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
RADIO_FAV_PATH = os.path.join(DATA_DIR, "radio.json")
RADIO_STATIONS_PATH = os.path.join(CACHE_DIR, "radio-stations.json")
RADIO_URL_RE = re.compile(r"^https?://[^\s\"'<>\\\\]{1,600}$")
RADIO_LIMIT_LIST = 100
RADIO_GENRES = ("pop", "rock", "jazz", "classical", "electronic", "hip-hop", "metal", "chillout", "ambient",
                "lofi", "folk", "80s", "90s", "dance", "house", "techno", "soundtrack", "blues", "reggae",
                "country", "news", "talk")


def radio_api(path, params=None):
    query = ("?" + urllib.parse.urlencode(params)) if params else ""
    last = "no answer"
    for server in RADIO_SERVERS:
        request = urllib.request.Request(f"{server}/json/{path}{query}",
                                         headers={"User-Agent": LRCLIB_UA, "Accept": "application/json"})
        try:
            with urllib.request.urlopen(request, timeout=15) as response:
                return json.loads(response.read(8 * 1024 * 1024))
        except (OSError, ValueError) as exc:
            last = str(exc)
    raise RuntimeError(f"Radio Browser didn't answer: {last}")


RADIO_COUNTRIES_PATH = os.path.join(CACHE_DIR, "radio-countries.json")
COUNTRY_NAMES = {"US": "United States", "GB": "United Kingdom", "RU": "Russia", "KR": "South Korea", "KP": "North Korea",
                 "IR": "Iran", "SY": "Syria", "VE": "Venezuela", "BO": "Bolivia", "TZ": "Tanzania", "MD": "Moldova",
                 "VN": "Vietnam", "LA": "Laos", "TW": "Taiwan", "CZ": "Czechia", "NL": "Netherlands", "AE": "United Arab Emirates",
                 "PH": "Philippines", "DO": "Dominican Republic", "CD": "DR Congo"}


def radio_countries(max_age=7 * 86400):
    """[{code, name, count}] of countries with stations, most first."""
    cached = read_json(RADIO_COUNTRIES_PATH)
    if isinstance(cached, dict) and time.time() - float(cached.get("fetchedAt") or 0) < max_age and cached.get("items"):
        return cached["items"]
    items = []
    for c in radio_api("countries", {"order": "stationcount", "reverse": "true", "hidebroken": "true"}) or []:
        code = str(c.get("iso_3166_1") or "") if isinstance(c, dict) else ""
        if re.match(r"^[A-Z]{2}$", code) and isinstance(c.get("stationcount"), int) and c["stationcount"] > 0:
            name = COUNTRY_NAMES.get(code) or re.sub(r"^The ", "", clean_text(c.get("name"), 80))
            items.append({"code": code, "name": name, "count": c["stationcount"]})
    write_json_atomic(RADIO_COUNTRIES_PATH, {"items": items, "fetchedAt": int(time.time())})
    return items


def country_name(code):
    for c in (read_json(RADIO_COUNTRIES_PATH) or {}).get("items") or []:
        if isinstance(c, dict) and c.get("code") == code:
            return c.get("name") or code
    return COUNTRY_NAMES.get(code, code)


def cmd_radio_countries(_args):
    try:
        items = radio_countries()
    except RuntimeError as exc:
        fail(str(exc))
    emit({"type": "radioCountries", "items": items, "current": radio_country()})


def radio_country():
    """The country chosen in the Radio tab, else the one the system's
    language setting names (de_DE → DE)."""
    chosen = str(widget_settings().get("radioCountry") or "")
    if re.match(r"^[A-Z]{2}$", chosen):
        return chosen
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        m = re.match(r"^[a-z]{2,3}_([A-Z]{2})", os.environ.get(var, ""))
        if m:
            return m.group(1)
    return ""


def radio_station(s):
    """A station as a track, and its stream URL (kept apart)."""
    if not isinstance(s, dict) or not RADIO_UUID_RE.match(str(s.get("stationuuid", ""))):
        return None, None
    url = s.get("url_resolved") or s.get("url")
    if not isinstance(url, str) or not RADIO_URL_RE.match(url.strip()):
        return None, None
    tags = [t.strip() for t in str(s.get("tags") or "").split(",") if t.strip()][:3]
    about = " · ".join(x for x in (", ".join(tags), str(s.get("countrycode") or ""),
                                   f"{s.get('codec') or ''} {s.get('bitrate') or ''}".strip() if s.get("bitrate") else "") if x)
    track = {"id": "rd:" + s["stationuuid"], "title": clean_text(s.get("name"), 120) or "Radio",
             "artist": clean_text(about, 120), "duration": None}
    favicon = s.get("favicon")
    if isinstance(favicon, str) and favicon.startswith("https://"):
        track["favicon"] = favicon[:500]
    return track, url.strip()


def remember_stations(pairs):
    known = read_json(RADIO_STATIONS_PATH)
    known = known if isinstance(known, dict) else {}
    for track, url in pairs:
        known[track["id"][3:]] = {"url": url, "track": {k: v for k, v in track.items() if k != "cover"}}
    if len(known) > 5000:
        known = dict(list(known.items())[-5000:])
    write_json_atomic(RADIO_STATIONS_PATH, known)


def radio_cover_path(uuid):
    return os.path.join(COVERS_DIR, f"rd-{uuid}.png")


def fetch_radio_covers(tracks):
    """Each station's logo, made a small PNG next to the other covers (the
    logos live on the stations' own sites: fetched by the helper, so the
    panel only ever shows local files)."""
    import concurrent.futures
    os.makedirs(COVERS_DIR, mode=0o700, exist_ok=True)
    def one(t):
        path = radio_cover_path(t["id"][3:])
        if os.path.isfile(path) or "favicon" not in t:
            return
        try:
            body, response = http_get(t["favicon"], 1024 * 1024, timeout=6, accept="image/*")
        except Exception:
            return
        if not response.headers.get_content_type().startswith("image/") or b"<svg" in body[:400].lower():
            return
        tmp = path + ".src"
        with open(tmp, "wb") as fh:
            fh.write(body)
        try:
            subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", tmp, "-frames:v", "1",
                            "-vf", "scale=128:128:force_original_aspect_ratio=decrease", path],
                           capture_output=True, timeout=20, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            pass
        finally:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(one, tracks[:RADIO_LIMIT_LIST]))


def with_radio_covers(tracks):
    out = []
    for t in tracks:
        t = {k: v for k, v in t.items() if k != "favicon"}
        if os.path.isfile(radio_cover_path(t["id"][3:])):
            t["cover"] = radio_cover_path(t["id"][3:])
        out.append(t)
    return out


def radio_favorites():
    data = read_json(RADIO_FAV_PATH)
    items = data.get("stations") if isinstance(data, dict) and isinstance(data.get("stations"), list) else []
    return [t for t in items if isinstance(t, dict) and RADIO_UUID_RE.match(str(t.get("id", ""))[3:])]


def radio_list_query(list_id):
    if list_id == "rd:top":
        return "stations/topclick/%d" % RADIO_LIMIT_LIST, {"hidebroken": "true"}
    if list_id == "rd:vote":
        return "stations/topvote/%d" % RADIO_LIMIT_LIST, {"hidebroken": "true"}
    m = re.match(r"^rd:country:([A-Z]{2})$", list_id)
    if m:
        return "stations/search", {"countrycode": m.group(1), "order": "clickcount", "reverse": "true",
                                   "hidebroken": "true", "limit": RADIO_LIMIT_LIST}
    m = re.match(r"^rd:tag:([a-z0-9-]{1,40})$", list_id)
    if m:
        return "stations/search", {"tag": m.group(1).replace("-", " "), "order": "clickcount", "reverse": "true",
                                   "hidebroken": "true", "limit": RADIO_LIMIT_LIST}
    raise RuntimeError("Unknown radio list")


def fetch_radio(list_id):
    path, params = radio_list_query(list_id)
    pairs = [p for p in (radio_station(s) for s in radio_api(path, params) or []) if p[0]]
    remember_stations(pairs)
    tracks = [t for t, _ in pairs]
    fetch_radio_covers(tracks)
    return {"title": "", "items": with_radio_covers(tracks)}


def radio_lists():
    favs = radio_favorites()
    items = [{"id": "rd:fav", "title": "Favorite stations", "count": len(favs)},
             {"id": "rd:top", "title": "Top stations", "count": None, "subtitle": "The most played right now"},
             {"id": "rd:vote", "title": "Most liked", "count": None, "subtitle": "Listeners' favorites"}]
    country = radio_country()
    if country:
        items.append({"id": f"rd:country:{country}", "title": f"Stations in {country_name(country)}", "count": None,
                      "subtitle": "Your country" if widget_settings().get("radioCountry") else "From your language settings"})
    items += [{"id": f"rd:tag:{g}", "title": g.replace("-", " ").title() if g not in ("80s", "90s", "lofi") else g,
               "count": None, "subtitle": "Genre"} for g in RADIO_GENRES]
    return items


def radio_search(query):
    pairs = [p for p in (radio_station(s) for s in radio_api("stations/search", {
        "name": query, "order": "clickcount", "reverse": "true", "hidebroken": "true", "limit": 60}) or []) if p[0]]
    remember_stations(pairs)
    tracks = [t for t, _ in pairs]
    fetch_radio_covers(tracks)
    tracks = with_radio_covers(tracks)
    write_json_atomic(tracks_cache_path("rd:search", "none"),
                      {"title": f"Radio: {query}", "items": tracks, "fetchedAt": int(time.time())})
    return tracks


def radio_stream_url(key):
    """A station's stream: asked from the directory, which counts the
    listen; the last known address if it doesn't answer."""
    uuid = key[3:]
    known = (read_json(RADIO_STATIONS_PATH) or {}).get(uuid) or {}
    try:
        data = radio_api(f"url/{uuid}")
        url = data.get("url") if isinstance(data, dict) else None
        if isinstance(url, str) and RADIO_URL_RE.match(url.strip()):
            return url.strip()
    except RuntimeError:
        pass
    if isinstance(known.get("url"), str) and RADIO_URL_RE.match(known["url"]):
        return known["url"]
    raise RuntimeError("That station can't be reached")


def cmd_radio_fav(args):
    """radio-fav <station> [--remove 1]: the heart for a station."""
    key = args[0] if args else ""
    if not (key.startswith("rd:") and RADIO_UUID_RE.match(key[3:])):
        fail("radio-fav needs a station")
    remove = opt(args, "--remove", "0") == "1"
    favs = [t for t in radio_favorites() if t["id"] != key]
    if not remove:
        known = ((read_json(RADIO_STATIONS_PATH) or {}).get(key[3:]) or {}).get("track")
        if not isinstance(known, dict):
            fail("Open the station's list again first")
        favs.insert(0, {"id": key, "title": clean_text(known.get("title"), 120), "artist": clean_text(known.get("artist"), 120),
                        "duration": None})
    os.makedirs(DATA_DIR, mode=0o700, exist_ok=True)
    write_json_atomic(RADIO_FAV_PATH, {"stations": favs[:500]})
    emit({"type": "radioFavs", "ids": [t["id"] for t in favs]})


def cmd_radio_favs(_args):
    emit({"type": "radioFavs", "ids": [t["id"] for t in radio_favorites()]})


# ---- media servers: Navidrome / Subsonic, Jellyfin, Plex ---------------------------
# Your own music server, in the Files tab: its recently added albums (with
# their covers), playlists, favorites and a random mix. Signing in keeps a
# token, never the password: Subsonic's salted token (md5 of password and
# salt), Jellyfin's access token, Plex's token from its PIN sign-in in the
# browser. Tokens live owner-only in servers.json.
#
# A song is "ms:<source>/<id>"; lists are "ms:<source>:al:<id>" (an album),
# "ms:<source>:pl:<id>" (a playlist), "ms:<source>:fav" and "ms:<source>:rnd".
# mpv gets ytmusic-server://<source>/<id>, resolved here to a stream URL.

SERVER_KINDS = ("subsonic", "jellyfin", "plex")
SERVER_SECRETS_PATH = os.path.join(DATA_DIR, "servers.json")
SERVER_SCHEME = "ytmusic-server://"
SERVER_KEY_RE = re.compile(r"^ms:([a-f0-9]{8})/([A-Za-z0-9_-]{1,64})$")
SERVER_LIST_RE = re.compile(r"^ms:([a-f0-9]{8}):(fav|rnd|al:[A-Za-z0-9_-]{1,64}|pl:[A-Za-z0-9_-]{1,64})$")
SERVER_ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
SERVER_URL_RE = re.compile(r"^https?://[A-Za-z0-9.\[\]:_-]{1,253}(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~/%-]{0,200})?$")
SUBSONIC_CLIENT = "OmarchyMusicPlayer"
PLEX_PRODUCT = "Omarchy Music Player"
SERVER_ALBUMS = 60


def server_secrets():
    data = read_json(SERVER_SECRETS_PATH)
    return data if isinstance(data, dict) else {}


def save_server_secret(src_id, secret):
    data = server_secrets()
    if secret is None:
        data.pop(src_id, None)
    else:
        data[src_id] = secret
    os.makedirs(DATA_DIR, mode=0o700, exist_ok=True)
    fd = os.open(SERVER_SECRETS_PATH + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh)
    os.replace(SERVER_SECRETS_PATH + ".tmp", SERVER_SECRETS_PATH)


def server_request(url, headers=None, method="GET", body=None, timeout=15):
    data = json.dumps(body).encode() if body is not None else None
    hdrs = {"Accept": "application/json", "User-Agent": LRCLIB_UA, **(headers or {})}
    if data is not None:
        hdrs["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, method=method, headers=hdrs)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read(16 * 1024 * 1024)
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            raise RuntimeError("the server refused the sign-in (check the user name and password)")
        raise RuntimeError(f"the server answered {exc.code}")
    except (OSError, ValueError) as exc:
        raise RuntimeError(f"couldn't reach the server: {getattr(exc, 'reason', exc)}")
    try:
        return json.loads(raw or b"{}")
    except ValueError:
        raise RuntimeError("the server's answer wasn't JSON (is this the right address?)")


def server_base(raw):
    url = str(raw or "").strip().rstrip("/")
    if url and "://" not in url:
        url = "http://" + url
    if not SERVER_URL_RE.match(url):
        raise RuntimeError("That server address doesn't look right")
    return url


# -- Subsonic (Navidrome, Airsonic, Gonic …)

def subsonic_params(secret, **extra):
    return urllib.parse.urlencode({"u": secret["user"], "t": secret["token"], "s": secret["salt"],
                                   "v": "1.16.1", "c": SUBSONIC_CLIENT, "f": "json", **extra})


def subsonic(src, secret, method, **params):
    data = server_request(f"{src['path']}/rest/{method}?" + subsonic_params(secret, **params))
    body = data.get("subsonic-response") if isinstance(data, dict) else None
    if not isinstance(body, dict):
        raise RuntimeError("that doesn't look like a Subsonic server")
    if body.get("status") != "ok":
        err = body.get("error") or {}
        if err.get("code") in (40, 41, 50):
            raise RuntimeError("the server refused the sign-in (check the user name and password)")
        raise RuntimeError(clean_text(err.get("message") or "the server said no", 200))
    return body


def subsonic_song(src_id, s):
    if not isinstance(s, dict) or not SERVER_ID_RE.match(str(s.get("id", ""))):
        return None
    return {"id": f"ms:{src_id}/{s['id']}", "title": clean_text(s.get("title"), 200) or str(s["id"]),
            "artist": clean_text(s.get("artist"), 200), "album": clean_text(s.get("album"), 200),
            "duration": int(s["duration"]) if isinstance(s.get("duration"), (int, float)) and s["duration"] > 0 else None,
            "_art": s.get("coverArt") or s.get("albumId")}


# -- Jellyfin

def jellyfin_headers(secret=None):
    auth = (f'MediaBrowser Client="{PLEX_PRODUCT}", Device="Omarchy", '
            f'DeviceId="{(secret or {}).get("device") or "omarchy"}", Version="1"')
    if secret and secret.get("token"):
        auth += f', Token="{secret["token"]}"'
    return {"Authorization": auth, "X-Emby-Authorization": auth}


def jellyfin(src, secret, path, **params):
    query = ("?" + urllib.parse.urlencode(params)) if params else ""
    return server_request(f"{src['path']}{path}{query}", jellyfin_headers(secret))


def jellyfin_song(src_id, it):
    if not isinstance(it, dict) or not SERVER_ID_RE.match(str(it.get("Id", ""))):
        return None
    ticks = it.get("RunTimeTicks")
    artists = it.get("Artists") if isinstance(it.get("Artists"), list) else []
    return {"id": f"ms:{src_id}/{it['Id']}", "title": clean_text(it.get("Name"), 200) or it["Id"],
            "artist": clean_text(", ".join(str(a) for a in artists[:3]) or it.get("AlbumArtist"), 200),
            "album": clean_text(it.get("Album"), 200),
            "duration": int(ticks / 10_000_000) if isinstance(ticks, (int, float)) and ticks > 0 else None,
            "_art": it.get("AlbumId") or it["Id"]}


# -- Plex

def plex_headers(secret):
    return {"X-Plex-Token": secret["token"], "X-Plex-Client-Identifier": secret["client"],
            "X-Plex-Product": PLEX_PRODUCT}


def plex(src, secret, path, **params):
    query = ("?" + urllib.parse.urlencode(params)) if params else ""
    data = server_request(f"{src['path']}{path}{query}", plex_headers(secret))
    container = data.get("MediaContainer") if isinstance(data, dict) else None
    if not isinstance(container, dict):
        raise RuntimeError("that doesn't look like a Plex server")
    return container


def plex_music_sections(src, secret):
    dirs = plex(src, secret, "/library/sections").get("Directory") or []
    return [d["key"] for d in dirs if isinstance(d, dict) and d.get("type") == "artist" and SERVER_ID_RE.match(str(d.get("key", "")))]


def plex_song(src_id, m):
    if not isinstance(m, dict) or not SERVER_ID_RE.match(str(m.get("ratingKey", ""))):
        return None
    dur = m.get("duration")
    return {"id": f"ms:{src_id}/{m['ratingKey']}", "title": clean_text(m.get("title"), 200) or m["ratingKey"],
            "artist": clean_text(m.get("originalTitle") or m.get("grandparentTitle"), 200),
            "album": clean_text(m.get("parentTitle"), 200),
            "duration": int(dur / 1000) if isinstance(dur, (int, float)) and dur > 0 else None,
            "_art": m.get("parentThumb") or m.get("thumb")}


# -- signing in (from cloud-add)

def add_media_server(kind, form):
    """Sign in to a server and keep it as a source of the Files tab."""
    fields = form.get("fields") if isinstance(form.get("fields"), dict) else {}
    src_id = os.urandom(4).hex()
    if kind == "plex":
        base, secret, title = plex_sign_in()
    else:
        try:
            base = server_base(fields.get("url"))
        except RuntimeError as exc:
            fail(str(exc))
        user = clean_text(fields.get("user"), 200)
        password = str(fields.get("pass") or "")
        if not user:
            fail("user is needed")
        emit({"type": "cloud", "state": "checking"})
        src = {"id": src_id, "path": base}
        try:
            if kind == "subsonic":
                salt = os.urandom(8).hex()
                secret = {"user": user, "salt": salt, "token": hashlib.md5((password + salt).encode()).hexdigest()}
                subsonic(src, secret, "ping")
                title = "Navidrome" if "navidrome" in base.lower() else "Subsonic"
            else:
                device = os.urandom(8).hex()
                auth = server_request(f"{base}/Users/AuthenticateByName", jellyfin_headers({"device": device}),
                                      method="POST", body={"Username": user, "Pw": password})
                token, uid = auth.get("AccessToken"), (auth.get("User") or {}).get("Id")
                if not isinstance(token, str) or not SERVER_ID_RE.match(str(uid or "")):
                    raise RuntimeError("Jellyfin didn't sign us in")
                secret = {"token": token, "user": uid, "device": device}
                title = "Jellyfin"
        except RuntimeError as exc:
            fail(f"Couldn't sign in: {exc}")
    title = clean_text(form.get("title"), 80) or title
    sources = read_cloud()
    sources.append({"id": src_id, "remote": "", "path": base, "kind": kind, "title": title, "created": False})
    save_server_secret(src_id, secret)
    write_cloud(sources)
    emit({"type": "cloud", "state": "added", "id": src_id, "title": title})


def plex_sign_in():
    """Plex's PIN sign-in: the browser opens plex.tv, the user allows it,
    and Plex hands over a token; then the first server with music."""
    client = os.urandom(12).hex()
    head = {"X-Plex-Client-Identifier": client, "X-Plex-Product": PLEX_PRODUCT}
    try:
        pin = server_request("https://plex.tv/api/v2/pins?strong=true", head, method="POST", body={})
    except RuntimeError as exc:
        fail(f"Couldn't reach plex.tv: {exc}")
    if not isinstance(pin.get("id"), int) or not isinstance(pin.get("code"), str):
        fail("Plex didn't start the sign-in")
    url = "https://app.plex.tv/auth#?" + urllib.parse.urlencode(
        {"clientID": client, "code": pin["code"], "context[device][product]": PLEX_PRODUCT})
    emit({"type": "cloud", "state": "waiting", "kind": "plex"})
    opener = shutil_which("xdg-open")
    if opener:
        subprocess.Popen([opener, url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    token = None
    for _ in range(150):                       # five minutes
        time.sleep(2)
        try:
            state = server_request(f"https://plex.tv/api/v2/pins/{pin['id']}", head)
        except RuntimeError:
            continue
        if isinstance(state.get("authToken"), str) and state["authToken"]:
            token = state["authToken"]
            break
    if not token:
        fail("The Plex sign-in didn't finish")
    emit({"type": "cloud", "state": "checking"})
    secret = {"token": token, "client": client}
    try:
        resources = server_request("https://plex.tv/api/v2/resources?includeHttps=1", plex_headers(secret))
    except RuntimeError as exc:
        fail(f"Couldn't list your Plex servers: {exc}")
    for res in resources if isinstance(resources, list) else []:
        if not isinstance(res, dict) or "server" not in str(res.get("provides", "")):
            continue
        secret = {"token": res.get("accessToken") or token, "client": client}
        conns = sorted((c for c in res.get("connections") or [] if isinstance(c, dict)),
                       key=lambda c: (not c.get("local"), c.get("relay") is True))
        for c in conns:
            try:
                base = server_base(c.get("uri"))
                if plex_music_sections({"path": base}, secret):
                    return base, secret, clean_text(res.get("name"), 60) or "Plex"
            except RuntimeError:
                continue
    fail("No Plex server with a music library answered")


# -- lists, songs, streams

def server_secret(src):
    secret = server_secrets().get(src["id"])
    if not isinstance(secret, dict):
        raise RuntimeError("Sign in to this server again (remove it and add it)")
    return secret


def server_cover_path(src_id, art):
    return os.path.join(COVERS_DIR, f"ms-{src_id}-{hashlib.sha1(str(art).encode()).hexdigest()[:16]}.jpg")


def server_cover_url(src, secret, art):
    if src["kind"] == "subsonic":
        return f"{src['path']}/rest/getCoverArt?" + subsonic_params(secret, id=art, size=300)
    if src["kind"] == "jellyfin":
        return f"{src['path']}/Items/{urllib.parse.quote(str(art))}/Images/Primary?maxWidth=300&quality=85"
    return (f"{src['path']}/photo/:/transcode?" + urllib.parse.urlencode(
        {"width": 300, "height": 300, "minSize": 1, "url": art, "X-Plex-Token": secret["token"]}))


def fetch_server_covers(src, secret, arts):
    """The covers, made local files (the panel shows only local ones)."""
    import concurrent.futures
    os.makedirs(COVERS_DIR, mode=0o700, exist_ok=True)
    headers = jellyfin_headers(secret) if src["kind"] == "jellyfin" else {}
    def one(art):
        path = server_cover_path(src["id"], art)
        if os.path.isfile(path):
            return
        try:
            request = urllib.request.Request(server_cover_url(src, secret, art), headers={"User-Agent": LRCLIB_UA, **headers})
            with urllib.request.urlopen(request, timeout=10) as response:
                body = response.read(4 * 1024 * 1024)
                kind = response.headers.get_content_type()
        except (OSError, ValueError):
            return
        if not kind.startswith("image/"):
            return
        if kind == "image/jpeg":
            with open(path, "wb") as fh:
                fh.write(body)
            return
        tmp = path + ".src"
        with open(tmp, "wb") as fh:
            fh.write(body)
        try:
            subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", tmp, "-frames:v", "1", path],
                           capture_output=True, timeout=20, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            pass
        finally:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
        list(pool.map(one, [a for a in dict.fromkeys(arts) if a][:120]))


def with_server_covers(src_id, items):
    out = []
    for it in items:
        it = dict(it)
        art = it.pop("_art", None)
        if art and os.path.isfile(server_cover_path(src_id, art)):
            it["cover"] = server_cover_path(src_id, art)
        out.append(it)
    return out


def fetch_server_index(src):
    """A server's lists: favorites, a random mix, playlists, newest albums."""
    secret = server_secret(src)
    sid, kind = src["id"], src["kind"]
    lists = [{"id": f"ms:{sid}:fav", "title": f"{src['title']} · Favorites", "count": None, "subtitle": "Songs you starred"},
             {"id": f"ms:{sid}:rnd", "title": f"{src['title']} · Random mix", "count": None, "subtitle": "New every time"}]
    albums, playlists = [], []
    if kind == "subsonic":
        for p in (subsonic(src, secret, "getPlaylists").get("playlists") or {}).get("playlist") or []:
            if SERVER_ID_RE.match(str(p.get("id", ""))):
                playlists.append({"id": f"ms:{sid}:pl:{p['id']}", "title": clean_text(p.get("name"), 120), "count": p.get("songCount"),
                                  "subtitle": "Playlist", "_art": p.get("coverArt")})
        for a in (subsonic(src, secret, "getAlbumList2", type="newest", size=SERVER_ALBUMS).get("albumList2") or {}).get("album") or []:
            if SERVER_ID_RE.match(str(a.get("id", ""))):
                albums.append({"id": f"ms:{sid}:al:{a['id']}", "title": clean_text(a.get("name"), 120), "count": a.get("songCount"),
                               "subtitle": clean_text(a.get("artist"), 120), "_art": a.get("coverArt") or a["id"]})
    elif kind == "jellyfin":
        uid = secret["user"]
        for p in jellyfin(src, secret, f"/Users/{uid}/Items", IncludeItemTypes="Playlist", Recursive="true",
                          Fields="ChildCount").get("Items") or []:
            if SERVER_ID_RE.match(str(p.get("Id", ""))) and p.get("MediaType") in (None, "Audio"):
                playlists.append({"id": f"ms:{sid}:pl:{p['Id']}", "title": clean_text(p.get("Name"), 120), "count": p.get("ChildCount"),
                                  "subtitle": "Playlist", "_art": p["Id"]})
        for a in jellyfin(src, secret, f"/Users/{uid}/Items", IncludeItemTypes="MusicAlbum", Recursive="true",
                          SortBy="DateCreated", SortOrder="Descending", Limit=SERVER_ALBUMS, Fields="ChildCount").get("Items") or []:
            if SERVER_ID_RE.match(str(a.get("Id", ""))):
                albums.append({"id": f"ms:{sid}:al:{a['Id']}", "title": clean_text(a.get("Name"), 120), "count": a.get("ChildCount"),
                               "subtitle": clean_text(a.get("AlbumArtist"), 120), "_art": a["Id"]})
    else:
        for p in plex(src, secret, "/playlists", playlistType="audio").get("Metadata") or []:
            if SERVER_ID_RE.match(str(p.get("ratingKey", ""))):
                playlists.append({"id": f"ms:{sid}:pl:{p['ratingKey']}", "title": clean_text(p.get("title"), 120),
                                  "count": p.get("leafCount"), "subtitle": "Playlist", "_art": p.get("composite") or p.get("thumb")})
        for section in plex_music_sections(src, secret)[:3]:
            for a in plex(src, secret, f"/library/sections/{section}/all", type=9, sort="addedAt:desc",
                          **{"X-Plex-Container-Start": 0, "X-Plex-Container-Size": SERVER_ALBUMS}).get("Metadata") or []:
                if SERVER_ID_RE.match(str(a.get("ratingKey", ""))):
                    albums.append({"id": f"ms:{sid}:al:{a['ratingKey']}", "title": clean_text(a.get("title"), 120),
                                   "count": a.get("leafCount"), "subtitle": clean_text(a.get("parentTitle"), 120), "_art": a.get("thumb")})
        lists = lists[1:]                       # Plex has no starred songs
    fetch_server_covers(src, secret, [i.get("_art") for i in playlists + albums])
    return {"lists": lists + with_server_covers(sid, playlists) + with_server_covers(sid, albums[:SERVER_ALBUMS])}


def server_lists(src, index):
    return [dict(l) for l in index.get("lists") or [] if isinstance(l, dict)]


def fetch_server_tracks(list_id):
    m = SERVER_LIST_RE.match(list_id)
    src = cloud_source(m.group(1)) if m else None
    if not src or src["kind"] not in SERVER_KINDS:
        raise RuntimeError("That server isn't connected any more")
    secret = server_secret(src)
    sid, what = src["id"], m.group(2)
    songs = []
    if src["kind"] == "subsonic":
        if what == "fav":
            raw = (subsonic(src, secret, "getStarred2").get("starred2") or {}).get("song") or []
        elif what == "rnd":
            raw = (subsonic(src, secret, "getRandomSongs", size=100).get("randomSongs") or {}).get("song") or []
        elif what.startswith("al:"):
            raw = (subsonic(src, secret, "getAlbum", id=what[3:]).get("album") or {}).get("song") or []
        else:
            raw = (subsonic(src, secret, "getPlaylist", id=what[3:]).get("playlist") or {}).get("entry") or []
        songs = [subsonic_song(sid, s) for s in raw]
    elif src["kind"] == "jellyfin":
        uid = secret["user"]
        common = {"IncludeItemTypes": "Audio", "Recursive": "true", "Limit": 500}
        if what == "fav":
            raw = jellyfin(src, secret, f"/Users/{uid}/Items", Filters="IsFavorite", **common).get("Items") or []
        elif what == "rnd":
            raw = jellyfin(src, secret, f"/Users/{uid}/Items", SortBy="Random", **dict(common, Limit=100)).get("Items") or []
        elif what.startswith("al:"):
            raw = jellyfin(src, secret, f"/Users/{uid}/Items", ParentId=what[3:], SortBy="ParentIndexNumber,IndexNumber",
                           **common).get("Items") or []
        else:
            raw = jellyfin(src, secret, f"/Playlists/{what[3:]}/Items", UserId=uid).get("Items") or []
        songs = [jellyfin_song(sid, s) for s in raw]
    else:
        if what == "rnd":
            raw = []
            for section in plex_music_sections(src, secret)[:1]:
                raw = plex(src, secret, f"/library/sections/{section}/all", type=10, sort="random",
                           **{"X-Plex-Container-Start": 0, "X-Plex-Container-Size": 100}).get("Metadata") or []
        elif what.startswith("al:"):
            raw = plex(src, secret, f"/library/metadata/{what[3:]}/children").get("Metadata") or []
        elif what.startswith("pl:"):
            raw = plex(src, secret, f"/playlists/{what[3:]}/items").get("Metadata") or []
        else:
            raw = []
        songs = [plex_song(sid, s) for s in raw]
    songs = [s for s in songs if s][:MAX_TRACKS]
    fetch_server_covers(src, secret, [s.get("_art") for s in songs])
    return {"title": "", "items": with_server_covers(sid, songs)}


def server_stream_url(key):
    m = SERVER_KEY_RE.match(key or "")
    src = cloud_source(m.group(1)) if m else None
    if not src or src["kind"] not in SERVER_KINDS:
        raise RuntimeError("That server isn't connected any more")
    secret, item = server_secret(src), m.group(2)
    if src["kind"] == "subsonic":
        return f"{src['path']}/rest/stream?" + subsonic_params(secret, id=item)
    if src["kind"] == "jellyfin":
        return f"{src['path']}/Audio/{item}/stream?" + urllib.parse.urlencode({"static": "true", "api_key": secret["token"]})
    meta = (plex(src, secret, f"/library/metadata/{item}").get("Metadata") or [{}])[0]
    part = (((meta.get("Media") or [{}])[0].get("Part")) or [{}])[0].get("key")
    if not isinstance(part, str) or not part.startswith("/library/parts/"):
        raise RuntimeError("Plex didn't say where the song's file is")
    return f"{src['path']}{part}?" + urllib.parse.urlencode({"X-Plex-Token": secret["token"]})


def download_server_audio(key, name):
    """A server song into the audio cache (peak mix, downloads)."""
    url = server_stream_url(key)
    os.makedirs(MIX_DIR, mode=0o700, exist_ok=True)
    tmp = os.path.join(MIX_DIR, f".audio-{name}.part")
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": LRCLIB_UA}), timeout=30) as response:
            kind = response.headers.get_content_type()
            ext = {"audio/mpeg": "mp3", "audio/flac": "flac", "audio/x-flac": "flac", "audio/ogg": "ogg", "audio/opus": "opus",
                   "audio/mp4": "m4a", "audio/aac": "m4a", "audio/x-m4a": "m4a", "audio/wav": "wav", "audio/x-wav": "wav",
                   "audio/webm": "webm"}.get(kind, "audio")
            total = 0
            with open(tmp, "wb") as fh:
                while True:
                    chunk = response.read(1 << 16)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > 200 * 1024 * 1024:
                        raise RuntimeError("the file is too big")
                    fh.write(chunk)
    except (OSError, ValueError) as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise RuntimeError(f"couldn't fetch the song from the server: {exc}")
    if ext == "audio":
        ext = "mka"
    target = os.path.join(MIX_DIR, f"audio-{name}.{ext}")
    os.replace(tmp, target)
    meta = {"audio": os.path.basename(target), "heatmap": [], "usedAt": int(time.time())}
    write_json_atomic(os.path.join(MIX_DIR, f"{name}.json"), meta)
    return meta


# ---- listening history and the AI Mix -----------------------------------------------
# The player notes each song that played (mpv/ytmusic.lua → history-add):
# how long of how long, and whether it ran to its end or was skipped. The
# history stays on this machine (history.jsonl). From it, and the likes in
# every service, `taste` sums up what you listen to; `ai-mix` (only when
# turned on) gives that summary to the AI agent Omarchy uses (Claude, Codex
# or OpenCode, from `omarchy default agent`) and asks it for songs you may
# like. Each one is looked up on YouTube Music; songs it can't find (an AI
# can invent some) are dropped. The mix is the list "ai:mix".

HISTORY_PATH = os.path.join(DATA_DIR, "history.jsonl")
HISTORY_MAX = 5000
AI_MIX_PATH = os.path.join(DATA_DIR, "ai-mix.json")
AI_SONGS = 30
AGENT_FILE = os.path.join(HOME, ".config", "omarchy", "defaults", "agent")


def session_track(key):
    data = read_json(SESSION_PATH)
    for t in (data.get("tracks") if isinstance(data, dict) else None) or []:
        if isinstance(t, dict) and t.get("id") == key:
            return t
    return None


def cmd_history_add(args):
    """history-add <mpv entry> --played S --duration S --reason R"""
    name = args[0] if args else ""
    key = None
    if os.path.isabs(name):
        key = next((t["id"] for t in downloaded_tracks() if t.get("path") == name), None)
    if not key:
        key, _ = mix_entry(name)
    if not key or not TRACK_KEY_RE.match(key) or key.startswith("rd:"):
        return
    try:
        played = max(0, min(86400, int(float(opt(args, "--played", "0")))))
        duration = max(0, min(86400, int(float(opt(args, "--duration", "0")))))
    except ValueError:
        return
    reason = opt(args, "--reason", "")
    track = session_track(key) or next((t for t in downloaded_tracks() if t["id"] == key), {})
    finished = reason == "eof" and (duration == 0 or played >= duration * 0.8)
    # Skipped: moved on to another song early ("stop"). Starting another
    # playlist ("quit") says nothing about the song.
    skipped = reason == "stop" and played < min(30, max(10, duration * 0.4))
    entry = {"t": int(time.time()), "id": key, "title": clean_text(track.get("title"), 200),
             "artist": clean_text(track.get("artist"), 200), "played": played, "duration": duration,
             "finished": finished, "skipped": skipped}
    os.makedirs(DATA_DIR, mode=0o700, exist_ok=True)
    with open(HISTORY_PATH, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
    try:
        if os.path.getsize(HISTORY_PATH) > HISTORY_MAX * 400:
            lines = open(HISTORY_PATH, encoding="utf-8").read().splitlines()[-HISTORY_MAX:]
            write_lines = "\n".join(lines) + "\n"
            with open(HISTORY_PATH + ".tmp", "w", encoding="utf-8") as fh:
                fh.write(write_lines)
            os.replace(HISTORY_PATH + ".tmp", HISTORY_PATH)
    except OSError:
        pass


def read_history(limit=HISTORY_MAX):
    try:
        lines = open(HISTORY_PATH, encoding="utf-8").read().splitlines()[-limit:]
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if isinstance(e, dict) and TRACK_KEY_RE.match(str(e.get("id", ""))):
            out.append(e)
    return out


def recent_tracks(limit=100):
    """Songs played lately, newest first, each once."""
    seen, out = set(), []
    for e in reversed(read_history()):
        if e["id"] in seen or e.get("skipped"):
            continue
        seen.add(e["id"])
        out.append({"id": e["id"], "title": e.get("title") or e["id"], "artist": e.get("artist") or "", "duration": e.get("duration") or None})
        if len(out) >= limit:
            break
    return out


def artist_of_track(t):
    """The artist, or for a YouTube upload titled "Artist - Song" that part."""
    artist = clean_text(t.get("artist"), 120)
    title = clean_text(t.get("title"), 200)
    m = re.match(r"^(.{2,60}?)\s+[-–]\s+.+", title)
    if m and (not artist or artist.lower() in ("various artists", "release - topic")):
        return m.group(1).strip()
    return artist


def taste_profile(browser="none"):
    """What you listen to, summed up small enough to hand to an AI."""
    history = read_history()
    score, songs, skipped_artists = {}, {}, {}
    for e in history:
        a = artist_of_track(e)
        w = 2.0 if e.get("finished") else (-1.5 if e.get("skipped") else 0.5)
        if a:
            score[a] = score.get(a, 0) + w
            if e.get("skipped"):
                skipped_artists[a] = skipped_artists.get(a, 0) + 1
        label = f"{a} - {e.get('title')}" if a and a.lower() not in str(e.get("title", "")).lower() else str(e.get("title"))
        if label.strip():
            songs[label] = songs.get(label, 0) + w
    likes = []
    for list_id in ["LM", "sp:liked"] + ([f"sc:likes:{u}"] if (u := sc_user(widget_settings().get("soundcloudUser"))) else []):
        cached = read_json(tracks_cache_path(list_id, browser))
        for t in (cached.get("items") if isinstance(cached, dict) else None) or []:
            if isinstance(t, dict) and t.get("title"):
                likes.append(t)
                a = artist_of_track(t)
                if a:
                    score[a] = score.get(a, 0) + 1.5
    top_artists = [a for a, s in sorted(score.items(), key=lambda kv: -kv[1]) if s > 0][:40]
    loved = [s for s, v in sorted(songs.items(), key=lambda kv: -kv[1]) if v > 0][:40]
    liked = [f"{artist_of_track(t)} - {t['title']}".strip(" -") for t in likes[:60]]
    disliked = [a for a, n in sorted(skipped_artists.items(), key=lambda kv: -kv[1]) if n >= 2 and score.get(a, 0) <= 0][:15]
    return {"topArtists": top_artists, "mostPlayed": loved, "liked": liked, "oftenSkipped": disliked,
            "plays": len(history), "likes": len(likes)}


def agent_command():
    """How to ask Omarchy's AI agent one question without tools, and its name."""
    try:
        chosen = open(AGENT_FILE, encoding="utf-8").readline().strip()
    except OSError:
        chosen = ""
    order = [chosen] + ["claude", "codex", "opencode"]
    for name in order:
        if name == "claude" and shutil_which("claude"):
            return ["claude", "-p", "--tools", "", "--no-session-persistence", "--strict-mcp-config",
                    "--setting-sources", ""], "Claude", True
        if name == "codex" and shutil_which("codex"):
            return ["codex", "exec", "--skip-git-repo-check", "-"], "Codex", True
        if name == "opencode" and shutil_which("opencode"):
            return ["opencode", "run"], "OpenCode", False
    return None, "", False


AI_PROMPT = """You are a music curator making one personal playlist.
Here is what this listener plays (from their own player; "liked" are songs they liked, "oftenSkipped" artists they tend to skip):

{profile}

{wish}

Pick {count} real, existing songs (exact artist and title as released) this listener will probably love:
- about a third close to what they play most (other songs by those artists, or very near),
- the rest new discoveries in the same spirit that they have most likely not heard,
- no song from the lists above, no artist from oftenSkipped, at most two songs per artist.
Give a short title for the playlist (2-5 words) and, for each song, one short reason (under 12 words) tied to their taste.
Answer with JSON only, nothing else:
{{"title": "...", "about": "one sentence", "songs": [{{"artist": "...", "title": "...", "why": "..."}}]}}"""


def ask_agent(prompt):
    cmd, name, stdin_ok = agent_command()
    if not cmd:
        raise RuntimeError("No AI agent is set up (omarchy default agent claude, codex or opencode)")
    workdir = tempfile.mkdtemp(prefix="ai-mix-")
    try:
        proc = subprocess.run(cmd if stdin_ok else cmd + [prompt], input=prompt if stdin_ok else None,
                              stdin=None if stdin_ok else subprocess.DEVNULL, capture_output=True, text=True,
                              timeout=240, cwd=workdir)
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"{name} took too long to answer")
    finally:
        shutil.rmtree(workdir, ignore_errors=True)
    text = proc.stdout or ""
    start, end = text.find("{"), text.rfind("}")
    if proc.returncode != 0 or start < 0 or end <= start:
        raise RuntimeError(f"{name} didn't answer with a playlist: {(proc.stderr or text).strip()[-200:]}")
    try:
        data = json.loads(text[start:end + 1])
    except ValueError:
        raise RuntimeError(f"{name}'s answer wasn't readable")
    if not isinstance(data, dict) or not isinstance(data.get("songs"), list):
        raise RuntimeError(f"{name}'s answer had no songs")
    return data, name


def find_on_youtube(song):
    """The YouTube Music song for an AI's pick, or None if there is none."""
    want = {"title": clean_text(song.get("title"), 200), "artist": clean_text(song.get("artist"), 200)}
    if not want["title"]:
        return None
    try:
        data = music_public("search", {"query": f"{want['artist']} {want['title']}".strip(), "params": SONGS_FILTER})
    except RuntimeError:
        return None
    best, best_score = None, 3.0
    for r in find_renderers(data, "musicResponsiveListItemRenderer", [])[:8]:
        cand = explore_item({"musicResponsiveListItemRenderer": r})
        if cand and cand.get("kind") == "song":
            score = match_score(want, cand)
            if score > best_score:
                best, best_score = cand, score
    return best


def cmd_ai_mix(args):
    """ai-mix [--prompt TEXT] [--browser B]: a new AI Mix."""
    browser = check_browser(opt(args, "--browser", "none"))
    wish = clean_text(opt(args, "--prompt", ""), 300)
    # --if-older S (the daily remake): nothing to do while the mix is newer.
    if_older = opt(args, "--if-older", "")
    if if_older.isdigit():
        mix = read_json(AI_MIX_PATH)
        if isinstance(mix, dict) and time.time() - float(mix.get("createdAt") or 0) < int(if_older):
            emit({"type": "aiMix", "state": "fresh"})
            return
    profile = taste_profile(browser)
    if profile["plays"] + profile["likes"] < 5:
        fail("Listen to a few more songs first (or like some): the AI needs something to go on")
    emit({"type": "aiMix", "state": "asking"})
    known = set(s.lower() for s in profile["mostPlayed"] + profile["liked"])
    prompt = AI_PROMPT.format(profile=json.dumps({k: v for k, v in profile.items() if k not in ("plays", "likes")},
                                                 ensure_ascii=False, indent=1),
                              wish=f"They asked for: {wish}" if wish else "Make it a mix for everyday listening.",
                              count=AI_SONGS)
    try:
        answer, agent = ask_agent(prompt)
    except RuntimeError as exc:
        fail(str(exc))
    emit({"type": "aiMix", "state": "finding", "agent": agent})
    picks = [s for s in answer["songs"] if isinstance(s, dict)][:AI_SONGS + 10]
    import concurrent.futures
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
        found = list(pool.map(find_on_youtube, picks))
    items, seen = [], set()
    for pick, hit in zip(picks, found):
        if not hit or hit["id"] in seen or f"{hit.get('artist')} - {hit.get('title')}".lower() in known:
            continue
        seen.add(hit["id"])
        items.append({"id": hit["id"], "title": hit["title"], "artist": hit.get("artist") or clean_text(pick.get("artist"), 120),
                      "duration": hit.get("duration"), "note": clean_text(pick.get("why"), 160)})
    if len(items) < 5:
        fail("The AI's picks couldn't be found on YouTube Music; try again")
    mix = {"title": clean_text(answer.get("title"), 60) or "AI Mix", "about": clean_text(answer.get("about"), 200),
           "prompt": wish, "agent": agent, "createdAt": int(time.time()), "items": items[:AI_SONGS]}
    os.makedirs(DATA_DIR, mode=0o700, exist_ok=True)
    write_json_atomic(AI_MIX_PATH, mix)
    emit({"type": "aiMix", "state": "done", "title": mix["title"], "count": len(mix["items"]), "agent": agent})


def ai_mix_tracks():
    mix = read_json(AI_MIX_PATH)
    if not isinstance(mix, dict):
        return {"title": "AI Mix", "items": []}
    return {"title": clean_text(mix.get("title"), 60) or "AI Mix", "items": playable(mix.get("items"))}


def cmd_taste(_args):
    """taste: what the AI Mix would send, to show it before turning it on."""
    emit({"type": "taste", **taste_profile()})


# ---- problem reports ------------------------------------------------------------
# One click in the panel: everything about the error is gathered here and
# opened as a filled-in GitHub issue in the browser, so the user only presses
# Submit. Nothing is sent before that. The issue is public, so the report
# carries no paths, user names, browser profiles, song ids or tokens.

REPO_URL = "https://github.com/symonbaikov/omarchy-ytmusic-mpv"
REPORT_TEST_SONG = "dQw4w9WgXcQ"
REPORT_MAX_URL = 7500


def redact(text):
    text = str(text or "")
    # A media server's sign-in in a stream URL (Subsonic's u/t/s, Jellyfin's
    # api_key, Plex's token).
    text = re.sub(r"([?&](?:u|t|s|p|api_key|X-Plex-Token)=)[^&\s\"']+", r"\1<hidden>", text)
    # The local cloud server's credentials and which file it served.
    text = re.sub(r"https?://[^/\s:@]+:[^/\s@]+@127\.0\.0\.1:[0-9]+/[^\s\"']*", "http://<cloud>/<file>", text)
    text = re.sub(r"ytmusic-cloud://[a-f0-9/]+", "ytmusic-cloud://<song>", text)
    # Emails first: the user name inside one would otherwise hide it.
    text = re.sub(r"[\w.+-]+@[\w-]+\.[\w.]+", "<email>", text)
    home = os.path.expanduser("~")
    if home and home != "/":
        text = text.replace(home, "~")
    user = os.environ.get("USER") or os.path.basename(home)
    if user and len(user) > 2:
        text = re.sub(re.escape(user), "<user>", text, flags=re.I)
    # A browser setting's profile part (firefox:~/.config/zen/abc.Default …).
    text = re.sub(r"((?:firefox|chrome|chromium|brave|vivaldi|edge|opera|whale)(?:\+\w+)?):[^\s,;|)\]]+(?: \([^)\n]{0,40}\))?",
                  r"\1:<profile>", text)
    # Which songs someone plays is theirs: mask ids in yt-dlp's messages and URLs.
    text = re.sub(r"(\[(?:youtube|soundcloud)[^\]]*\] )[A-Za-z0-9_-]{6,}:", r"\1<song>:", text)
    text = re.sub(r"(watch\?v=|youtu\.be/|/vi/)[A-Za-z0-9_-]{11}", r"\1<song>", text)
    text = re.sub(r"(soundcloud\.com/)[A-Za-z0-9_/-]+", r"\1<track>", text)
    text = re.sub(r"(spotify[:/]+(?:track/)?)[A-Za-z0-9]{22}", r"\1<song>", text)
    text = re.sub(r"\bsp:[A-Za-z0-9]{22}\b", "sp:<song>", text)
    text = re.sub(r"(?i)(token|secret|key|sapisid|cookie)[\"'=: ]+[A-Za-z0-9_\-./+=]{12,}", r"\1=<hidden>", text)
    return text


def version_of(cmd):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=15, stdin=subprocess.DEVNULL).stdout
        return out.strip().splitlines()[0][:80] if out.strip() else "?"
    except (OSError, subprocess.TimeoutExpired):
        return "missing"


def recent_errors(limit=12):
    lines = []
    try:
        with open(MPV_LOG, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if "][e][" in line or "][w][ytmusic]" in line:
                    lines.append(line.rstrip()[:240])
    except OSError:
        pass
    try:
        with open(API_LOG, encoding="utf-8", errors="replace") as fh:
            lines += [l.rstrip()[:240] for l in fh.readlines()[-4:]]
    except OSError:
        pass
    return [redact(l) for l in lines[-limit:]]


def probe_clients():
    """Which YouTube clients serve a public song right now (no cookies)."""
    out = []
    for client in (None, "mweb", "tv"):
        cmd = ["yt-dlp", "--ignore-config", "--no-warnings", "-J", "-f", "bestaudio/best", "--no-playlist",
               "--socket-timeout", "15"]
        if client:
            cmd += ["--extractor-args", f"youtube:player_client={client}"]
        try:
            proc = subprocess.run(cmd + ["--", f"https://music.youtube.com/watch?v={REPORT_TEST_SONG}"],
                                  capture_output=True, text=True, timeout=45, stdin=subprocess.DEVNULL)
            ok = proc.returncode == 0 and '"url"' in proc.stdout
            why = "" if ok else ([l for l in proc.stderr.splitlines() if l.startswith("ERROR")] or [proc.stderr[-160:]])[-1]
        except (OSError, subprocess.TimeoutExpired) as exc:
            ok, why = False, str(exc)
        out.append(f"{client or 'default'}: {'ok' if ok else redact(why)[:160]}")
    return out


SERVICE_NAMES = {"yt": "YouTube Music", "sp": "Spotify", "sc": "SoundCloud", "my": "My Music"}


def build_report(where, error, service, facts, probes, errors):
    """The issue's title and the new-issue URL. The error log is trimmed,
    oldest first, until the URL fits GitHub's limit."""
    title = f"[Report] {where}: {error.splitlines()[0][:80] if error else 'music does not play'}"
    head = [
        "**What happened**", "",
        f"In the **{where}** ({SERVICE_NAMES.get(service, service)} tab):",
        "", "```", error or "(no message)", "```", "",
        "**Versions and setup** (no accounts or paths)", "", *[f"- {f}" for f in facts],
        "", "**YouTube right now** (a public test song, no cookies)", "", "```", *probes, "```",
    ]
    tail = ["", "_Sent from the player's “Report the problem” button._"]
    errors = list(errors)
    while True:
        log = ["", "**Recent errors** (song ids and paths removed)", "", "```", *errors, "```"] if errors else []
        body = "\n".join(head + log + tail)
        url = f"{REPO_URL}/issues/new?" + urllib.parse.urlencode({"title": title, "body": body})
        if len(url) <= REPORT_MAX_URL or not errors:
            return title, url
        errors = errors[1:]


def cmd_report(args):
    where = clean_text(opt(args, "--where", "panel"), 60)
    error = redact(clean_text(opt(args, "--error", ""), 600))
    service = opt(args, "--service", "yt")
    browser = check_browser(opt(args, "--browser", "none"))
    settings = widget_settings()
    manifest = read_json(os.path.join(PLUGIN_DIR, "manifest.json")) or {}
    try:
        commit = git("rev-parse", "--short", "HEAD").stdout.strip() or "?"
    except (OSError, subprocess.TimeoutExpired):
        commit = "?"
    try:
        from yt_dlp.version import __version__ as ytdlp
    except Exception:
        ytdlp = "missing"
    facts = [
        f"Plugin: {clean_text(manifest.get('version'), 20)} ({commit})",
        f"yt-dlp: {ytdlp}",
        f"mpv: {version_of(['mpv', '--version'])}",
        f"ffmpeg: {version_of(['ffmpeg', '-version'])[:40]}",
        f"Omarchy: {version_of(['omarchy', 'version'])}",
        f"Python: {sys.version.split()[0]}, kernel {os.uname().release}",
        f"Browser for cookies: {browser.split(':')[0].split('+')[0]}; playback cookies: {settings.get('playbackCookies', 'Off')}",
        f"Transitions: {settings.get('transition', 'Off')}; backup mirrors: {settings.get('backupMirrors', 'Off')}",
        f"Spotify connected: {'yes' if spotify_connected() else 'no'}; SoundCloud profile set: {'yes' if sc_user(settings.get('soundcloudUser')) else 'no'}",
        # Only the kinds of storage, never their names, hosts or folders.
        "Cloud storage: " + (", ".join(sorted(CLOUD_KIND_NAMES.get(c["kind"], "rclone") for c in read_cloud())) or "none")
        + f"; rclone: {version_of(['rclone', 'version']) if rclone_available() else 'not installed'}",
    ]
    title, url = build_report(where, error, service, [redact(f) for f in facts], probe_clients(), recent_errors())
    try:
        subprocess.Popen(browser_command(browser) + [url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as exc:
        fail(f"Couldn't open the browser: {exc}")
    emit({"type": "report", "opened": True, "title": title})


# ---- updates ------------------------------------------------------------------

PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
UPDATE_CHECK_PATH = os.path.join(CACHE_DIR, "update-check.json")


def git(*args, timeout=30):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_SSH_COMMAND="ssh -oBatchMode=yes", LC_ALL="C")
    return subprocess.run(["git", "-C", PLUGIN_DIR, *args], capture_output=True, text=True,
                          timeout=timeout, stdin=subprocess.DEVNULL, env=env)


def version_tuple(text):
    parts = re.findall(r"\d+", str(text or ""))[:3]
    return tuple(int(p) for p in parts) + (0,) * (3 - len(parts))


def cmd_update_check(args):
    """Is a newer version of this plugin out? `omarchy plugin add` installs
    plugins as git checkouts and `omarchy plugin update` pulls them, so this
    fetches the plugin's own repository (at most once per --max-age) and
    compares. Reports the new version and its commit subjects."""
    max_age = int(opt(args, "--max-age", "86400"))
    last = read_json(UPDATE_CHECK_PATH)
    if isinstance(last, dict) and time.time() - float(last.get("checkedAt") or 0) < max_age and last.get("result"):
        emit(last["result"])
        return
    try:
        if git("rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
            emit({"type": "update", "state": "unmanaged"})
            return
        upstream = git("rev-parse", "--abbrev-ref", "@{u}").stdout.strip()
        if not re.match(r"^[A-Za-z0-9._/-]{1,100}$", upstream):
            emit({"type": "update", "state": "unmanaged"})
            return
        fetched = git("fetch", "--quiet", "--no-tags", upstream.split("/", 1)[0], timeout=60)
        if fetched.returncode != 0:
            emit({"type": "update", "state": "error", "message": clean_text(fetched.stderr.strip()[-200:] or "git fetch failed")})
            return
        behind = int(git("rev-list", "--count", f"HEAD..{upstream}").stdout.strip() or 0)
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        emit({"type": "update", "state": "error", "message": clean_text(str(exc))})
        return
    current = (read_json(os.path.join(PLUGIN_DIR, "manifest.json")) or {}).get("version", "")
    result = {"type": "update", "state": "current", "current": clean_text(current, 20)}
    if behind > 0:
        try:
            newer = json.loads(git("show", f"{upstream}:manifest.json").stdout or "{}").get("version", "")
        except ValueError:
            newer = ""
        notes = [clean_text(line, 120) for line in git("log", "--no-merges", "--format=%s", "-n", "6",
                                                        f"HEAD..{upstream}").stdout.splitlines() if line.strip()]
        if version_tuple(newer) > version_tuple(current) or not newer:
            result = {"type": "update", "state": "available", "current": clean_text(current, 20),
                      "version": clean_text(newer, 20), "commits": behind, "notes": notes[:6]}
    write_json_atomic(UPDATE_CHECK_PATH, {"checkedAt": int(time.time()), "result": result})
    emit(result)


def cmd_paths(_args):
    emit({"type": "paths", "socket": SOCKET_PATH, "session": SESSION_PATH, "cache": CACHE_DIR, "log": MPV_LOG})


def opt(args, name, default):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def main():
    if len(sys.argv) < 2:
        fail(__doc__.strip().splitlines()[0])
    ensure_dirs()
    command, args = sys.argv[1], sys.argv[2:]
    handlers = {
        "playlists": cmd_playlists,
        "tracks": cmd_tracks,
        "play": cmd_play,
        "radio": cmd_radio,
        "like": cmd_like,
        "add": cmd_add,
        "liked": cmd_liked,
        "targets": cmd_targets,
        "signin": cmd_signin,
        "cookies": cmd_cookies,
        "mixprep": cmd_mixprep,
        "fallback": cmd_fallback,
        "mirrors": cmd_mirrors,
        "update-check": cmd_update_check,
        "explore": cmd_explore,
        "mixes": cmd_mixes,
        "resolve": cmd_resolve,
        "lyrics": cmd_lyrics,
        "radio-fav": cmd_radio_fav,
        "history-add": cmd_history_add,
        "taste": cmd_taste,
        "ai-mix": cmd_ai_mix,
        "radio-countries": cmd_radio_countries,
        "radio-favs": cmd_radio_favs,
        "chords": cmd_chords,
        "scores": cmd_scores,
        "open-score": cmd_open_score,
        "cloud": cmd_cloud,
        "cloud-add": cmd_cloud_add,
        "cloud-remove": cmd_cloud_remove,
        "cloud-stop": cmd_cloud_stop,
        "report": cmd_report,
        "spotify-login": cmd_spotify_login,
        "spotify-logout": cmd_spotify_logout,
        "mix-add": cmd_mix_add,
        "mix-remove": cmd_mix_remove,
        "mix-delete": cmd_mix_delete,
        "mood": cmd_mood,
        "search": cmd_search,
        "download": cmd_download,
        "stop": cmd_stop,
        "paths": cmd_paths,
    }
    handler = handlers.get(command)
    if not handler:
        fail(f"Unknown command: {command}")
    try:
        handler(args)
    except ValueError as exc:
        fail(f"Bad argument: {exc}")


if __name__ == "__main__":
    main()
