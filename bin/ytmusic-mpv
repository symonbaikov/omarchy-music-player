#!/usr/bin/env python3
"""Backend for the io.github.symonbaikov.ytmusic-mpv Omarchy shell plugin.

Lists YouTube Music playlists and their tracks with yt-dlp, and plays them
through a headless mpv that the shell drives over mpv's JSON IPC socket.
No browser has to be running: yt-dlp only reads the browser's saved login
cookies from disk to see the private library.

Commands (every result is one JSON object per line on stdout):
  playlists [--browser B] [--max-age S]
  tracks <playlist-id> [--browser B] [--max-age S]
  play <playlist-id> [--index N] [--shuffle 0|1] [--browser B]
       [--playback-cookies 0|1] [--volume V] [--repeat off|all|one]
  radio <video-id> [--mode replace|keep|append] [--browser B] [--title T]
        [--playback-cookies 0|1] [--volume V] [--repeat off|all|one]
  like <video-id> [--remove 1] [--browser B] [--title T] [--artist A] [--duration S]
  add <playlist-id> <video-id> [--browser B]
  liked
  targets <video-id> [--browser B]
  signin [--browser B]
  cookies [--browser B] [--playback-cookies 0|1]
  stop
  paths

`playlists` and `tracks` first print the cached copy (marked "stale" when
it is older than --max-age) and then, if it was stale or missing, fetch a
fresh copy and print that too.

`radio` uses YouTube Music's own recommendations: the endless "radio" mix
(RDAMVM<video-id>) that YouTube Music builds for a song, personalized when
cookies are used. replace starts it as a new queue; keep lets the playing
song continue and replaces what comes after it; append (autoplay) adds
tracks not yet in the queue to its end.

`cookies` makes a running player follow the current cookie settings: mpv
reads its yt-dlp options again for every track it opens, so turning
playback cookies off (or choosing browser none) takes effect from the next
track on. If the change can't be confirmed, the player is stopped.

`like` and `add` write to the account (like a song, add it to one of your
playlists) through YouTube Music's own web API, signed with the browser's
cookies exactly as music.youtube.com does. yt-dlp is read-only, so these
two are the only requests the helper makes itself.
"""

import fcntl
import hashlib
import json
import os
import random
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

PLUGIN_ID = "io.github.symonbaikov.ytmusic-mpv"

HOME = os.path.expanduser("~")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), PLUGIN_ID)
RUNTIME_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or os.path.join("/tmp", f"{PLUGIN_ID}-{os.getuid()}"), PLUGIN_ID)
SOCKET_PATH = os.path.join(RUNTIME_DIR, "mpv.sock")
SESSION_PATH = os.path.join(RUNTIME_DIR, "session.json")
QUEUE_PATH = os.path.join(RUNTIME_DIR, "queue.m3u")
PID_PATH = os.path.join(RUNTIME_DIR, "mpv.pid")
LOCK_PATH = os.path.join(RUNTIME_DIR, "session.lock")
MPV_LOG = os.path.join(CACHE_DIR, "mpv.log")
# YouTube Music API errors (endpoint, HTTP code, YouTube's own status and
# message). Never headers or cookies.
API_LOG = os.path.join(CACHE_DIR, "api.log")

# Bounds on everything that comes back from the network.
MAX_PLAYLISTS = 500
MAX_TRACKS = 5000
MAX_TEXT = 300
MAX_JSON_BYTES = 64 * 1024 * 1024
FETCH_TIMEOUT = 180

PLAYLIST_ID_RE = re.compile(r"^[A-Za-z0-9_-]{2,80}$")
VIDEO_ID_RE = re.compile(r"^[A-Za-z0-9_-]{11}$")
# browser[+keyring][:profile]; the profile may be a path (Zen, LibreWolf and
# other Firefox forks are read as firefox:<profile dir>).
BROWSER_RE = re.compile(r"^(none|brave|chrome|chromium|edge|firefox|opera|vivaldi|whale)(\+[A-Za-z0-9_-]{1,32})?(:[A-Za-z0-9 _.()/~+-]{1,200})?$")

LIKED_MUSIC = {"id": "LM", "title": "Liked Music", "count": None}
# YouTube Music's "My Supermix": one fixed list id that YouTube fills from
# the signed-in account's listening (a regional mix without cookies).
SUPERMIX = {"id": "RDTMAK5uy_kset8DisdE7LSD4TNjEVvrKRTmG7a56sY", "title": "My Supermix", "count": None}
PINNED = [LIKED_MUSIC, SUPERMIX]

# Mixes ("RD..." lists) are effectively endless: read only their head.
RADIO_LIMIT = 50
MIX_LIMIT = 100
AUTOPLAY_ADD = 25

# Library listings yt-dlp understands, tried in order. YouTube Music
# playlists are ordinary YouTube playlists, so the YouTube feed lists them.
LIBRARY_URLS = [
    "https://www.youtube.com/feed/playlists",
]


def emit(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def fail(message, kind="error", **extra):
    emit({"type": kind, "message": clean_text(message), **extra})
    sys.exit(1)


def clean_text(value, limit=MAX_TEXT):
    if value is None:
        return ""
    text = str(value)
    text = re.sub(r"[\x00-\x1f\x7f]+", " ", text).strip()
    return text[:limit]


def check_playlist_id(value):
    if not PLAYLIST_ID_RE.match(value or ""):
        fail("Invalid playlist id")
    return value


def check_browser(value):
    value = (value or "none").strip()
    if not BROWSER_RE.match(value):
        fail(f"Unsupported browser setting: {value}")
    return value


def ensure_dirs():
    os.makedirs(CACHE_DIR, exist_ok=True)
    os.makedirs(os.path.join(CACHE_DIR, "tracks"), exist_ok=True)
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)


def write_json_atomic(path, data):
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False)
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


# Chromium-family browsers encrypt cookies with a key kept wherever
# --password-store points (Omarchy launches Chromium and Brave with
# gnome-libsecret). yt-dlp guesses the store from the desktop environment,
# and under Hyprland it guesses "basictext", so the cookies wouldn't decrypt.
# Read the browser's own flags file instead, as the browser itself does.
CHROMIUM_FLAGS_FILES = {
    "chromium": ["chromium-flags.conf"],
    "brave": ["brave-flags.conf"],
    "chrome": ["chrome-flags.conf", "chrome-stable-flags.conf"],
    "vivaldi": ["vivaldi-stable.conf", "vivaldi-flags.conf"],
    "edge": ["microsoft-edge-stable-flags.conf"],
    "opera": ["opera-flags.conf"],
}
PASSWORD_STORE_KEYRINGS = {
    "gnome-libsecret": "gnomekeyring",
    "gnome-keyring": "gnomekeyring",
    "gnome": "gnomekeyring",
    "kwallet": "kwallet",
    "kwallet5": "kwallet5",
    "kwallet6": "kwallet6",
    "basic": "basictext",
}


def browser_keyring(name, config_dir=None):
    """The yt-dlp keyring matching the browser's --password-store flag, or
    None to let yt-dlp choose."""
    config_dir = config_dir or os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
    for filename in CHROMIUM_FLAGS_FILES.get(name, []):
        try:
            with open(os.path.join(config_dir, filename), encoding="utf-8") as fh:
                text = fh.read(65536)
        except OSError:
            continue
        found = None
        for match in re.finditer(r"--password-store[= ]([A-Za-z0-9_-]+)", text):
            found = match.group(1)
        if found:
            return PASSWORD_STORE_KEYRINGS.get(found)
    return None


def browser_parts(browser, config_dir=None):
    """'chromium[+keyring][:profile]' -> (name, keyring or None, profile or None),
    filling in the keyring from the browser's flags when it isn't given."""
    head, sep, profile = browser.partition(":")
    name, _, keyring = head.partition("+")
    keyring = keyring.lower() or browser_keyring(name, config_dir)
    return name, keyring, (os.path.expanduser(profile) if sep else None)


def cookie_spec(browser):
    name, keyring, profile = browser_parts(browser)
    spec = f"{name}+{keyring}" if keyring else name
    return f"{spec}:{profile}" if profile else spec


def cookie_args(browser):
    return [] if browser == "none" else ["--cookies-from-browser", cookie_spec(browser)]


def run_ytdlp(url, browser, limit=None):
    cmd = [
        "yt-dlp", "--ignore-config", "--flat-playlist", "--dump-single-json",
        "--no-warnings", "--no-progress", "--socket-timeout", "20",
        *cookie_args(browser),
    ]
    if limit:
        cmd += ["--playlist-items", f":{int(limit)}"]
    cmd += ["--", url]
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=FETCH_TIMEOUT, stdin=subprocess.DEVNULL)
    except FileNotFoundError:
        raise RuntimeError("yt-dlp is not installed")
    except subprocess.TimeoutExpired:
        raise RuntimeError("yt-dlp timed out")
    if proc.returncode != 0:
        errors = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.startswith("ERROR")]
        raise RuntimeError(errors[-1] if errors else f"yt-dlp exited with {proc.returncode}")
    if len(proc.stdout) > MAX_JSON_BYTES:
        raise RuntimeError("yt-dlp response too large")
    try:
        return json.loads(proc.stdout)
    except ValueError:
        raise RuntimeError("yt-dlp returned invalid JSON")


def playlist_id_from_entry(entry):
    pid = entry.get("id") or ""
    url = entry.get("url") or ""
    m = re.search(r"[?&]list=([A-Za-z0-9_-]+)", url)
    if m:
        pid = m.group(1)
    if pid.startswith("VL") and len(pid) > 4:
        pid = pid[2:]
    return pid if PLAYLIST_ID_RE.match(pid) else None


def fetch_playlists(browser):
    if browser == "none":
        raise RuntimeError("Set a browser in the widget settings to read your library")
    last_error = None
    for url in LIBRARY_URLS:
        try:
            data = run_ytdlp(url, browser)
        except RuntimeError as exc:
            last_error = exc
            continue
        items, seen = [], {p["id"] for p in PINNED}
        for entry in data.get("entries") or []:
            if not isinstance(entry, dict):
                continue
            pid = playlist_id_from_entry(entry)
            if not pid or pid in seen:
                continue
            seen.add(pid)
            count = entry.get("playlist_count")
            items.append({
                "id": pid,
                "title": clean_text(entry.get("title")) or pid,
                "count": count if isinstance(count, int) and 0 <= count < 1_000_000 else None,
            })
            if len(items) >= MAX_PLAYLISTS:
                break
        return with_pinned(items)
    raise last_error or RuntimeError("Could not read the library")


def with_pinned(items):
    """Liked Music and My Supermix first, also for caches written before
    Supermix was pinned."""
    pinned_ids = {p["id"] for p in PINNED}
    return [dict(p) for p in PINNED] + [p for p in items if isinstance(p, dict) and p.get("id") not in pinned_ids]


def artist_of(entry):
    for key in ("artist", "channel", "uploader", "creator"):
        value = entry.get(key)
        if isinstance(value, list):
            value = ", ".join(str(v) for v in value[:4])
        if value:
            return clean_text(re.sub(r"\s+-\s+Topic$", "", str(value)))
    return ""


def radio_id(video_id):
    return f"RDAMVM{video_id}"


def list_source(playlist_id):
    """URL and item limit for a list id. A song radio is read through a watch
    URL seeded with the song: yt-dlp can't open RDAMVM ids as playlists."""
    if playlist_id.startswith("RDAMVM") and VIDEO_ID_RE.match(playlist_id[6:]):
        seed = playlist_id[6:]
        return f"https://music.youtube.com/watch?v={seed}&list={playlist_id}", RADIO_LIMIT
    if playlist_id.startswith("RD"):
        return f"https://music.youtube.com/playlist?list={playlist_id}", MIX_LIMIT
    return f"https://music.youtube.com/playlist?list={playlist_id}", None


def fetch_tracks(playlist_id, browser):
    url, limit = list_source(playlist_id)
    data = run_ytdlp(url, browser, limit)
    items = []
    for entry in data.get("entries") or []:
        if not isinstance(entry, dict):
            continue
        vid = entry.get("id") or ""
        if not VIDEO_ID_RE.match(vid):
            continue
        title = clean_text(entry.get("title"))
        if title in ("[Deleted video]", "[Private video]"):
            continue
        duration = entry.get("duration")
        items.append({
            "id": vid,
            "title": title or vid,
            "artist": artist_of(entry),
            "duration": int(duration) if isinstance(duration, (int, float)) and 0 < duration < 86400 else None,
        })
        if len(items) >= MAX_TRACKS:
            break
    return {"title": clean_text(data.get("title")), "items": items}


def tracks_cache_path(playlist_id, browser):
    """Mixes ("RD..." lists: song radios, My Supermix) are personalized by
    the cookies they were read with, so each browser setting gets its own
    copy; a guest Supermix must never stand in for the account's."""
    name = playlist_id
    if playlist_id.startswith("RD"):
        name += "." + re.sub(r"[^A-Za-z0-9_.+-]", "_", browser)
    return os.path.join(CACHE_DIR, "tracks", f"{name}.json")


def cached_then_fresh(kind, cache_path, max_age, fetch, extra=None, items_filter=None):
    extra = extra or {}
    cached = read_json(cache_path)
    fresh_enough = False
    if isinstance(cached, dict) and isinstance(cached.get("items"), list):
        age = time.time() - float(cached.get("fetchedAt") or 0)
        fresh_enough = max_age < 0 or age <= max_age
        if items_filter:
            cached["items"] = items_filter(cached["items"])
        emit({"type": kind, "stale": not fresh_enough, **extra, **cached})
    elif max_age < 0:
        emit({"type": kind, "stale": True, "items": [], **extra})
        return
    if fresh_enough:
        return
    try:
        result = fetch()
    except RuntimeError as exc:
        fail(str(exc))
    result["fetchedAt"] = int(time.time())
    write_json_atomic(cache_path, result)
    emit({"type": kind, "stale": False, **extra, **result})


def cmd_playlists(args):
    browser = check_browser(opt(args, "--browser", "none"))
    max_age = int(opt(args, "--max-age", "3600"))
    cache = os.path.join(CACHE_DIR, f"playlists-{re.sub(r'[^A-Za-z0-9_.+-]', '_', browser)}.json")
    cached_then_fresh("playlists", cache, max_age, lambda: {"items": fetch_playlists(browser)}, items_filter=with_pinned)


def cmd_tracks(args):
    if not args:
        fail("tracks needs a playlist id")
    playlist_id = check_playlist_id(args[0])
    browser = check_browser(opt(args, "--browser", "none"))
    max_age = int(opt(args, "--max-age", "3600"))
    cache = tracks_cache_path(playlist_id, browser)
    cached_then_fresh("tracks", cache, max_age, lambda: fetch_tracks(playlist_id, browser), {"playlistId": playlist_id})


def mpv_request(command, timeout=1.0):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(timeout)
            sock.connect(SOCKET_PATH)
            sock.sendall((json.dumps({"command": command}) + "\n").encode())
            return True
    except OSError:
        return False


def mpv_batch(commands, timeout=3.0):
    """Send several commands on one connection and wait for every reply, so
    mpv has applied them all before we return. Returns the replies."""
    replies = {}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(timeout)
            sock.connect(SOCKET_PATH)
            payload = "".join(json.dumps({"command": c, "request_id": i + 1}) + "\n" for i, c in enumerate(commands))
            sock.sendall(payload.encode())
            buf = b""
            deadline = time.time() + timeout
            while len(replies) < len(commands) and time.time() < deadline:
                chunk = sock.recv(65536)
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(msg, dict) and "request_id" in msg and "event" not in msg:
                        replies[msg["request_id"]] = msg
    except OSError:
        return None
    return [replies.get(i + 1) for i in range(len(commands))]


class SessionLock:
    """Serializes queue changes: every monitor's bar runs its own widget, and
    two of them could otherwise extend the same queue at once."""

    def __enter__(self):
        self.fh = open(LOCK_PATH, "w")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def our_mpv_pid():
    try:
        with open(PID_PATH) as fh:
            pid = int(fh.read().strip())
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            if SOCKET_PATH.encode() in fh.read():
                return pid
    except (OSError, ValueError):
        pass
    return None


def stop_player():
    pid = our_mpv_pid()
    mpv_request(["quit"])
    if pid:
        for _ in range(20):
            if not os.path.exists(f"/proc/{pid}"):
                break
            time.sleep(0.05)
        else:
            try:
                os.kill(pid, 15)
            except OSError:
                pass
    for path in (SOCKET_PATH, PID_PATH):
        try:
            os.unlink(path)
        except OSError:
            pass


def cmd_stop(_args):
    end_session()
    emit({"type": "stopped"})


def player_options(args):
    browser = check_browser(opt(args, "--browser", "none"))
    repeat = opt(args, "--repeat", "off")
    if repeat not in ("off", "all", "one"):
        fail("--repeat must be off, all or one")
    return {
        "browser": browser,
        "playback_cookies": opt(args, "--playback-cookies", "0") == "1",
        "volume": min(100, max(0, int(opt(args, "--volume", "60")))),
        "repeat": repeat,
    }


def load_tracks(playlist_id, browser, max_age=None):
    """Tracks for a list from the cache (any age when max_age is None),
    fetching and caching them when missing or too old."""
    path = tracks_cache_path(playlist_id, browser)
    cached = read_json(path)
    if isinstance(cached, dict) and cached.get("items"):
        age = time.time() - float(cached.get("fetchedAt") or 0)
        if max_age is None or age <= max_age:
            return cached
    try:
        cached = fetch_tracks(playlist_id, browser)
    except RuntimeError as exc:
        fail(str(exc))
    cached["fetchedAt"] = int(time.time())
    write_json_atomic(path, cached)
    return cached


def playable(items):
    return [t for t in items or [] if isinstance(t, dict) and VIDEO_ID_RE.match(str(t.get("id", "")))]


def track_url(track):
    return f"https://music.youtube.com/watch?v={track['id']}"


def playback_cookie_spec(options):
    """The --cookies-from-browser value the player should pass to yt-dlp, or
    None when playback must not use cookies."""
    if options["playback_cookies"] and options["browser"] != "none":
        return cookie_spec(options["browser"])
    return None


def end_session():
    stop_player()
    try:
        os.unlink(SESSION_PATH)
    except OSError:
        pass


def apply_player_cookies(options):
    """Bring a running player's cookie use in line with `options`. mpv's
    ytdl hook reads ytdl-raw-options on every track it opens, so changing the
    option in place covers every later track. If the change can't be read
    back, stop the player rather than let it keep the old access.
    Returns "idle", "applied" or "stopped"."""
    if not player_running():
        return "idle"
    want = playback_cookie_spec(options)
    replies = mpv_batch([["get_property", "ytdl-raw-options"]]) or [None]
    current = replies[0].get("data") if isinstance(replies[0], dict) else None
    if isinstance(current, dict):
        updated = {k: v for k, v in current.items() if k != "cookies-from-browser"}
        if want:
            updated["cookies-from-browser"] = want
        replies = mpv_batch([["set_property", "ytdl-raw-options", updated],
                             ["get_property", "ytdl-raw-options"]]) or [None, None]
        check = replies[1].get("data") if isinstance(replies[1], dict) else None
        if isinstance(check, dict) and check.get("cookies-from-browser") == want:
            return "applied"
    end_session()
    return "stopped"


def cmd_cookies(args):
    options = player_options(args)
    with SessionLock():
        state = apply_player_cookies(options)
    emit({"type": "stopped"} if state == "stopped" else {"type": "cookies", "state": state})


def start_player(playlist_id, title, order, start, options, autoplay=False):
    """Replace any running player with a new one playing `order`."""
    stop_player()

    with open(QUEUE_PATH, "w", encoding="utf-8") as fh:
        fh.write("#EXTM3U\n")
        for t in order:
            label = clean_text(f"{t.get('artist')} - {t.get('title')}" if t.get("artist") else t.get("title"))
            fh.write(f"#EXTINF:{t.get('duration') or -1},{label}\n")
            fh.write(track_url(t) + "\n")

    write_json_atomic(SESSION_PATH, {
        "playlistId": playlist_id,
        "playlistTitle": title,
        "shuffle": options.get("shuffle", False),
        "autoplay": autoplay,
        "tracks": order,
        "startedAt": int(time.time()),
    })

    repeat = options["repeat"]
    cmd = [
        "mpv", "--no-video", "--force-window=no", "--no-terminal", "--idle=no",
        "--audio-display=no", "--audio-client-name=YouTube Music",
        f"--input-ipc-server={SOCKET_PATH}",
        "--ytdl-format=bestaudio/best", "--prefetch-playlist=yes",
        f"--volume={options['volume']}", f"--playlist-start={start}",
        # Repeat one loops the current track; repeat all wraps the queue.
        f"--loop-file={'inf' if repeat == 'one' else 'no'}",
        f"--loop-playlist={'inf' if repeat == 'all' else 'no'}",
        "--msg-level=all=warn", f"--log-file={MPV_LOG}",
    ]
    spec = playback_cookie_spec(options)
    if spec:
        cmd.append(f"--ytdl-raw-options-append=cookies-from-browser={spec}")
    cmd.append(f"--playlist={QUEUE_PATH}")

    with open(os.devnull, "rb") as devnull_in, open(os.devnull, "wb") as devnull_out:
        proc = subprocess.Popen(cmd, stdin=devnull_in, stdout=devnull_out, stderr=devnull_out,
                                start_new_session=True, close_fds=True)
    with open(PID_PATH, "w") as fh:
        fh.write(str(proc.pid))

    for _ in range(100):
        if proc.poll() is not None:
            fail(f"mpv exited early (see {MPV_LOG})")
        if os.path.exists(SOCKET_PATH) and mpv_request(["get_property", "pid"]):
            emit({"type": "playing", "socket": SOCKET_PATH, "index": start, "count": len(order)})
            return
        time.sleep(0.05)
    fail("mpv did not open its control socket")


def cmd_play(args):
    if not args:
        fail("play needs a playlist id")
    playlist_id = check_playlist_id(args[0])
    options = player_options(args)
    index = max(0, int(opt(args, "--index", "0")))
    shuffle = opt(args, "--shuffle", "0") == "1"

    cached = load_tracks(playlist_id, options["browser"])
    tracks = playable(cached.get("items"))
    if not tracks:
        fail("This playlist has no playable tracks")
    index = min(index, len(tracks) - 1)

    if shuffle:
        first = tracks[index]
        rest = tracks[:index] + tracks[index + 1:]
        random.shuffle(rest)
        order, start = [first] + rest, 0
    else:
        order, start = tracks, index

    options["shuffle"] = shuffle
    title = clean_text(opt(args, "--title", "")) or cached.get("title") or ""
    with SessionLock():
        start_player(playlist_id, title, order, start, options)


def player_running():
    return our_mpv_pid() is not None and os.path.exists(SOCKET_PATH)


def cmd_radio(args):
    if not args or not VIDEO_ID_RE.match(args[0]):
        fail("radio needs a video id")
    seed = args[0]
    mode = opt(args, "--mode", "replace")
    if mode not in ("replace", "keep", "append"):
        fail("--mode must be replace, keep or append")
    options = player_options(args)
    list_id = radio_id(seed)

    with SessionLock():
        session = read_json(SESSION_PATH)
        queue = playable(session.get("tracks")) if isinstance(session, dict) else []

        # Autoplay: extend only while the seed is still the last queued song.
        # This keeps it idempotent when several bars ask at once.
        if mode == "append":
            if not player_running() or not queue or queue[-1]["id"] != seed:
                emit({"type": "radio", "mode": mode, "added": 0})
                return
            if len(queue) >= MAX_TRACKS:
                emit({"type": "radio", "mode": mode, "added": 0})
                return

        mix = playable(load_tracks(list_id, options["browser"], max_age=3600).get("items"))
        if not mix:
            fail("YouTube Music has no radio for this song")
        title = clean_text(opt(args, "--title", "")) or "Radio"

        # A player that is kept follows the current cookie settings too.
        if mode in ("keep", "append") and player_running() and apply_player_cookies(options) == "stopped":
            if mode == "append":
                emit({"type": "stopped"})
                return
        if mode == "keep" and not player_running():
            mode = "replace"
        if mode == "replace":
            start_player(list_id, title, mix, 0, options)
            return

        if mode == "keep":
            # The playing song continues; everything after it becomes the radio.
            replies = mpv_batch([["get_property", "playlist-pos"]]) or [None]
            pos = replies[0].get("data") if isinstance(replies[0], dict) else None
            current = queue[pos] if isinstance(pos, int) and 0 <= pos < len(queue) else mix[0]
            upcoming = [t for t in mix if t["id"] != current["id"]]
            write_json_atomic(SESSION_PATH, {
                "playlistId": list_id,
                "playlistTitle": title,
                "shuffle": False,
                "autoplay": False,
                "tracks": [current] + upcoming,
                "startedAt": int(time.time()),
            })
            mpv_batch([["playlist-clear"]] + [["loadfile", track_url(t), "append"] for t in upcoming])
            emit({"type": "radio", "mode": mode, "added": len(upcoming)})
            return

        # append
        seen = {t["id"] for t in queue}
        new = [t for t in mix if t["id"] not in seen][:AUTOPLAY_ADD]
        if new:
            session["tracks"] = queue + new
            session["autoplay"] = True
            write_json_atomic(SESSION_PATH, session)
            mpv_batch([["loadfile", track_url(t), "append"] for t in new])
        emit({"type": "radio", "mode": mode, "added": len(new)})


# ---- writing to the account (like, add to playlist) --------------------------

MUSIC_ORIGIN = "https://music.youtube.com"
# Fallback only: the current version is taken from yt-dlp, which keeps it up
# to date with YouTube Music.
WEB_REMIX_VERSION = "1.20260707.12.00"
MAX_API_RESPONSE = 4 * 1024 * 1024


class QuietLogger:
    def debug(self, msg): pass
    def info(self, msg): pass
    def warning(self, msg, only_once=False): pass
    def error(self, msg): pass


def browser_spec_tuple(browser):
    """yt-dlp's cookiesfrombrowser tuple: (name, profile, KEYRING, container).
    yt-dlp wants the keyring upper-cased here (its CLI does that itself)."""
    name, keyring, profile = browser_parts(browser)
    return (name, profile, keyring.upper() if keyring else None, None)


def music_client_version():
    try:
        from yt_dlp.extractor.youtube._base import INNERTUBE_CLIENTS
        version = INNERTUBE_CLIENTS["web_music"]["INNERTUBE_CONTEXT"]["client"]["clientVersion"]
        if isinstance(version, str) and re.match(r"^1\.\d{8}\.\d{2}\.\d{2}$", version):
            return version
    except Exception:
        pass
    return WEB_REMIX_VERSION


def sid_authorization(cookies):
    """The SAPISIDHASH family of headers music.youtube.com signs its API
    calls with (the same scheme yt-dlp uses)."""
    sapisid = cookies.get("SAPISID") or cookies.get("__Secure-3PAPISID")
    parts = []
    for scheme, sid in (("SAPISIDHASH", sapisid),
                        ("SAPISID1PHASH", cookies.get("__Secure-1PAPISID")),
                        ("SAPISID3PHASH", cookies.get("__Secure-3PAPISID"))):
        if sid:
            ts = str(round(time.time()))
            digest = hashlib.sha1(f"{ts} {sid} {MUSIC_ORIGIN}".encode()).hexdigest()
            parts.append(f"{scheme} {ts}_{digest}")
    return " ".join(parts)


def music_session(browser):
    """Cookie and Authorization headers for the signed-in account. The
    cookies are read the same way --cookies-from-browser reads them and are
    only ever sent to music.youtube.com."""
    if browser == "none":
        fail("Set a browser in the widget settings to change your library", auth=True)
    try:
        from yt_dlp import YoutubeDL
    except ImportError:
        fail("yt-dlp is not installed")
    try:
        with YoutubeDL({"cookiesfrombrowser": browser_spec_tuple(browser), "quiet": True,
                        "no_warnings": True, "logger": QuietLogger()}) as ydl:
            jar = ydl.cookiejar
            cookie_header = jar.get_cookie_header(MUSIC_ORIGIN + "/")
            cookies = {c.name: c.value for c in jar.get_cookies_for_url(MUSIC_ORIGIN + "/")}
    except Exception as exc:
        fail(f"Couldn't read {browser.partition(':')[0]} cookies: {exc}", auth=True)
    authorization = sid_authorization(cookies)
    if not authorization or "LOGIN_INFO" not in cookies:
        fail(f"Not signed in to YouTube Music in {browser.partition(':')[0]}", auth=True)
    return {"Cookie": cookie_header, "Authorization": authorization}


def log_api_error(endpoint, code, status, message):
    try:
        with open(API_LOG, "a", encoding="utf-8") as fh:
            fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {endpoint} HTTP {code} {status} {clean_text(message)}\n")
    except OSError:
        pass


def api_failure(endpoint, code, status, message, action):
    """Turn a YouTube Music API error into an honest message. Only a real
    sign-in problem (401 / UNAUTHENTICATED) asks the user to sign in."""
    log_api_error(endpoint, code, status, message)
    if code == 401 or status == "UNAUTHENTICATED":
        fail("YouTube Music says you're signed out: sign in again in your browser", auth=True)
    if code == 403 or status == "PERMISSION_DENIED":
        if action == "add":
            fail("YouTube only lets you add songs to playlists you created", status=status or "")
        fail(f"YouTube Music doesn't allow this: {message or status or code}", status=status or "")
    fail(f"YouTube Music: {message or status or f'HTTP {code}'}", status=status or "")


def music_api(endpoint, body, session, action=""):
    """POST to YouTube Music's web API as the signed-in user."""
    version = music_client_version()
    payload = {"context": {"client": {"clientName": "WEB_REMIX", "clientVersion": version, "hl": "en"}}}
    payload.update(body)
    request = urllib.request.Request(
        f"{MUSIC_ORIGIN}/youtubei/v1/{endpoint}?prettyPrint=false",
        data=json.dumps(payload).encode(),
        method="POST",
        headers={
            **session,
            "Content-Type": "application/json",
            "Origin": MUSIC_ORIGIN,
            "X-Origin": MUSIC_ORIGIN,
            "X-Goog-AuthUser": "0",
            "X-Youtube-Client-Name": "67",
            "X-Youtube-Client-Version": version,
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            raw = response.read(MAX_API_RESPONSE + 1)
    except urllib.error.HTTPError as exc:
        status = message = ""
        try:
            err = json.loads(exc.read(65536)).get("error") or {}
            status = clean_text(err.get("status"), 64)
            message = clean_text(err.get("message"), 200)
        except Exception:
            pass
        api_failure(endpoint, exc.code, status, message, action)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        fail(f"Couldn't reach YouTube Music: {getattr(exc, 'reason', exc)}")
    if len(raw) > MAX_API_RESPONSE:
        fail("YouTube Music response too large")
    try:
        return json.loads(raw)
    except ValueError:
        fail("YouTube Music returned invalid JSON")


def update_liked_cache(track, liked):
    """Keep the local Liked Music list in step, so the heart is right without
    re-reading the whole library."""
    path = tracks_cache_path("LM", "none")
    cached = read_json(path)
    if not isinstance(cached, dict) or not isinstance(cached.get("items"), list):
        return
    items = [t for t in cached["items"] if isinstance(t, dict) and t.get("id") != track["id"]]
    if liked:
        items.insert(0, track)
    cached["items"] = items[:MAX_TRACKS]
    write_json_atomic(path, cached)


def cmd_like(args):
    if not args or not VIDEO_ID_RE.match(args[0]):
        fail("like needs a video id")
    video_id = args[0]
    remove = opt(args, "--remove", "0") == "1"
    browser = check_browser(opt(args, "--browser", "none"))
    session = music_session(browser)
    music_api("like/removelike" if remove else "like/like", {"target": {"videoId": video_id}}, session, "like")
    try:
        duration = int(opt(args, "--duration", "0"))
    except ValueError:
        duration = 0
    update_liked_cache({
        "id": video_id,
        "title": clean_text(opt(args, "--title", "")) or video_id,
        "artist": clean_text(opt(args, "--artist", "")),
        "duration": duration if 0 < duration < 86400 else None,
    }, not remove)
    emit({"type": "liked", "id": video_id, "liked": not remove})


def cmd_add(args):
    if len(args) < 2:
        fail("add needs a playlist id and a video id")
    playlist_id = check_playlist_id(args[0])
    video_id = args[1]
    if not VIDEO_ID_RE.match(video_id):
        fail("Invalid video id")
    if playlist_id == "LM" or playlist_id.startswith("RD"):
        fail("Songs can't be added to this list")
    browser = check_browser(opt(args, "--browser", "none"))
    session = music_session(browser)
    result = music_api("browse/edit_playlist", {
        "playlistId": playlist_id,
        "actions": [{"action": "ACTION_ADD_VIDEO", "addedVideoId": video_id,
                     "dedupeOption": "DEDUPE_OPTION_SKIP"}],
    }, session, "add")
    status = result.get("status") if isinstance(result, dict) else None
    if status != "STATUS_SUCCEEDED":
        log_api_error("browse/edit_playlist", 200, status, "")
        fail("YouTube Music didn't add it")
    # The cached copy is out of date now: show it, then refresh on next open.
    path = tracks_cache_path(playlist_id, browser)
    cached = read_json(path)
    if isinstance(cached, dict):
        cached["fetchedAt"] = 0
        write_json_atomic(path, cached)
    emit({"type": "added", "playlistId": playlist_id, "id": video_id})


def find_renderers(node, key, out, depth=0):
    """Every `key` object anywhere in a YouTube response, so the parser
    doesn't depend on how deeply YouTube nests it."""
    if depth > 40 or len(out) >= MAX_PLAYLISTS:
        return out
    if isinstance(node, dict):
        for k, v in node.items():
            if k == key and isinstance(v, dict):
                out.append(v)
            else:
                find_renderers(v, key, out, depth + 1)
    elif isinstance(node, list):
        for v in node:
            find_renderers(v, key, out, depth + 1)
    return out


def text_of(node):
    if isinstance(node, dict):
        if isinstance(node.get("simpleText"), str):
            return node["simpleText"]
        runs = node.get("runs")
        if isinstance(runs, list):
            return "".join(r.get("text", "") for r in runs if isinstance(r, dict))
    return ""


def cmd_targets(args):
    """The playlists this song can be added to, straight from YouTube Music's
    own "Add to playlist" dialog: only playlists you can edit, each marked
    when the song is already in it."""
    if not args or not VIDEO_ID_RE.match(args[0]):
        fail("targets needs a video id")
    video_id = args[0]
    browser = check_browser(opt(args, "--browser", "none"))
    session = music_session(browser)
    result = music_api("playlist/get_add_to_playlist",
                       {"videoIds": [video_id], "excludeWatchLater": True}, session, "targets")
    items = parse_add_targets(result)
    if items is None:
        log_api_error("playlist/get_add_to_playlist", 200, "UNEXPECTED_SHAPE", "")
        fail("Couldn't read your playlists from YouTube Music")
    emit({"type": "targets", "videoId": video_id, "items": items})


def parse_add_targets(result):
    """[{id, title, contains}] from a get_add_to_playlist response, or None
    when it doesn't look like YouTube's add-to-playlist dialog at all."""
    items, seen = [], set()
    for option in find_renderers(result, "playlistAddToOptionRenderer", []):
        pid = option.get("playlistId") or ""
        if pid.startswith("VL"):
            pid = pid[2:]
        if not PLAYLIST_ID_RE.match(pid) or pid in seen or pid == "LM" or pid.startswith("RD"):
            continue
        seen.add(pid)
        items.append({
            "id": pid,
            "title": clean_text(text_of(option.get("title"))) or pid,
            "contains": option.get("containsSelectedVideos") == "ALL",
        })
    if not items and not find_renderers(result, "addToPlaylistRenderer", []):
        return None
    return items


SIGNIN_URL = "https://accounts.google.com/ServiceLogin?service=youtube&continue=https%3A%2F%2Fmusic.youtube.com%2F"
BROWSER_COMMANDS = {
    "chromium": ["chromium"],
    "brave": ["brave", "brave-browser"],
    "chrome": ["google-chrome-stable", "google-chrome"],
    "vivaldi": ["vivaldi-stable", "vivaldi"],
    "edge": ["microsoft-edge-stable", "microsoft-edge"],
    "opera": ["opera"],
    "whale": ["naver-whale-stable", "whale"],
}
FIREFOX_FORKS = [("zen", ["zen-browser", "zen"]), ("librewolf", ["librewolf"]),
                 ("floorp", ["floorp"]), ("waterfox", ["waterfox"])]


def browser_command(browser):
    """The program for the browser the cookies come from: the user has to
    sign in *there*. A Firefox fork is told apart by its profile folder."""
    import shutil
    name, _keyring, profile = browser_parts(browser)
    candidates = list(BROWSER_COMMANDS.get(name, []))
    if name == "firefox":
        lowered = (profile or "").lower()
        for marker, commands in FIREFOX_FORKS:
            if marker in lowered:
                candidates += commands
        candidates.append("firefox")
    for candidate in candidates:
        path = shutil.which(candidate)
        if path:
            return [path]
    return [shutil.which("xdg-open") or "xdg-open"]


def cmd_signin(args):
    """Open YouTube's sign-in page (fixed URL) in the cookies' browser."""
    browser = check_browser(opt(args, "--browser", "none"))
    command = browser_command(browser) if browser != "none" else [shutil_which("xdg-open")]
    try:
        with open(os.devnull, "rb") as devnull_in, open(os.devnull, "wb") as devnull_out:
            subprocess.Popen(command + [SIGNIN_URL], stdin=devnull_in, stdout=devnull_out,
                             stderr=devnull_out, start_new_session=True, close_fds=True)
    except OSError as exc:
        fail(f"Couldn't open the browser: {exc}")
    emit({"type": "signin", "browser": os.path.basename(command[0])})


def shutil_which(name):
    import shutil
    return shutil.which(name) or name


def cmd_liked(_args):
    cached = read_json(tracks_cache_path("LM", "none"))
    items = cached.get("items") if isinstance(cached, dict) else None
    ids = [t["id"] for t in playable(items)]
    emit({"type": "likedIds", "known": isinstance(items, list), "ids": ids[:MAX_TRACKS]})


def cmd_paths(_args):
    emit({"type": "paths", "socket": SOCKET_PATH, "session": SESSION_PATH, "cache": CACHE_DIR, "log": MPV_LOG})


def opt(args, name, default):
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def main():
    if len(sys.argv) < 2:
        fail(__doc__.strip().splitlines()[0])
    ensure_dirs()
    command, args = sys.argv[1], sys.argv[2:]
    handlers = {
        "playlists": cmd_playlists,
        "tracks": cmd_tracks,
        "play": cmd_play,
        "radio": cmd_radio,
        "like": cmd_like,
        "add": cmd_add,
        "liked": cmd_liked,
        "targets": cmd_targets,
        "signin": cmd_signin,
        "cookies": cmd_cookies,
        "stop": cmd_stop,
        "paths": cmd_paths,
    }
    handler = handlers.get(command)
    if not handler:
        fail(f"Unknown command: {command}")
    try:
        handler(args)
    except ValueError as exc:
        fail(f"Bad argument: {exc}")


if __name__ == "__main__":
    main()
